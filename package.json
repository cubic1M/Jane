{
  "name": "financial-controller",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "vercel-build": "if [ \"$VERCEL_ENV\" = production ]; then prisma migrate deploy && node scripts/rls-protect.mjs; fi && next build",
    "start": "next start",
    "check:e2e-wording": "node scripts/check-e2e-wording.mjs",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:access": "ACCESS_PROOF=1 vitest run src/security/access-proof/access.proof.test.ts --silent=passed-only",
    "test:e2e": "playwright test",
    "postinstall": "prisma generate",
    "check:launch": "node scripts/launch-check.ts",
    "flakes": "git fetch -q origin ci-flakes && git show origin/ci-flakes:FLAKES.md",
    "check:migrations": "node scripts/check-migrations.mjs",
    "check:perf-budget": "node scripts/check-perf-budget.ts",
    "check:rules": "depcruise src --output-type err && node scripts/check-ratchets.mjs",
    "mutation": "stryker run stryker.config.mjs",
    "checks:answers": "ANSWER_CHECKS=1 vitest run src/lib/jane-agent/checks/cli.test.ts --silent=false",
    "checks:baseline": "CHAT_BASELINE=1 vitest run src/lib/jane-agent/checks/baseline.cli.test.ts --silent=false",
    "checks:eval": "CHAT_EVAL=1 vitest run src/lib/jane-agent/checks/eval.cli.test.ts --silent=false",
    "checks:nightly": "CHAT_NIGHTLY=1 vitest run src/lib/jane-agent/checks/nightly.cli.test.ts --silent=false",
    "checks:proof": "CHAT_PROOF=1 vitest run src/lib/jane-agent/checks/proof.cli.test.ts --silent=false",
    "accuracy": "ACCURACY=1 vitest run src/accuracy/scoreboard.cli.test.ts src/accuracy/csv/scoreboard.cli.test.ts --silent=false",
    "labels:prepare": "LABELS_STEP=prepare vitest run src/accuracy/labels/labels.cli.test.ts --silent=false",
    "labels:seal": "LABELS_STEP=seal vitest run src/accuracy/labels/labels.cli.test.ts --silent=false",
    "labels:score": "LABELS_STEP=score vitest run src/accuracy/labels/labels.cli.test.ts --silent=false"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.135.0",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "next": "16.4.3",
    "next-auth": "^5.0.0-beta.30",
    "pg": "8.23.1",
    "plaid": "49.0.0",
    "posthog-node": "5.57.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "web-push": "3.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@stryker-mutator/core": "^10.1.1",
    "@stryker-mutator/vitest-runner": "^10.1.1",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/web-push": "^3.6.4",
    "@vitejs/plugin-react": "^6.1.2",
    "dependency-cruiser": "^18.7.2",
    "dotenv": "^18.0.9",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "eslint-config-prettier": "^10.1.8",
    "fast-check": "^4.10.2",
    "knip": "^6.44.1",
    "prettier": "^3.9.10",
    "prisma": "7.10.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.5"
  },
  "allowScripts": {
    "prisma@7.10.1": true,
    "@prisma/engines@7.10.1": true,
    "unrs-resolver@1.12.2": true
  }
}
