# Copy to .env and fill in. Never commit .env.
# Grouped by the build step that first needs each value.

# --- Step 1: database ---
# Pooled connection used by the app at runtime (Neon: host contains "-pooler").
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=verify-full"
# Direct (non-pooled) connection used only by Prisma migrations.
DIRECT_URL="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/neondb?sslmode=verify-full"

# Row-level security (docs/security/rls.md): "1" makes a query fail, instead of running filtered by
# the app alone, if the database can't switch to the jane_rls or jane_system role. Goes with
# DATABASE_URL logging in as jane_app; DIRECT_URL stays the owner, for migrations. Optional.
RLS_REQUIRED=""

# Separate scratch database for the cross-user access test (src/lib/db-scoped.integration.test.ts).
# Optional locally; CI provides one. Run `npx prisma migrate deploy` against it first.
TEST_DATABASE_URL=""

# --- Step 1: analytics (optional; events still save to the database without it) ---
# PostHog project API key, starts with phc_ (how-to: docs/setup/posthog.md)
POSTHOG_KEY=""
# https://us.i.posthog.com or https://eu.i.posthog.com
POSTHOG_HOST="https://us.i.posthog.com"

# --- Step 2: auth ---
# Random secret for Auth.js sessions. Generate with: openssl rand -base64 32
AUTH_SECRET=""
# Google OAuth client (optional at first; the Google button hides without it).
# Authorized redirect URI: <app url>/api/auth/callback/google (how-to: docs/setup/google-sign-in.md)
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# --- Step 2: email ---
# Resend API key, for magic links, status updates and digests.
# Leave empty in local dev to print magic links to the server console instead.
RESEND_API_KEY=""
# Resend's webhook signing secret (whsec_...) for /api/email/webhook: spam complaints, which turn
# the weekly email off. Leave Resend's open tracking off: /privacy says we use no tracking pixels.
RESEND_WEBHOOK_SECRET=""
# Verified sender, e.g. "Financial Controller <hello@yourdomain.com>"
EMAIL_FROM=""

# The action agent's email (spec step 51). With RESEND_API_KEY and EMAIL_FROM set, the
# agent emails companies from EMAIL_FROM with a reply-to of reply+<token>@ this domain.
# Receive that domain's email with Resend and add a webhook for `email.received` pointing at
# POST /api/agent/inbound; its signing secret is AGENT_INBOUND_WEBHOOK_SECRET. Jane then reads
# each email from Resend with RESEND_API_KEY, and a reply counts as the company's only when its
# DMARC passed. With another provider, forward JSON { to, from, subject, text, authentication:
# { dmarc } } with "Authorization: Bearer <AGENT_INBOUND_SECRET>", dmarc being that provider's
# own result. Without these, development uses a simulated company mailbox and production hands
# agent actions to the team.
AGENT_INBOUND_DOMAIN=""
AGENT_INBOUND_SECRET=""
AGENT_INBOUND_WEBHOOK_SECRET=""

# Phone calls by the agent (spec step 54). No calling service is connected yet: development
# uses a simulated call and production hands calls to the team. A service, once chosen,
# posts each call's result to POST /api/voice/result with this secret.
VOICE_WEBHOOK_SECRET=""

# --- Step 2: token encryption ---
# 32-byte key for AES-256-GCM, base64. Generate with: openssl rand -base64 32
# The original single key ("legacy"): reads every value written before key rotation, and is
# the current key until TOKEN_ENCRYPTION_KEY_CURRENT is set. Keep it until /admin/keys says
# nothing uses it. Rotation steps: docs/security/keys.md.
TOKEN_ENCRYPTION_KEY=""
# Named keys for rotation, "name:base64key" separated by commas, e.g. "k2:...,k3:...".
TOKEN_ENCRYPTION_KEYS=""
# The name of the key new values are written with, e.g. "k3". Empty: TOKEN_ENCRYPTION_KEY.
TOKEN_ENCRYPTION_KEY_CURRENT=""

# --- Step 3: LLM (optional; without a key, transactions the keyword rules can't
# place stay uncategorized) ---
ANTHROPIC_API_KEY=""
# Model for categorization and finding explanations. Defaults to claude-opus-5-5.
ANTHROPIC_MODEL=""
# Model for Jane's chat, which answers while the person waits. Defaults to claude-sonnet-5-5.
ANTHROPIC_CHAT_MODEL=""
# Step 293: model for the practice portfolio's news summaries (a small one, e.g.
# claude-haiku-5-5). News summaries are off unless this and ANTHROPIC_API_KEY are both set; the
# rules summarise each headline instead. NEWS_MONTHLY_CAP_CENTS caps what they cost a month
# (default 100 cents).
ANTHROPIC_MODEL_NEWS=""
NEWS_MONTHLY_CAP_CENTS=""

# --- Step 7: Plaid (Transactions; Liabilities from step 65; Investments from step 66) ---
PLAID_CLIENT_ID=""
PLAID_SECRET=""
# sandbox | production
PLAID_ENV="sandbox"
# "1" reads Plaid Investments (holdings and investment transactions, read-only) for linked
# brokerage and retirement accounts. Turn the product on in the Plaid dashboard first: it is
# billed per item. Off, new links don't ask for it and syncs skip it (the demo bank's
# investments work either way).
PLAID_INVESTMENTS=""
# Plaid's free Trial plan allows 10 Production Items ever, and removing one doesn't give it back
# (docs/setup/plaid-trial.md). Empty keeps these Trial defaults: 10 in all, 1 per person. Change
# them only after upgrading to a paid plan in the Plaid dashboard. Sandbox never counts.
PLAID_TRIAL_ITEM_LIMIT=""
PLAID_ITEMS_PER_PERSON=""
# "1" offers the read-only Robinhood connection (docs/setup/robinhood.md): a Connect button on
# /investments, its routes and a daily refresh. Anything else, and it's off: no button, and every
# route answers 404. Leave it empty until everything in that document is true.
ROBINHOOD_LINK=""
# Tests only: a fake server on this machine instead of Robinhood's. Any other address is ignored.
ROBINHOOD_MCP_URL=""
# "1" turns on connectors (docs/connectors.md): /settings/connections, the action pipeline and
# /api/connectors/*/webhook. Off, all of it answers 404 or refuses. A real connector also needs its
# switch in src/config/connectors.ts, and moving money needs REAL_MONEY_MOVEMENT, both in code.
CONNECTORS=""
# Connector ids to stop, comma-separated (e.g. sandbox_bill_pay), whatever else says.
CONNECTORS_KILLED=""
# Tests and the sandbox only: the secret the sandbox letters connector checks its PostGrid-shaped
# webhooks with. Nothing real uses it.
SANDBOX_LETTERS_WEBHOOK_SECRET=""
# Stripe Financial Connections' webhook secret (connectors roadmap round 20), for when its refresh
# webhook is taken. Empty: no Stripe delivery is believed. Never a live key in this file.
STRIPE_FC_WEBHOOK_SECRET=""
# Step 75: "1" offers the demo bank (fake data) even in production or with Plaid keys.
# Without it, the demo bank shows only when Plaid isn't set up and outside production.
DEMO_BANK=""
# Step 98: "1" turns on demo advice in production: people whose data is only the demo bank
# get labelled recommendations on investments, taxes, insurance and loans. Outside
# production it's on for demo-bank people anyway. Real accounts never get advice.
DEMO_ADVICE=""
# Step 138: "1" offers "Try it with sample data" on the landing page in production (it also
# needs the demo bank, DEMO_BANK). Outside production it's on wherever the demo bank is.
TRY_JANE=""
# "1" offers "Try it with your own statement" on the landing page in production: anyone can
# upload a statement with no email, into a temporary person. Outside production it's always on.
TRY_STATEMENT=""
# Cents of Claude a day for everyone trying Jane with their own statement. Empty: the default in
# src/config/statement-trial.ts. 0 turns Claude off for this path.
STATEMENT_TRIAL_DAILY_CENTS=""
# Public address of the app, for Plaid's webhook URL. On Vercel it defaults to the
# production domain, so it only needs setting elsewhere.
APP_URL=""
# Shared secret Vercel Cron sends to /api/cron/*. Generate with: openssl rand -hex 32
CRON_SECRET=""

# --- Alarms and evidence (all optional; each stays off until it's set. docs/incident.md) ---
# Healthchecks.io project ping key: each scheduled job pings jane-<job> on start, finish and failure.
HEALTHCHECKS_PING_KEY=""
# Only for a self-hosted Healthchecks or a local test. Defaults to https://hc-ping.com.
HEALTHCHECKS_URL=""
# Lets .github/workflows/probe.yml run the hourly sign-in and cross-user check (src/lib/probe.ts).
# Generate with: openssl rand -hex 32. The same value goes in the repository's PROBE_SECRET secret.
PROBE_SECRET=""
# Sentry project DSN: server errors go there, scrubbed (src/lib/sentry.ts, docs/security/vendors.md).
SENTRY_DSN=""

# --- Running without a person in the loop (docs/ops.md). All off until set. ---
# 1 reads the emergency switches from the database, so they apply in seconds with no deploy.
OPS_SWITCHES=""
# Each is `openssl rand -hex 32`. Reduce: banks, uploads, claude. High bar: also site, email.
# Founder: anything, and the only one that turns a switch off. Read: read-only, for the watch and reader.
OPS_REDUCE_SECRET=""
OPS_HIGH_BAR_SECRET=""
OPS_FOUNDER_SECRET=""
OPS_READ_SECRET=""

# --- Emergency switches (docs/incident.md): leave empty; "1" turns each one on at the next deploy ---
# The whole site answers 503.
KILL_SITE=""
# No call reaches Claude.
KILL_CLAUDE=""
# No new bank links and no syncing of real banks.
KILL_BANKS=""
# No upload is read.
KILL_UPLOADS=""
# No email leaves, sign-in links included.
KILL_EMAIL=""
# No connector reads, prefills or acts. Cancelling still works.
KILL_CONNECTORS=""

# --- Step 10: membership willingness-to-pay test (optional) ---
# Without Stripe keys the offer shows only the free "Reserve my spot" button; with them,
# a one-time "Become a founding member" Stripe Checkout payment appears too.
STRIPE_SECRET_KEY=""
# From the Stripe dashboard's webhook endpoint for /api/stripe/webhook
# (event: checkout.session.completed).
STRIPE_WEBHOOK_SECRET=""
# One-time founding-member price in cents. Defaults to 4900 ($49).
MEMBERSHIP_TEST_PRICE=""

# --- Step 11: beta hardening ---
# Comma-separated emails that become admins when they sign in (they still enrol in
# two-factor on first visit to /admin).
ADMIN_EMAILS=""
# Comma-separated emails of the founders' own accounts that aren't admins (a personal email
# with their own bank data). Left out of the beta numbers on /admin/numbers and /admin/metrics,
# like admins, trial people and demo-bank-only accounts.
FOUNDER_EMAILS=""
# The closed beta: new real accounts need an invite code (from /admin/invites). On unless
# set to "false". Try Jane's sample-data trials never need one.
BETA_INVITE_ONLY=""

# --- Step 12: legal pages ---
# Set to "true" once counsel has reviewed the privacy policy and terms; until then the
# pages say they're drafts.
LEGAL_REVIEWED=""
# Where people write to us. Defaults to the address in EMAIL_FROM.
SUPPORT_EMAIL=""

# --- Opt-in live tests (local only; never set in Vercel) ---
# PLAID_SANDBOX_TEST="1" runs src/lib/plaid/sandbox.live.test.ts against Plaid Sandbox.
# ASK_LIVE_TEST="1" runs src/lib/ask/answer.live.test.ts against the Claude API.

# --- Step 26: phone notifications (optional) ---
# Web Push for urgent alerts. Leave empty to keep alerts by email only. Generate a pair
# once with `npx web-push generate-vapid-keys`; the subject is a mailto: or https: URL.
# How-to: docs/setup/push-alerts.md
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT=""

# --- Phase AW: automated investing, practice money only (optional) ---
# Alpaca market data (prices and news) for the practice portfolios and their backtests. PAPER keys
# only: Jane never places an order through Alpaca. With both set, the market data and the one-time
# history load (/api/cron/market-history) use Alpaca; otherwise the built-in sample market runs.
ALPACA_API_KEY_ID=""
ALPACA_API_SECRET_KEY=""
# The data feed. The free one is "iex"; leave it as it is unless the account has another.
ALPACA_DATA_FEED="iex"
# The feed the daily history load uses (/api/cron/market-history). "sip" goes back to 2016 on the
# free plan (bars older than 15 minutes); "iex" daily bars start in mid-2020.
ALPACA_HISTORY_FEED="sip"
# The paper account (src/lib/paper/prices.ts) uses Alpaca's daily closes when its keys are set,
# else Yahoo Finance's free daily chart in production. "1" uses the sample market instead (the e2e
# tests); outside production the sample market is the default.
PAPER_SAMPLE_PRICES=""
# SEC EDGAR asks every caller to say who it is: a name and a contact address. Filings stay off
# until it is set.
EDGAR_USER_AGENT=""

# Events overlay: "off" stops opening the investments page from reading the live event sources
# (GDELT, the Fed, BLS, EIA); the daily cron still reads them. The end-to-end tests set it.
EVENTS_REFRESH=""

# "1" answers a few scripted chat messages with a fake Claude (src/lib/jane-agent/fake-chat-claude.ts),
# for the end-to-end tests only; never on a Vercel production deploy. Leave it empty.
CHAT_FAKE_CLAUDE=""

# Jane's chat asks the API to answer on another model when a safety classifier declines
# (fallbacks "default", beta server-side-fallback-2026-07-01: src/lib/jane-agent/refusal-fallback.ts).
# On unless "off".
CHAT_REFUSAL_FALLBACK=""
# 1 sends Claude all its chat tools on every request, not only those a question is about (costs more).
CHAT_ALL_TOOLS=""
