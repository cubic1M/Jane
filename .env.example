# Copy to .env and fill in. Never commit .env.
# Grouped by the build step that first needs each value.

# --- Step 1: database ---
# Pooled connection used by the app at runtime (Neon: host contains "-pooler").
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=verify-full"
# Direct (non-pooled) connection used only by Prisma migrations.
DIRECT_URL="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/neondb?sslmode=verify-full"

# Separate scratch database for the cross-user access test (src/lib/db-scoped.integration.test.ts).
# Optional locally; CI provides one. Run `npx prisma migrate deploy` against it first.
TEST_DATABASE_URL=""

# --- Step 1: analytics (optional; events still save to the database without it) ---
# PostHog project API key, starts with phc_
POSTHOG_KEY=""
# https://us.i.posthog.com or https://eu.i.posthog.com
POSTHOG_HOST="https://us.i.posthog.com"

# --- Step 2: auth ---
# Random secret for Auth.js sessions. Generate with: openssl rand -base64 32
AUTH_SECRET=""
# Google OAuth client (optional at first; the Google button hides without it).
# Authorized redirect URI: <app url>/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# --- Step 2: email ---
# Resend API key, for magic links, status updates and digests.
# Leave empty in local dev to print magic links to the server console instead.
RESEND_API_KEY=""
# Verified sender, e.g. "Financial Controller <hello@yourdomain.com>"
EMAIL_FROM=""

# --- Step 2: token encryption ---
# 32-byte key for AES-256-GCM, base64. Generate with: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=""

# --- Step 3: LLM (optional; without a key, transactions the keyword rules can't
# place stay uncategorized) ---
ANTHROPIC_API_KEY=""
# Model for categorization and finding explanations. Defaults to claude-opus-5-5.
ANTHROPIC_MODEL=""

# --- Step 7: Plaid (Transactions only) ---
PLAID_CLIENT_ID=""
PLAID_SECRET=""
# sandbox | production
PLAID_ENV="sandbox"
# Public address of the app, for Plaid's webhook URL. On Vercel it defaults to the
# production domain, so it only needs setting elsewhere.
APP_URL=""
# Shared secret Vercel Cron sends to /api/cron/*. Generate with: openssl rand -hex 32
CRON_SECRET=""

# --- Step 10: membership willingness-to-pay test (optional) ---
# Without Stripe keys the offer shows only the free "Reserve my spot" button; with them,
# a one-time "Become a founding member" Stripe Checkout payment appears too.
STRIPE_SECRET_KEY=""
# From the Stripe dashboard's webhook endpoint for /api/stripe/webhook
# (event: checkout.session.completed).
STRIPE_WEBHOOK_SECRET=""
# One-time founding-member price in cents. Defaults to 4900 ($49).
MEMBERSHIP_TEST_PRICE=""
