{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "crons": [
    {
      "path": "/api/cron/plaid-sync",
      "schedule": "0 10 * * *"
    },
    {
      "path": "/api/cron/digest",
      "schedule": "0 15 * * *"
    }
  ],
  "git": {
    "deploymentEnabled": {
      "claude/**": false,
      "worktree-*": false,
      "review-*": false
    }
  }
}
