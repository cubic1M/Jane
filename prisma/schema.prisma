generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Conventions: money is integer cents, timestamps are UTC (timestamptz), and every
// user-owned row has user_id and is deleted with its user. Query user-owned tables
// through src/lib/db-scoped.ts, never the raw client.

enum Role {
  user
  admin

  @@map("role")
}

enum FindingType {
  subscription_review
  duplicate_subscription
  price_increase
  bank_fees
  idle_cash
  insurance_reshop
  card_interest
  low_balance_risk
  duplicate_charge
  charge_after_cancel
  trial_conversion
  bill_negotiation
  // Spec step 152: a plan the person pays for that a card of theirs already covers.
  covered_by_card

  @@map("finding_type")
}

enum FindingStatus {
  new
  shown
  approved
  declined
  in_progress
  done
  failed

  @@map("finding_status")
}

enum Confidence {
  low
  medium
  high

  @@map("confidence")
}

enum AgentState {
  // Writing or sending.
  working
  // Sent; waiting for the company's reply (or the next follow-up).
  waiting_reply
  // Cancelled (by the person, through the company's own page): waiting to see no
  // further charge before calling it done.
  confirming
  // Passed to the team, with a reason.
  handed_off
  // Done, by the agent.
  finished
  // Switching to the option the person picked (spec step 77): they sign up with the link;
  // Jane watches for the new charge (or the cheaper one, or the transfer).
  switching

  @@map("agent_state")
}

enum AgentDirection {
  outbound
  inbound
  // A step Jane took that isn't a message: a hand-off, a refund seen, a cancellation
  // confirmed. Shown on the timeline in plain words.
  note

  @@map("agent_direction")
}

enum AutopilotLevel {
  // Ask me first: no standing rules.
  ask
  // Handle the safe stuff: refunds, fee refunds, small price pushback, lower card rates.
  safe
  // Everything a rule is allowed to do, with higher limits.
  all
  // The person fine-tuned the rules by hand.
  custom

  @@map("autopilot_level")
}

enum ProposalStatus {
  open
  accepted
  dismissed

  @@map("proposal_status")
}

enum DecisionSource {
  card
  plan
  rule
  // A follow-up Jane starts on its own because of an earlier yes: a refund when a
  // company charges after a cancellation the person approved.
  auto
  // A one-tap link from the weekly email or a notification (spec step 60).
  link
  // A button on one of Jane's messages in the chat (spec step 81).
  chat

  @@map("decision_source")
}

enum DecisionChoice {
  yes
  no
  // "I'll do it myself": no concierge action; the person follows a kit and marks it done.
  diy

  @@map("decision_choice")
}

enum ActionType {
  cancel_subscription
  fight_price_increase
  recover_bank_fees
  move_idle_cash
  insurance_reshop
  card_interest
  review_cash_flow
  request_refund
  negotiate_bill

  @@map("action_type")
}

enum ActionStatus {
  queued
  in_progress
  waiting_on_user
  done
  failed

  @@map("action_status")
}

enum MembershipIntentKind {
  reserve
  paid

  @@map("membership_intent_kind")
}

// Things worth a person's attention, raised after each sync or import (src/alerts).
enum AlertType {
  new_subscription
  price_increase
  fee_charged
  large_charge
  duplicate_charge
  low_balance
  over_budget
  bill_due
  renews_soon
  deadline_soon
  // The IRS estimated-payment date is coming up, for people with contracting or gig
  // income (spec step 72).
  estimated_tax
  // Spec step 208: a charge, bill or refund that doesn't look right ("this was me" / "not me").
  unusual_activity

  @@map("alert_type")
}

// Where an account or transaction came from. CSV is the founders' own exports;
// Plaid arrives in step 7 behind the same DataSource interface.
enum DataSourceKind {
  csv
  plaid

  @@map("data_source")
}

// Who set a transaction's category: our keyword rules, the LLM, or Plaid itself.
enum CategorySource {
  rule
  llm
  plaid
  // Set by the person: on one transaction, or as a rule for a merchant. Wins over the rest.
  user

  @@map("category_source")
}

// Where a finding's explanation came from: Claude, or the fixed text for its type when
// Claude's answer failed the guardrails.
enum ExplanationSource {
  llm
  template

  @@map("explanation_source")
}

enum ActorType {
  user
  admin
  system

  @@map("actor_type")
}

model User {
  id                         String          @id @default(cuid())
  email                      String          @unique
  emailVerified              DateTime?       @map("email_verified") @db.Timestamptz(3)
  name                       String?
  image                      String?
  role                       Role            @default(user)
  createdAt                  DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                  DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt                  DateTime?       @map("deleted_at") @db.Timestamptz(3)
  // Set when detection first finishes for this user, so /scanning knows it can move on.
  firstDetectionAt           DateTime?       @map("first_detection_at") @db.Timestamptz(3)
  // When the first scan after linking a bank finished completely (detection, the sectors'
  // work and Jane's first run). Until then the chat opens early and says she's still looking.
  firstScanDoneAt            DateTime?       @map("first_scan_done_at") @db.Timestamptz(3)
  // Email preferences, changed on /settings or by the unsubscribe link.
  digestEnabled              Boolean         @default(true) @map("digest_enabled")
  // IANA name, e.g. America/New_York. Null means US Pacific.
  timezone                   String?
  // Membership offer: when it was last shown (counted once per snooze period) and when
  // the person last said "not now".
  membershipOfferShownAt     DateTime?       @map("membership_offer_shown_at") @db.Timestamptz(3)
  membershipOfferDismissedAt DateTime?       @map("membership_offer_dismissed_at") @db.Timestamptz(3)
  // When we last warned that linked banks will be disconnected for inactivity.
  plaidRemovalWarnedAt       DateTime?       @map("plaid_removal_warned_at") @db.Timestamptz(3)
  // Per alert type: "email", "app" or "off". Missing types use the defaults in
  // src/config/alerts.ts.
  alertPrefs                 Json            @default("{}") @map("alert_prefs")
  // The private calendar feed (/api/calendar/<token>): SHA-256 of the link's secret, so a
  // database leak doesn't reveal working links. Null when the feed is off.
  calendarTokenHash          String?         @unique @map("calendar_token_hash")
  calendarCreatedAt          DateTime?       @map("calendar_created_at") @db.Timestamptz(3)
  // Two-letter US state, chosen on /settings. Referral partners are only offered where
  // they're allowed; with no state, none are.
  state                      String?
  // Admin two-factor (TOTP). The secret is AES-256-GCM encrypted like Plaid tokens;
  // mfaEnabledAt is set once the first code checks out.
  mfaSecretEncrypted         String?         @map("mfa_secret_encrypted")
  mfaEnabledAt               DateTime?       @map("mfa_enabled_at") @db.Timestamptz(3)
  // The Terms and Privacy Policy version the person last accepted (src/config/legal.ts).
  termsVersion               String?         @map("terms_version")
  termsAcceptedAt            DateTime?       @map("terms_accepted_at") @db.Timestamptz(3)
  // The first-weeks checklist on Home: when each item was first seen done (item key to
  // ISO time, so each funnel event fires once) and when the person hid it for good.
  checklistProgress          Json            @default("{}") @map("checklist_progress")
  checklistDismissedAt       DateTime?       @map("checklist_dismissed_at") @db.Timestamptz(3)
  // How much Jane does on its own (spec step 57). Null until the person picks.
  autopilot                  AutopilotLevel?
  // On bill calls, accept any lower price with no contract and no fee, even on a different
  // plan of the same service (spec step 62). Off: every offer comes to the person.
  acceptSimpleOffers         Boolean         @default(false) @map("accept_simple_offers")
  // Jane's chat messages as notifications (spec step 85): { channel, kinds }. Missing values
  // use the defaults in src/config/chat-notify.ts.
  chatNotifyPrefs            Json            @default("{}") @map("chat_notify_prefs")

  authAccounts           AuthAccount[]
  mfaBackupCodes         MfaBackupCode[]
  standingRules          StandingRule[]
  agentMessages          AgentMessage[]
  planProposals          PlanProposal[]
  planLinks              PlanLink[]
  janeMessages           JaneMessage[]
  janePreferences        JanePreference[]
  chatReplyLinks         ChatReplyLink[]
  deadlines              Deadline[]
  sessions               Session[]
  plaidItems             PlaidItem[]
  accounts               Account[]
  transactions           Transaction[]
  recurringStreams       RecurringStream[]
  liabilities            Liability[]
  ownedAssets            OwnedAsset[]
  debtTerms              DebtTerms[]
  debtPlan               DebtPlan?
  refinanceCheck         RefinanceCheck?
  loanApplications       LoanApplication[]
  studentLoanProfile     StudentLoanProfile?
  creditReports          CreditReport[]
  debtWatch              DebtWatch?
  cardApplications       CardApplication[]
  tightRequests          TightRequest[]
  medicalBills           MedicalBill[]
  medicalRequests        MedicalRequest[]
  creditDisputes         CreditDispute[]
  cardPromos             CardPromo[]
  cardRateRequests       CardRateRequest[]
  personalLoans          PersonalLoan[]
  creditGoals            CreditGoal[]
  homeEquityFacts        HomeEquityFacts?
  carAddons              CarAddon[]
  carLoanWatch           CarLoanWatch?
  rentReporting          RentReporting?
  securityDeposits       SecurityDeposit[]
  balanceTransfers       BalanceTransfer[]
  findings               Finding[]
  decisions              Decision[]
  actions                Action[]
  digests                Digest[]
  membershipIntents      MembershipIntent[]
  analyticsEvents        AnalyticsEvent[]
  merchantCategories     MerchantCategory[]
  subscriptionChecks     SubscriptionCheck[]
  alerts                 Alert[]
  askConversations       AskConversation[]
  askMessages            AskMessage[]
  householdMember        HouseholdMember?
  householdInvites       HouseholdInvite[]
  pushSubscriptions      PushSubscription[]
  referralConversions    ReferralConversion[]
  budgets                Budget[]
  savingsGoals           SavingsGoal[]
  balanceSnapshots       BalanceSnapshot[]
  checkIns               CheckIn[]
  documents              Document[]
  // Insurance (spec Phase X).
  insurancePolicies      InsurancePolicy[]
  insuranceProfile       InsuranceProfile?
  insuranceQuotes        InsuranceQuote[]
  insuranceShops         InsuranceShop[]
  insuranceCheckups      InsuranceCheckup[]
  insuranceClaims        InsuranceClaim[]
  disasterLosses         DisasterLoss[]
  draftReturns           DraftReturn[]
  employerBenefits       EmployerBenefit[]
  policyReadings         PolicyReading[]
  lifeApplications       LifeApplication[]
  coverChanges           CoverChange[]
  renewalNegotiations    RenewalNegotiation[]
  insuranceSavings       InsuranceSaving[]
  insuranceRisks         InsuranceRisk[]
  lifeEvents             LifeEvent[]
  // What's in investment accounts (spec step 128).
  securities             Security[]
  holdings               Holding[]
  investmentTransactions InvestmentTransaction[]
  // What the investments are for (spec step 129).
  investorProfile        InvestorProfile?
  // Orders through the brokerage partner, simulated until one is connected (spec step 133).
  brokerageOrders        BrokerageOrder[]
  changeAcks             ChangeAck[]
  taxProfile             TaxProfile?
  lifeEventAnswers       LifeEventAnswer[]
  taxTags                TaxTag[]
  taxDocuments           TaxDocument[]
  priorReturns           PriorReturn[]
  taxAmendments          TaxAmendment[]
  taxNotices             TaxNotice[]
  taxIdentityCases       TaxIdentityCase[]
  equityEvents           EquityEvent[]
  taxForms               TaxForm[]
  taxReturns             TaxReturn[]
  budgetTuneUps          BudgetTuneUp[]
  goalTransfers          GoalTransfer[]
  autoInvestPlan         AutoInvestPlan?
  autoInvestRuns         AutoInvestRun[]

  savedShares SavedShare[]

  autopilotSectors  AutopilotSector[]
  autopilotActs     AutopilotAct[]
  collegePlans      CollegePlan[]
  hsaReceipts       HsaReceipt[]
  equityGrants      EquityGrant[]
  cryptoConnections CryptoConnection[]
  cryptoHoldings    CryptoHolding[]
  controllerRuns    ControllerRun[]
  moneyTransfers    MoneyTransfer[]
  paycheckPlans     PaycheckPlan[]
  healthScores      HealthScore[]
  monthlyReports    MonthlyReport[]
  whatIfPlans       WhatIfPlan[]
  taxPlanEvents     TaxPlanEvent[]
  propertyAppeals   PropertyAppeal[]
  accountantLinks   AccountantLink[]
  accountantNotes   AccountantNote[]
  taxPayments       TaxPayment[]
  leanPlans         LeanPlan[]
  booksIssues       BooksIssue[]
  suggestions       Suggestion[]
  yearPlans         YearPlan[]
  unusualAnswers    UnusualAnswer[]

  payrollChanges PayrollChange[]
  oldPlans       OldPlan[]

  retirementIncome RetirementIncome?

  giftLinks GiftLink[]

  familyChildren FamilyChild[]

  rentalProperties RentalProperty[]

  costlyProducts CostlyProduct[]

  planMenus            PlanMenu[]
  planChanges          PlanChange[]
  billLadders          BillLadder[]
  suddenMoneys         SuddenMoney[]
  valuesPreference     ValuesPreference?
  accountBeneficiaries AccountBeneficiary[]
  familyFile           FamilyFile?
  practicePortfolio    PracticePortfolio?
  practicePreferences  PracticePreferences?

  @@map("users")
}

// Auth.js tables. "accounts" is taken by bank accounts, so sign-in providers live in
// auth_accounts. OAuth tokens are not stored: we only use Google to sign in.
model AuthAccount {
  id                String   @id @default(cuid())
  userId            String   @map("user_id")
  type              String
  provider          String
  providerAccountId String   @map("provider_account_id")
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("auth_accounts")
}

model Session {
  id            String    @id @default(cuid())
  sessionToken  String    @unique @map("session_token")
  userId        String    @map("user_id")
  expires       DateTime  @db.Timestamptz(3)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  // Set when an admin enters a valid two-factor code in this session.
  mfaVerifiedAt DateTime? @map("mfa_verified_at") @db.Timestamptz(3)
  // Devices and sessions (spec step 73): the browser's user agent (trimmed, never an IP
  // address) and when this session was last used, updated at most every few minutes.
  userAgent     String?   @map("user_agent")
  lastSeenAt    DateTime? @map("last_seen_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

// Magic-link tokens. Auth.js stores a hash, never the token from the email.
model VerificationToken {
  identifier String
  token      String
  expires    DateTime @db.Timestamptz(3)

  @@id([identifier, token])
  @@map("verification_tokens")
}

model PlaidItem {
  id                   String    @id @default(cuid())
  userId               String    @map("user_id")
  plaidItemId          String    @unique @map("plaid_item_id")
  // AES-256-GCM via src/lib/crypto.ts. Never log or return it.
  accessTokenEncrypted String    @map("access_token_encrypted")
  institutionName      String?   @map("institution_name")
  status               String    @default("active")
  transactionsCursor   String?   @map("transactions_cursor")
  // Linked with Liabilities as an optional product (spec step 65): loans and card rates
  // are read on each sync. Items linked before that never are (it would start billing).
  liabilities          Boolean   @default(false)
  // Linked with Investments as an optional product (spec step 66): investment and
  // retirement balances, holdings and investment transactions (spec step 128) are read on
  // each sync.
  investments          Boolean   @default(false)
  // Demo bank only (spec step 159 on): extra stand-in accounts the person linked, e.g.
  // "hsa" for a demo HSA.
  demoExtras           String[]  @default([]) @map("demo_extras")
  lastSyncedAt         DateTime? @map("last_synced_at") @db.Timestamptz(3)
  createdAt            DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accounts Account[]

  @@index([userId])
  @@map("plaid_items")
}

model Account {
  id                    String         @id @default(cuid())
  userId                String         @map("user_id")
  source                DataSourceKind
  // Plaid-only; null for CSV accounts.
  itemId                String?        @map("item_id")
  plaidAccountId        String?        @unique @map("plaid_account_id")
  name                  String
  mask                  String?
  // Plaid's account type and subtype, e.g. depository/checking or credit/credit card.
  type                  String
  subtype               String?
  // Entered by hand for CSV accounts, which usually lack balances.
  currentBalanceCents   Int?           @map("current_balance_cents")
  availableBalanceCents Int?           @map("available_balance_cents")
  // Whether the person's household partner may see this account (read-only).
  sharedWithHousehold   Boolean        @default(false) @map("shared_with_household")
  createdAt             DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  user                   User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  item                   PlaidItem?              @relation(fields: [itemId], references: [id], onDelete: Cascade)
  transactions           Transaction[]
  recurringStreams       RecurringStream[]
  balanceSnapshots       BalanceSnapshot[]
  checkIns               CheckIn[]
  liability              Liability?
  ownedAssets            OwnedAsset[]
  // Spec step 128: what an investment account holds, and its buys, sells and contributions.
  holdings               Holding[]
  investmentTransactions InvestmentTransaction[]
  // Spec step 133: orders placed in it.
  brokerageOrders        BrokerageOrder[]
  beneficiaries          AccountBeneficiary[]

  @@index([userId])
  @@index([itemId])
  @@map("accounts")
}

model Transaction {
  id                 String          @id @default(cuid())
  userId             String          @map("user_id")
  accountId          String          @map("account_id")
  source             DataSourceKind
  // Plaid-only; null for CSV transactions.
  plaidTransactionId String?         @unique @map("plaid_transaction_id")
  // CSV-only: identifies a row across overlapping uploads (see src/data-sources/dedupe.ts).
  dedupeKey          String?         @map("dedupe_key")
  date               DateTime        @db.Date
  // Plaid's sign convention: positive is money out of the account.
  amountCents        Int             @map("amount_cents")
  description        String
  merchantName       String?         @map("merchant_name")
  // Plaid personal finance category, primary and detailed.
  pfcPrimary         String?         @map("pfc_primary")
  pfcDetailed        String?         @map("pfc_detailed")
  categorySource     CategorySource? @map("category_source")
  pending            Boolean         @default(false)
  createdAt          DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)

  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  account    Account     @relation(fields: [accountId], references: [id], onDelete: Cascade)
  taxTags    TaxTag[]
  hsaReceipt HsaReceipt?

  suddenMoney SuddenMoney?

  @@unique([accountId, dedupeKey])
  @@index([userId])
  @@index([accountId])
  @@index([userId, date])
  @@map("transactions")
}

model RecurringStream {
  id                 String    @id @default(cuid())
  userId             String    @map("user_id")
  accountId          String    @map("account_id")
  plaidStreamId      String    @unique @map("plaid_stream_id")
  merchantName       String?   @map("merchant_name")
  // Plaid's values as given, e.g. MONTHLY; status e.g. MATURE.
  frequency          String
  lastAmountCents    Int       @map("last_amount_cents")
  averageAmountCents Int       @map("average_amount_cents")
  lastDate           DateTime? @map("last_date") @db.Date
  // Plaid's guess at the next charge, when it has one.
  predictedNextDate  DateTime? @map("predicted_next_date") @db.Date
  status             String
  isActive           Boolean   @default(true) @map("is_active")
  pfcPrimary         String?   @map("pfc_primary")
  pfcDetailed        String?   @map("pfc_detailed")
  // Plaid transaction ids in the stream, sorted by posted date.
  transactionIds     String[]  @default([]) @map("transaction_ids")
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([accountId])
  @@map("recurring_streams")
}

// What the bank reports about a card or loan through Plaid Liabilities (spec step 65):
// rate, payments and dates, one row per account. Read-only and refreshed on every sync.
// Account numbers, addresses and reference numbers are never stored.
model Liability {
  id                        String    @id @default(cuid())
  userId                    String    @map("user_id")
  accountId                 String    @unique @map("account_id")
  // credit, mortgage, student or loan (Plaid's list it came from).
  kind                      String
  // Yearly rate in basis points: 2499 is 24.99%. Cards: the purchase APR.
  aprBps                    Int?      @map("apr_bps")
  // fixed or variable, when the bank says.
  rateType                  String?   @map("rate_type")
  // What's due each month: a card's or student loan's minimum, a mortgage's or loan's
  // next payment.
  minimumPaymentCents       Int?      @map("minimum_payment_cents")
  nextPaymentDueDate        DateTime? @map("next_payment_due_date") @db.Date
  lastPaymentCents          Int?      @map("last_payment_cents")
  lastPaymentDate           DateTime? @map("last_payment_date") @db.Date
  originationPrincipalCents Int?      @map("origination_principal_cents")
  originationDate           DateTime? @map("origination_date") @db.Date
  // Mortgages and loans: the maturity date; student loans: the expected payoff date.
  payoffDate                DateTime? @map("payoff_date") @db.Date
  isOverdue                 Boolean?  @map("is_overdue")
  pastDueCents              Int?      @map("past_due_cents")
  ytdInterestPaidCents      Int?      @map("ytd_interest_paid_cents")
  // The bank's own description, e.g. "Conventional 30 year fixed".
  description               String?
  // Mortgages (spec step 115): whether it carries private mortgage insurance, what's in
  // escrow, and whether paying it off early costs a penalty, as Plaid reports them.
  hasPmi                    Boolean?  @map("has_pmi")
  escrowBalanceCents        Int?      @map("escrow_balance_cents")
  hasPrepaymentPenalty      Boolean?  @map("has_prepayment_penalty")
  // Cards (spec step 175): the last statement's date and balance, as Plaid reports them.
  lastStatementIssueDate    DateTime? @map("last_statement_issue_date") @db.Date
  lastStatementBalanceCents Int?      @map("last_statement_balance_cents")
  createdAt                 DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                 DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("liabilities")
}

// Things the person owns (spec step 67): a home, a car, anything else of value, at the
// value they give and the day they gave it. Counted in net worth; with the loan against it,
// shown as equity. Never estimated by Jane.
model OwnedAsset {
  id            String   @id @default(cuid())
  userId        String   @map("user_id")
  // home, vehicle or other.
  kind          String
  name          String
  valueCents    Int      @map("value_cents")
  valuedOn      DateTime @map("valued_on") @db.Date
  // The mortgage or car loan against it, when there is one.
  loanAccountId String?  @map("loan_account_id")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  loanAccount Account? @relation(fields: [loanAccountId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@map("owned_assets")
}

// Terms the person typed for a debt the bank doesn't report (spec step 109): a card or
// loan with no rate from the bank, or a buy now, pay later plan found from payments. Only
// fills what the bank leaves out; the bank's figures always win.
model DebtTerms {
  id                  String    @id @default(cuid())
  userId              String    @map("user_id")
  // "account:<id>" or "bnpl:<plan key>" (src/insights/debts.ts).
  debtKey             String    @map("debt_key")
  aprBps              Int?      @map("apr_bps")
  minimumPaymentCents Int?      @map("minimum_payment_cents")
  // Buy now, pay later plans only: what's left to pay.
  balanceCents        Int?      @map("balance_cents")
  payoffDate          DateTime? @map("payoff_date") @db.Date
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, debtKey])
  @@map("debt_terms")
}

// The payoff plan the person started (spec step 110): the order and the extra a month.
// Jane checks it every month against what's owed, then lays out the months ahead again
// from the new balances.
model DebtPlan {
  id                    String   @id @default(cuid())
  userId                String   @unique @map("user_id")
  // avalanche (highest rate first) or snowball (smallest balance first).
  strategy              String
  // Paid on top of the minimums each month.
  extraCents            Int      @map("extra_cents")
  startedOn             DateTime @map("started_on") @db.Date
  // The last check (or the start): the expected balances below run from here.
  checkedOn             DateTime @map("checked_on") @db.Date
  // What the plan's debts should add up to at the end of each month after checkedOn.
  expected              Json     @default("[]")
  // YYYY-MM.
  debtFreeMonth         String?  @map("debt_free_month")
  previousDebtFreeMonth String?  @map("previous_debt_free_month")
  // on_track or off_track at the last check; null before the first.
  status                String?
  // At the last check: what the plan expected, and what was owed.
  expectedCents         Int?     @map("expected_cents")
  actualCents           Int?     @map("actual_cents")
  createdAt             DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("debt_plans")
}

// Refinance offers Jane asked the lender partner for (spec step 111), once a month by
// herself: each debt that can be refinanced, the months compared over and the offers the
// person prequalified for (a soft check). Nothing here is an application.
model RefinanceCheck {
  id        String   @id @default(cuid())
  userId    String   @unique @map("user_id")
  checkedOn DateTime @map("checked_on") @db.Date
  // The partner that quoted them ("demo" for the stand-in catalog).
  partner   String
  // [{ debtKey, product, termMonths, amountCents, offers: LoanOffer[] }]
  quotes    Json     @default("[]")
  // Spec step 113: 0% balance transfer cards for each card, [{ debtKey, amountCents,
  // offers: TransferOffer[] }].
  transfers Json     @default("[]")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("refinance_checks")
}

// A loan application Jane prepared for a refinance offer (spec step 112): the terms the
// person reviewed, and where it stands. Nothing is sent to the lender until they tap
// Submit, and nothing is signed until they tap Accept. Then Jane watches the new loan fund
// and the old one reach zero.
model LoanApplication {
  id                   String    @id @default(cuid())
  userId               String    @map("user_id")
  // The debt it replaces ("account:<id>") and that account, to watch it reach zero.
  debtKey              String    @map("debt_key")
  oldAccountId         String?   @map("old_account_id")
  oldName              String    @map("old_name")
  partner              String
  offerId              String    @map("offer_id")
  lender               String
  product              String
  aprBps               Int       @map("apr_bps")
  rateType             String    @map("rate_type")
  termMonths           Int       @map("term_months")
  amountCents          Int       @map("amount_cents")
  feeCents             Int       @map("fee_cents")
  monthlyCents         Int       @map("monthly_cents")
  totalCents           Int       @map("total_cents")
  savingCents          Int       @map("saving_cents")
  // draft, approved, declined, accepted, funded, paid_off or withdrawn.
  status               String    @default("draft")
  // The prefilled details sent with it (names, never account numbers).
  applicant            Json      @default("{}")
  partnerApplicationId String?   @map("partner_application_id")
  reviewedAt           DateTime? @map("reviewed_at") @db.Timestamptz(3)
  submittedAt          DateTime? @map("submitted_at") @db.Timestamptz(3)
  acceptedAt           DateTime? @map("accepted_at") @db.Timestamptz(3)
  fundedAt             DateTime? @map("funded_at") @db.Timestamptz(3)
  paidOffAt            DateTime? @map("paid_off_at") @db.Timestamptz(3)
  createdAt            DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("loan_applications")
}

// What the person told Jane for comparing student loan plans (spec step 114): income and
// family for the income-driven plans, public service work for PSLF, qualifying payments
// counted before Jane could see them, and how far through studentaid.gov's steps they are.
model StudentLoanProfile {
  id                  String    @id @default(cuid())
  userId              String    @unique @map("user_id")
  // Adjusted gross income from the last tax return; null means Jane estimates it.
  agiCents            Int?      @map("agi_cents")
  familySize          Int       @default(1) @map("family_size")
  dependants          Int       @default(0)
  // new (first loans on or after July 1, 2014) or old.
  borrower            String    @default("new")
  publicService       Boolean   @default(false) @map("public_service")
  // Qualifying payments studentaid.gov counted before the ones Jane sees.
  countedBefore       Int       @default(0) @map("counted_before")
  // How many of the guided steps (STUDENT_STEPS) are done.
  stepsDone           Int       @default(0) @map("steps_done")
  // Spec step 225: federal or private, the day the employer was last certified for PSLF,
  // the day the income-driven plan must be recertified, and the deadlines Jane put on the
  // deadlines list for them and for the tax on forgiven debt.
  loanType            String    @default("federal") @map("loan_type")
  lastCertifiedOn     DateTime? @map("last_certified_on") @db.Date
  recertifyOn         DateTime? @map("recertify_on") @db.Date
  certifyDeadlineId   String?   @map("certify_deadline_id")
  recertifyDeadlineId String?   @map("recertify_deadline_id")
  taxDeadlineId       String?   @map("tax_deadline_id")
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("student_loan_profiles")
}

// A credit score Jane pulled (spec step 116), a soft pull once a month: the score and the
// facts behind it from the credit partner. Kept to show how it moves. The stand-in's are
// marked demo and never a real score.
model CreditReport {
  id               String   @id @default(cuid())
  userId           String   @map("user_id")
  partner          String
  score            Int
  model            String
  rangeLow         Int      @map("range_low")
  rangeHigh        Int      @map("range_high")
  cardLimitCents   Int      @map("card_limit_cents")
  averageAgeMonths Int      @map("average_age_months")
  hardInquiries    Int      @map("hard_inquiries")
  // What Jane saw when she pulled it, for the factors: card balances, an overdue loan,
  // late fees in the last year, whether there's an installment loan.
  inputs           Json     @default("{}")
  demo             Boolean  @default(false)
  pulledOn         DateTime @map("pulled_on") @db.Date
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, pulledOn])
  @@map("credit_reports")
}

// Debt on autopilot (spec step 117): the rates Jane last saw on each debt, so she can say
// when the bank changes one, and when she started the payoff plan by herself.
model DebtWatch {
  id             String    @id @default(cuid())
  userId         String    @unique @map("user_id")
  // { debtKey: aprBps } as last seen.
  rates          Json      @default("{}")
  // The latest changes, newest first: [{ debtKey, name, fromBps, toBps, on }].
  changes        Json      @default("[]")
  planStartedOn  DateTime? @map("plan_started_on") @db.Date
  // Spec step 230, the yearly debt review: the day of the last one and why it was done, the
  // debts there were then (a new one starts a review), and the paycheck then (a raise does).
  reviewOn       DateTime? @map("review_on") @db.Date
  reviewReason   String?   @map("review_reason")
  reviewKeys     Json      @default("[]") @map("review_keys")
  reviewPayCents Int?      @map("review_pay_cents")
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("debt_watches")
}

// A credit card applied for through Jane (spec step 174), only after the person tapped
// Apply: the card, and what the issuer said.
model CardApplication {
  id                   String   @id @default(cuid())
  userId               String   @map("user_id")
  partner              String
  productId            String   @map("product_id")
  issuer               String
  cardName             String   @map("card_name")
  annualFeeCents       Int      @map("annual_fee_cents")
  // pending, approved or declined.
  status               String
  partnerApplicationId String?  @map("partner_application_id")
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("card_applications")
}

// A request Jane sent for someone whose money is tight (spec step 177), each only after the
// person's tap: a due-date move, a hardship program, a lower rate or a late fee waived. The
// lender stand-in answers it.
model TightRequest {
  id          String    @id @default(cuid())
  userId      String    @map("user_id")
  // "<kind>:<debt key>:<the shortfall's date>", so one is sent once for each shortfall.
  key         String
  kind        String
  targetKey   String    @map("target_key")
  targetName  String    @map("target_name")
  body        String
  // sent, granted or declined.
  status      String
  partner     String
  shortfallOn DateTime  @map("shortfall_on") @db.Date
  sentAt      DateTime  @default(now()) @map("sent_at") @db.Timestamptz(3)
  resolvedAt  DateTime? @map("resolved_at") @db.Timestamptz(3)
  outcome     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, key])
  @@map("tight_requests")
}

// A medical bill the person typed in (spec step 180), for care that didn't show up in their
// payments. Bills found from payments are not stored.
model MedicalBill {
  id          String   @id @default(cuid())
  userId      String   @map("user_id")
  provider    String
  amountCents Int      @map("amount_cents")
  billedOn    DateTime @map("billed_on") @db.Date
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("medical_bills")
}

// A request sent about a medical bill (spec step 180), only after the person's tap: an
// itemized bill, a check with their insurance, a financial assistance application or a
// payment plan at no interest. The provider stand-in answers it.
model MedicalRequest {
  id          String    @id @default(cuid())
  userId      String    @map("user_id")
  // "<kind>:<bill key>", once for each bill.
  key         String
  kind        String
  billKey     String    @map("bill_key")
  provider    String
  amountCents Int       @map("amount_cents")
  body        String
  // sent, granted or declined.
  status      String
  partner     String
  sentAt      DateTime  @default(now()) @map("sent_at") @db.Timestamptz(3)
  resolvedAt  DateTime? @map("resolved_at") @db.Timestamptz(3)
  outcome     String?
  // What the answer takes off the bill, when it does (assistance), else 0.
  savedCents  Int       @default(0) @map("saved_cents")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, key])
  @@map("medical_requests")
}

// A letter sent about a collection or an error on the person's credit report (spec step
// 181), only after their tap: a debt validation letter to the collector, or a dispute to the
// credit bureaus. The partner stand-in answers it.
model CreditDispute {
  id          String    @id @default(cuid())
  userId      String    @map("user_id")
  // "<kind>:<report item id>", once for each item and kind.
  key         String
  kind        String
  itemId      String    @map("item_id")
  // collection or error.
  itemKind    String    @map("item_kind")
  itemName    String    @map("item_name")
  amountCents Int?      @map("amount_cents")
  body        String
  // sent, then resolved with an outcome.
  status      String
  partner     String
  sentAt      DateTime  @default(now()) @map("sent_at") @db.Timestamptz(3)
  // The date the rule gives for an answer (30 days), also on the deadlines list.
  deadlineOn  DateTime  @map("deadline_on") @db.Date
  deadlineId  String?   @map("deadline_id")
  resolvedAt  DateTime? @map("resolved_at") @db.Timestamptz(3)
  // Whether the answer removed or corrected the item.
  removed     Boolean   @default(false)
  outcome     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, key])
  @@map("credit_disputes")
}

// A 0% promotion on a card the person typed in (spec step 224): the balance it covers, when
// it ends, and whether unpaid interest from the start is charged if it isn't cleared by then
// (deferred interest). Jane turns the end into a deadline when the pace is short.
model CardPromo {
  id           String   @id @default(cuid())
  userId       String   @map("user_id")
  cardName     String   @map("card_name")
  // What's left to clear, as the person typed it.
  balanceCents Int      @map("balance_cents")
  startedOn    DateTime @map("started_on") @db.Date
  endsOn       DateTime @map("ends_on") @db.Date
  // The rate charged after the promotion, or from the start if interest is deferred.
  goToAprBps   Int      @map("go_to_apr_bps")
  deferred     Boolean  @default(false)
  // The deadline Jane put on the deadlines list when the pace fell short.
  deadlineId   String?  @map("deadline_id")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("card_promos")
}

// A request for a lower rate on a card (spec step 224), written out with a call script and
// sent to the lender stand-in only after the person's tap.
model CardRateRequest {
  id                String    @id @default(cuid())
  userId            String    @map("user_id")
  // "account:<id>", once for each card and month.
  key               String
  debtKey           String    @map("debt_key")
  cardName          String    @map("card_name")
  oldAprBps         Int       @map("old_apr_bps")
  body              String
  // sent, granted or declined.
  status            String
  partner           String
  sentAt            DateTime  @default(now()) @map("sent_at") @db.Timestamptz(3)
  resolvedAt        DateTime? @map("resolved_at") @db.Timestamptz(3)
  newAprBps         Int?      @map("new_apr_bps")
  // What the new rate saves a year on the card's balance when it was asked.
  savingYearlyCents Int       @default(0) @map("saving_yearly_cents")
  outcome           String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, key])
  @@map("card_rate_requests")
}

// Money lent to or borrowed from family and friends, or a loan the person co-signed (spec
// step 226). A transfer in a payment app becomes a loan only after the person says so; a
// co-signed loan is one of their own debts, watched for missed payments. Jane never messages
// the other person.
model PersonalLoan {
  id             String    @id @default(cuid())
  userId         String    @map("user_id")
  // lent, borrowed or cosigned.
  kind           String
  counterparty   String
  // The first transfer's amount (lent, borrowed); 0 for a co-signed loan.
  principalCents Int       @map("principal_cents")
  openedOn       DateTime  @map("opened_on") @db.Date
  // The payment-app transfer it came from ("tx:<id>"), or the co-signed debt ("account:<id>").
  sourceKey      String    @map("source_key")
  note           String?
  // open, settled or dismissed (the person said it isn't a loan).
  status         String    @default("open")
  settledOn      DateTime? @map("settled_on") @db.Date
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, sourceKey])
  @@index([userId])
  @@map("personal_loans")
}

// A credit score the person needs by a date (spec step 227): a mortgage next spring, a car in
// six months. Jane builds a monthly plan from the credit partner's score simulator; each
// month's checklist items the person has done are kept here.
model CreditGoal {
  id          String    @id @default(cuid())
  userId      String    @map("user_id")
  name        String
  // mortgage, car or other.
  kind        String
  targetScore Int       @map("target_score")
  targetDate  DateTime  @map("target_date") @db.Date
  // The checklist items done so far, as "<month>:<item key>".
  done        Json      @default("[]")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  endedOn     DateTime? @map("ended_on") @db.Date

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("credit_goals")
}

// What the person told Jane about their home loan (spec step 228): the home's value when the
// loan began (PMI is measured against it), the yearly property tax and insurance bills they
// read off their bills, and when they sent each drafted request.
model HomeEquityFacts {
  id                   String    @id @default(cuid())
  userId               String    @unique @map("user_id")
  originalValueCents   Int?      @map("original_value_cents")
  yearlyTaxCents       Int?      @map("yearly_tax_cents")
  yearlyInsuranceCents Int?      @map("yearly_insurance_cents")
  pmiLetterSentOn      DateTime? @map("pmi_letter_sent_on") @db.Date
  escrowRequestSentOn  DateTime? @map("escrow_request_sent_on") @db.Date
  updatedAt            DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("home_equity_facts")
}

// A dealer add-on financed into the car loan (spec step 245): GAP, an extended warranty or
// a service contract, found in the payments or typed in, with the refund each would give.
model CarAddon {
  id         String   @id @default(cuid())
  userId     String   @map("user_id")
  // "tx:<transaction id>" for one found in the payments, else "typed:<id>".
  key        String
  // gap, warranty or service.
  kind       String
  name       String
  paidCents  Int      @map("paid_cents")
  termMonths Int      @map("term_months")
  startedOn  DateTime @map("started_on") @db.Date
  // found (asked once), confirmed, dismissed, mine (the person sends the cancellation),
  // team (the concierge team does).
  status     String   @default("found")
  source     String
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, key])
  @@index([userId])
  @@map("car_addons")
}

// What Jane saw when she last checked the car loan's rates (spec step 245), so she can say
// when rates fell or the score moved into a better band.
model CarLoanWatch {
  id         String    @id @default(cuid())
  userId     String    @unique @map("user_id")
  bestAprBps Int?      @map("best_apr_bps")
  band       String?
  // rates_fell or score_rose at the last check that saw it, and the day.
  change     String?
  changedOn  DateTime? @map("changed_on") @db.Date
  checkedOn  DateTime? @map("checked_on") @db.Date
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("car_loan_watches")
}

// The person's opt-in to having their rent payments reported to the credit bureaus through a
// reporting partner (spec step 248). No row, no reporting.
model RentReporting {
  id        String   @id @default(cuid())
  userId    String   @unique @map("user_id")
  partner   String
  optedInAt DateTime @map("opted_in_at") @db.Timestamptz(3)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("rent_reporting")
}

// A security deposit the person gave a landlord (spec step 248), tracked to the day the state
// says it is due back after they move out.
model SecurityDeposit {
  id            String    @id @default(cuid())
  userId        String    @map("user_id")
  amountCents   Int       @map("amount_cents")
  state         String
  movedOutOn    DateTime? @map("moved_out_on") @db.Date
  returnedOn    DateTime? @map("returned_on") @db.Date
  returnedCents Int?      @map("returned_cents")
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("security_deposits")
}

// A balance transfer the person made to a 0% card (spec step 113), so Jane can keep the
// promo's end in view: the payment that clears it in time, a deadline, and reminders.
model BalanceTransfer {
  id                 String    @id @default(cuid())
  userId             String    @map("user_id")
  // The card the balance came from ("account:<id>").
  fromDebtKey        String    @map("from_debt_key")
  fromName           String    @map("from_name")
  offerId            String    @map("offer_id")
  issuer             String
  cardName           String    @map("card_name")
  amountCents        Int       @map("amount_cents")
  feeCents           Int       @map("fee_cents")
  promoMonths        Int       @map("promo_months")
  goToAprBps         Int       @map("go_to_apr_bps")
  monthlyNeededCents Int       @map("monthly_needed_cents")
  startedOn          DateTime  @map("started_on") @db.Date
  promoEndsOn        DateTime  @map("promo_ends_on") @db.Date
  // The deadline it put on /deadlines (spec step 71).
  deadlineId         String?   @map("deadline_id")
  // active, done (paid off) or cancelled.
  status             String    @default("active")
  doneAt             DateTime? @map("done_at") @db.Timestamptz(3)
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("balance_transfers")
}

model Finding {
  id                 String             @id @default(cuid())
  userId             String             @map("user_id")
  type               FindingType
  // Identifies the same opportunity across scans (e.g. "merchant:netflix", "account:<id>"),
  // so a rescan updates the finding instead of adding another.
  key                String
  title              String
  // The card text: { title, explanation, giveUp, alternatives }. Null until generated;
  // the page shows template text meanwhile (src/lib/explanations.ts).
  explanation        Json?
  explanationSource  ExplanationSource? @map("explanation_source")
  // Audit trail: which model and prompt wrote it (both null for template text).
  explanationModel   String?            @map("explanation_model")
  explanationPrompt  String?            @map("explanation_prompt_version")
  // Hash of exactly what was sent. A different hash means the evidence changed and the
  // explanation is regenerated.
  explanationHash    String?            @map("explanation_input_hash")
  // Null when there is no dollar estimate (e.g. insurance reshop).
  annualSavingsCents Int?               @map("annual_savings_cents")
  // What the rule measured (annual cost, fees, excess cash). A declined finding only comes
  // back when this moves by more than the configured share.
  amountCents        Int?               @map("amount_cents")
  confidence         Confidence
  evidence           Json               @default("{}")
  status             FindingStatus      @default(new)
  createdAt          DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  decisions Decision[]

  @@unique([userId, type, key])
  @@index([userId, status])
  @@map("findings")
}

// Append-only log of every yes or no, with the card exactly as the user saw it.
model Decision {
  id           String         @id @default(cuid())
  findingId    String         @map("finding_id")
  userId       String         @map("user_id")
  choice       DecisionChoice
  cardSnapshot Json           @map("card_snapshot")
  createdAt    DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  // Set when the person undid a "no" within the undo window. The row itself is kept.
  undoneAt     DateTime?      @map("undone_at") @db.Timestamptz(3)
  // For a do-it-yourself decision: when the person said they'd done it.
  diyDoneAt    DateTime?      @map("diy_done_at") @db.Timestamptz(3)
  // Where the answer came from: the card itself, Jane's plan, or a standing rule.
  source       DecisionSource @default(card)
  // What the person changed before saying yes (src/config/plan.ts), e.g. downgrade
  // instead of cancel. Null means Jane's defaults.
  options      Json?
  // For an answer from a standing rule: which one (src/config/rules.ts).
  ruleKey      String?        @map("rule_key")

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  finding Finding @relation(fields: [findingId], references: [id], onDelete: Cascade)
  action  Action?

  @@index([userId])
  @@index([findingId])
  @@map("decisions")
}

model Action {
  id                   String       @id @default(cuid())
  decisionId           String       @unique @map("decision_id")
  userId               String       @map("user_id")
  type                 ActionType
  status               ActionStatus @default(queued)
  assignee             String?
  notes                String?
  // For waiting_on_user: exactly what the person needs to do, shown on /actions.
  userTodo             String?      @map("user_todo")
  // Why a failed action failed, so card copy and rules can be fixed. Team-only.
  failureReason        String?      @map("failure_reason")
  minutesSpent         Int?         @map("minutes_spent")
  // The action agent (spec step 51). Null for actions the team works by hand.
  agentState           AgentState?  @map("agent_state")
  // When the agent next looks at it (a follow-up if the company hasn't replied).
  agentNextAt          DateTime?    @map("agent_next_at") @db.Timestamptz(3)
  agentFollowUps       Int          @default(0) @map("agent_follow_ups")
  // Why the agent passed it to the team; shown on the queue.
  handoffReason        String?      @map("handoff_reason")
  // The random part of the reply-to address, so a company's reply finds its action.
  replyToken           String?      @unique @map("reply_token")
  // A refund seen coming back in the person's own transactions (spec step 52): the date
  // and how much. Counted as saved instead of the card's estimate.
  refundSeenAt         DateTime?    @map("refund_seen_at") @db.Date
  refundCents          Int?         @map("refund_cents")
  // For a cancellation the person did on the company's page: the day they did it, and
  // when a missed charge confirms it.
  cancelledOn          DateTime?    @map("cancelled_on") @db.Date
  confirmAfter         DateTime?    @map("confirm_after") @db.Date
  // The company's own cancel page, when only the account holder can cancel there.
  selfServiceUrl       String?      @map("self_service_url")
  // Yearly savings confirmed on a call (a lower monthly price, times twelve). Counted as
  // saved instead of the card's estimate.
  confirmedAnnualCents Int?         @map("confirmed_annual_cents")
  // Spec step 207: when Jane checked the person's transactions long after it was done and
  // the saving never showed up. Set, the action no longer counts as saved.
  savingMissedAt       DateTime?    @map("saving_missed_at") @db.Timestamptz(3)
  startedAt            DateTime?    @map("started_at") @db.Timestamptz(3)
  completedAt          DateTime?    @map("completed_at") @db.Timestamptz(3)
  createdAt            DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  decision      Decision       @relation(fields: [decisionId], references: [id], onDelete: Cascade)
  agentMessages AgentMessage[]

  @@index([userId])
  @@index([status, createdAt])
  @@index([agentState, agentNextAt])
  @@map("actions")
}

model Digest {
  id        String    @id @default(cuid())
  userId    String    @map("user_id")
  weekStart DateTime  @map("week_start") @db.Date
  payload   Json
  sentAt    DateTime? @map("sent_at") @db.Timestamptz(3)
  openedAt  DateTime? @map("opened_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, weekStart])
  @@index([userId])
  @@map("digests")
}

model MembershipIntent {
  id              String               @id @default(cuid())
  userId          String               @map("user_id")
  kind            MembershipIntentKind
  stripeSessionId String?              @unique @map("stripe_session_id")
  amountCents     Int?                 @map("amount_cents")
  createdAt       DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("membership_intents")
}

// The LLM's category for a merchant, so each merchant is classified once per user.
model MerchantCategory {
  id          String         @id @default(cuid())
  userId      String         @map("user_id")
  merchantKey String         @map("merchant_key")
  pfcPrimary  String         @map("pfc_primary")
  pfcDetailed String         @map("pfc_detailed")
  source      CategorySource
  createdAt   DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, merchantKey])
  @@index([userId])
  @@map("merchant_categories")
}

// Claude's answer to "is this recurring merchant a subscription?", for merchants whose
// category doesn't settle it. Asked once per merchant; the detection rules still decide
// whether there is a finding.
model SubscriptionCheck {
  id             String   @id @default(cuid())
  userId         String   @map("user_id")
  merchantKey    String   @map("merchant_key")
  isSubscription Boolean  @map("is_subscription")
  model          String
  promptVersion  String   @map("prompt_version")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, merchantKey])
  @@map("subscription_checks")
}

model Alert {
  id        String    @id @default(cuid())
  userId    String    @map("user_id")
  type      AlertType
  // Identifies the event (e.g. a transaction id), so a rescan never raises it twice.
  key       String
  title     String
  body      String
  urgent    Boolean   @default(false)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  readAt    DateTime? @map("read_at") @db.Timestamptz(3)
  emailedAt DateTime? @map("emailed_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, type, key])
  @@index([userId, createdAt])
  @@map("alerts")
}

// The merchant directory: shared knowledge about companies (names, aliases, cancel and
// support links, typical prices). Never personal data, so no user_id. Edited at
// /admin/merchants; seeded from src/config/merchant-seed.ts.
// Options Jane can compare a bill, a subscription or idle cash against (spec step 76): a
// cheaper tier of the same service, another provider's plan, or a savings account. Kept by
// the team on /admin/options with a source and the day it was checked. Not user data.
model SwitchOption {
  id                  String    @id @default(cuid())
  // plan (another provider), tier (a cheaper tier of the same service) or savings.
  kind                String
  // What it replaces: phone or internet_tv for plans (src/config/detection.ts
  // BILL_BENCHMARKS ids), savings for savings accounts.
  category            String?
  // For tiers: the merchant directory key of the service it's a tier of.
  merchantKey         String?   @map("merchant_key")
  provider            String
  name                String
  monthlyCents        Int?      @map("monthly_cents")
  // Savings: yearly rate in basis points.
  apyBps              Int?      @map("apy_bps")
  contractMonths      Int       @default(0) @map("contract_months")
  oneTimeFeeCents     Int       @default(0) @map("one_time_fee_cents")
  minimumBalanceCents Int       @default(0) @map("minimum_balance_cents")
  // One line each, in plain words: what's included and what's given up.
  includes            String?
  givesUp             String?   @map("gives_up")
  signUpUrl           String?   @map("sign_up_url")
  // Where the price comes from, and the day someone last checked it.
  sourceUrl           String    @map("source_url")
  checkedAt           DateTime  @map("checked_at") @db.Date
  // When the team confirmed it; production compares only reviewed options.
  reviewedAt          DateTime? @map("reviewed_at") @db.Timestamptz(3)
  // Example options for the demo bank, never shown in production.
  demo                Boolean   @default(false)
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([kind, category])
  @@index([merchantKey])
  @@map("switch_options")
}

model Merchant {
  id                     String    @id @default(cuid())
  // Normalized merchant key (src/data-sources/merchant.ts), lower case.
  key                    String    @unique
  name                   String
  aliases                String[]  @default([])
  // Plaid PFC detailed category, used when a transaction has none.
  category               String?
  cancelUrl              String?   @map("cancel_url")
  supportUrl             String?   @map("support_url")
  supportPhone           String?   @map("support_phone")
  // Where the action agent writes. Added by the team; never guessed.
  supportEmail           String?   @map("support_email")
  // A support address the agent found on the company's own site (spec step 64), with the
  // page it came from. The agent doesn't use it until the team confirms it.
  suggestedSupportEmail  String?   @map("suggested_support_email")
  suggestedSupportSource String?   @map("suggested_support_source")
  suggestedAt            DateTime? @map("suggested_at") @db.Timestamptz(3)
  typicalMonthlyCents    Int?      @map("typical_monthly_cents")
  // When someone on the team last checked the row; null until then.
  reviewedAt             DateTime? @map("reviewed_at") @db.Timestamptz(3)
  createdAt              DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt              DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("merchants")
}

// Ask Jane: a person's questions about their own money, and the answers they were shown.
// Deletable by the person, and removed with "Delete all my data".
model AskConversation {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  title     String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  user     User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages AskMessage[]

  @@index([userId, updatedAt])
  @@map("ask_conversations")
}

model AskMessage {
  id             String   @id @default(cuid())
  conversationId String   @map("conversation_id")
  userId         String   @map("user_id")
  // "user" or "assistant".
  role           String
  content        String
  // True when Claude's answer failed the guardrails and a fixed reply was shown instead.
  blocked        Boolean  @default(false)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user         User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversation AskConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@index([userId])
  @@map("ask_messages")
}

// Households: partners who share some accounts. Each person picks which of their own
// accounts to share; a partner can read those (and undecided findings on them), never
// change them, and never sees the other person's decisions.
model Household {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  members       HouseholdMember[]
  invites       HouseholdInvite[]
  sharedCharges SharedCharge[]
  settlements   Settlement[]

  @@map("households")
}

model HouseholdMember {
  id          String   @id @default(cuid())
  householdId String   @map("household_id")
  // One household per person.
  userId      String   @unique @map("user_id")
  joinedAt    DateTime @default(now()) @map("joined_at") @db.Timestamptz(3)

  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([householdId])
  @@map("household_members")
}

model HouseholdInvite {
  id          String    @id @default(cuid())
  householdId String    @map("household_id")
  // Who sent the invite.
  userId      String    @map("user_id")
  // Only someone signed in with this email can accept.
  email       String
  // SHA-256 of the link's token; the token itself is never stored.
  tokenHash   String    @unique @map("token_hash")
  expiresAt   DateTime  @map("expires_at") @db.Timestamptz(3)
  acceptedAt  DateTime? @map("accepted_at") @db.Timestamptz(3)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([householdId])
  @@index([userId])
  @@map("household_invites")
}

// A browser or phone that asked for notifications (Web Push). Only used when VAPID keys
// are set; urgent alerts then go here instead of email.
model PushSubscription {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  // The push service URL for this device. Works as a credential, so it's never exported.
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("push_subscriptions")
}

// Referral partners the concierge may send people to (an insurance marketplace, a savings
// account). Each covers one action type, in the states listed, and its disclosure is shown
// on the card word for word. Turning one off takes effect on the next page load.
model ReferralPartner {
  id                        String     @id @default(cuid())
  key                       String     @unique
  name                      String
  actionType                ActionType @map("action_type")
  disclosure                String
  referralUrl               String     @map("referral_url")
  // Two-letter state codes where the partner may be offered.
  allowedStates             String[]   @default([]) @map("allowed_states")
  active                    Boolean    @default(false)
  // What one conversion pays us, for revenue estimates; the real amount is recorded each time.
  revenuePerConversionCents Int?       @map("revenue_per_conversion_cents")
  createdAt                 DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                 DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  conversions ReferralConversion[]

  @@map("referral_partners")
}

// A referral that turned into revenue, entered by the team on the action page.
model ReferralConversion {
  id          String   @id @default(cuid())
  partnerId   String   @map("partner_id")
  userId      String   @map("user_id")
  actionId    String?  @map("action_id")
  amountCents Int      @map("amount_cents")
  source      String   @default("manual")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  partner ReferralPartner @relation(fields: [partnerId], references: [id], onDelete: Restrict)
  user    User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([partnerId, createdAt])
  @@index([userId])
  @@map("referral_conversions")
}

// A monthly spending limit the person set for one category (the plain category names
// insights uses, e.g. "Food and drink").
model Budget {
  id          String   @id @default(cuid())
  userId      String   @map("user_id")
  category    String
  amountCents Int      @map("amount_cents")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, category])
  @@map("budgets")
}

// A savings goal the person set. Progress comes from a linked account's balance, or an
// amount they update by hand.
model SavingsGoal {
  id               String   @id @default(cuid())
  userId           String   @map("user_id")
  name             String
  targetCents      Int      @map("target_cents")
  targetDate       DateTime @map("target_date") @db.Date
  // A savings account whose balance is the progress; null to track by hand.
  accountId        String?  @map("account_id")
  manualSavedCents Int?     @map("manual_saved_cents")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("savings_goals")
}

// One account's balance on one day, taken by the daily job, for net worth over time.
// Kept for SNAPSHOT_RETENTION_DAYS; removed with the account.
model BalanceSnapshot {
  id           String   @id @default(cuid())
  userId       String   @map("user_id")
  accountId    String   @map("account_id")
  date         DateTime @db.Date
  balanceCents Int      @map("balance_cents")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([accountId, date])
  @@index([userId, date])
  @@map("balance_snapshots")
}

// Slow work done outside the request (writing explanations), retried with backoff when it
// fails. Not user data: payloads hold ids only. See src/lib/jobs.ts and /admin/jobs.
model Job {
  id          String   @id @default(cuid())
  kind        String
  payload     Json     @default("{}")
  // queued, running, done or failed.
  status      String   @default("queued")
  attempts    Int      @default(0)
  maxAttempts Int      @default(5) @map("max_attempts")
  runAt       DateTime @default(now()) @map("run_at") @db.Timestamptz(3)
  // The last error, scrubbed of personal data.
  lastError   String?  @map("last_error")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([status, runAt])
  @@map("jobs")
}

// How actions at one merchant tend to go, aggregated from finished actions by the daily
// job (src/lib/merchant-outcomes.ts). Counts only: no user ids, no action ids.
model MerchantOutcome {
  id            String     @id @default(cuid())
  merchantKey   String     @map("merchant_key")
  actionType    ActionType @map("action_type")
  cases         Int
  succeeded     Int
  medianMinutes Int?       @map("median_minutes")
  updatedAt     DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([merchantKey, actionType])
  @@map("merchant_outcomes")
}

// Team-written replies for common updates to a person (what they need to do next).
// Team content, not user data.
model SavedReply {
  id        String   @id @default(cuid())
  title     String
  body      String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("saved_replies")
}

// Each run of a scheduled job, for /admin/health. No user data.
model CronRun {
  id         String    @id @default(cuid())
  name       String
  startedAt  DateTime  @default(now()) @map("started_at") @db.Timestamptz(3)
  finishedAt DateTime? @map("finished_at") @db.Timestamptz(3)
  ok         Boolean?
  // Counts the job returned, or the scrubbed error.
  summary    Json?
  error      String?

  @@index([name, startedAt])
  @@map("cron_runs")
}

// Problems already emailed to the team, so each outage is reported once. Removed when
// the job runs again.
model HealthNotice {
  key        String   @id
  reportedAt DateTime @default(now()) @map("reported_at") @db.Timestamptz(3)

  @@map("health_notices")
}

// The monthly check-in for one person and month: its summary (Claude's, or the
// template's), kept so it's written once, and when it was emailed.
model CheckIn {
  id        String    @id @default(cuid())
  userId    String    @map("user_id")
  // YYYY-MM.
  month     String
  summary   String
  // "llm" or "template".
  source    String
  emailedAt DateTime? @map("emailed_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  account   Account? @relation(fields: [accountId], references: [id])
  accountId String?

  @@unique([userId, month])
  @@map("check_ins")
}

// A charge on a shared account that two partners split. The payer is the account's owner;
// the other person owes partnerShareBps of the amount. Ends with the household.
model SharedCharge {
  id              String   @id @default(cuid())
  householdId     String   @map("household_id")
  transactionId   String   @unique @map("transaction_id")
  payerId         String   @map("payer_id")
  amountCents     Int      @map("amount_cents")
  // The other person's share, in basis points (5000 = half).
  partnerShareBps Int      @map("partner_share_bps")
  // Who marked it shared.
  userId          String   @map("user_id")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)

  @@index([householdId])
  @@map("shared_charges")
}

// "Settle up": one partner paid the other back.
model Settlement {
  id          String   @id @default(cuid())
  householdId String   @map("household_id")
  fromUserId  String   @map("from_user_id")
  toUserId    String   @map("to_user_id")
  amountCents Int      @map("amount_cents")
  // Who recorded it.
  userId      String   @map("user_id")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)

  @@index([householdId])
  @@map("settlements")
}

// Invite codes keep the beta closed: signing up needs a code with uses left.
model InviteCode {
  id        String    @id @default(cuid())
  code      String    @unique
  maxUses   Int       @map("max_uses")
  uses      Int       @default(0)
  // What the code is for, e.g. "Friends of Sam". Team-only.
  note      String?
  expiresAt DateTime? @map("expires_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  access BetaAccess[]

  @@map("invite_codes")
}

// Emails allowed to create an account, each from a redeemed invite code.
model BetaAccess {
  id           String   @id @default(cuid())
  email        String   @unique
  inviteCodeId String   @map("invite_code_id")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  inviteCode InviteCode @relation(fields: [inviteCodeId], references: [id], onDelete: Cascade)

  @@map("beta_access")
}

// Fixed-window request counters for rate limiting (src/lib/rate-limit.ts). Keys hold a
// route name plus a user id or a hashed IP, never raw personal data.
model RateLimit {
  key         String
  windowStart DateTime @map("window_start") @db.Timestamptz(3)
  count       Int      @default(0)

  @@id([key, windowStart])
  @@index([windowStart])
  @@map("rate_limits")
}

// Server errors, scrubbed of personal data and secrets before they're stored
// (src/lib/error-log.ts). No user id, so the log holds nothing personal.
model ErrorEvent {
  id        String   @id @default(cuid())
  message   String
  stack     String?
  // Path without the query string, e.g. /api/plaid/exchange.
  path      String?
  method    String?
  // Next.js context: "route", "render", "action" or "proxy".
  routeType String?  @map("route_type")
  digest    String?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([createdAt])
  @@map("error_events")
}

// Deliberately no foreign keys: the log must outlive the users and rows it describes,
// including the record of a user deleting their data.
model AuditLog {
  id         String    @id @default(cuid())
  // Null for system events.
  actorId    String?   @map("actor_id")
  actorType  ActorType @map("actor_type")
  event      String
  targetType String?   @map("target_type")
  targetId   String?   @map("target_id")
  metadata   Json      @default("{}")
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([actorId])
  @@index([targetType, targetId])
  @@index([event, createdAt])
  @@map("audit_log")
}

model AnalyticsEvent {
  id         String   @id @default(cuid())
  // Null for visitors who have not signed up; their anonymous_id is in properties.
  userId     String?  @map("user_id")
  name       String
  properties Json     @default("{}")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([name, createdAt])
  @@map("analytics_events")
}

// Two-factor backup codes: each works once, in place of an authenticator code. Only a
// SHA-256 hash is kept; the codes are shown once when made.
model MfaBackupCode {
  id        String    @id @default(cuid())
  userId    String    @map("user_id")
  codeHash  String    @map("code_hash")
  usedAt    DateTime? @map("used_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, codeHash])
  @@map("mfa_backup_codes")
}

// Standing rules (spec step 50): things the person pre-approved, so Jane's plan items that
// match are approved without asking. One row per rule the person has set.
model StandingRule {
  id             String   @id @default(cuid())
  userId         String   @map("user_id")
  // A key from src/config/rules.ts.
  key            String
  enabled        Boolean  @default(true)
  // Approvals this rule may make in a calendar month.
  monthlyLimit   Int      @map("monthly_limit")
  // For rules with an amount: only findings worth this much a year or less.
  maxAnnualCents Int?     @map("max_annual_cents")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, key])
  @@map("standing_rules")
}

// Every email the action agent sent or received for an action: its timeline. Owned by the
// person the action is for.
model AgentMessage {
  id          String         @id @default(cuid())
  actionId    String         @map("action_id")
  userId      String         @map("user_id")
  direction   AgentDirection
  toAddress   String         @map("to_address")
  fromAddress String         @map("from_address")
  subject     String
  body        String
  // For a reply: how the agent read it (src/lib/agent/read-reply.ts).
  outcome     String?
  summary     String?
  createdAt   DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)

  action Action @relation(fields: [actionId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([actionId, createdAt])
  @@index([userId])
  @@map("agent_messages")
}

// Set-up Jane proposes from the person's own numbers (spec step 55): a budget, an
// emergency-fund goal, a category for a merchant. Nothing is created until they say yes;
// a no is kept so the same proposal doesn't come back.
model PlanProposal {
  id         String         @id @default(cuid())
  userId     String         @map("user_id")
  // e.g. "budget:Food and drink", "goal:emergency_fund", "category:canva".
  key        String
  kind       String
  payload    Json
  status     ProposalStatus @default(open)
  createdAt  DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  answeredAt DateTime?      @map("answered_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, key])
  @@map("plan_proposals")
}

// One-tap approval links in the weekly email and notifications (spec step 60): "Go ahead
// with this week's plan" for no-risk items, without signing in. Only a hash of the token
// is kept; a link works once, for a week, for that person and those items.
model PlanLink {
  id          String    @id @default(cuid())
  userId      String    @map("user_id")
  tokenHash   String    @unique @map("token_hash")
  // The items as they were when the link was made: [{ findingId, cardHash, title }].
  items       Json
  // What the link approved, so "Take it back" can undo exactly that.
  decisionIds String[]  @default([]) @map("decision_ids")
  expiresAt   DateTime  @map("expires_at") @db.Timestamptz(3)
  usedAt      DateTime? @map("used_at") @db.Timestamptz(3)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("plan_links")
}

// Insurance policies, warranties and receipts the person uploaded (spec step 68). The file
// is AES-256-GCM encrypted (src/lib/crypto.ts); the key facts are read by Claude or typed
// by the person, and they can always correct them.
model Document {
  taxNotice           TaxNotice?
  priorReturn         PriorReturn?
  draftReturn         DraftReturn?
  id                  String       @id @default(cuid())
  userId              String       @map("user_id")
  // insurance_policy, warranty, receipt or other (src/config/documents.ts).
  kind                String
  fileName            String       @map("file_name")
  // One of the allowed types, checked against the file's first bytes.
  contentType         String       @map("content_type")
  sizeBytes           Int          @map("size_bytes")
  // "v1" + iv + auth tag + ciphertext; never the plain file.
  encryptedBytes      Bytes        @map("encrypted_bytes")
  provider            String?
  // Policies only: auto, home, renters, life, health or other.
  policyType          String?      @map("policy_type")
  // One line, checked by the guardrails before it's shown.
  coverageSummary     String?      @map("coverage_summary")
  premiumCents        Int?         @map("premium_cents")
  // monthly, quarterly, every 6 months or yearly.
  premiumFrequency    String?      @map("premium_frequency")
  renewalDate         DateTime?    @map("renewal_date") @db.Date
  warrantyEndsOn      DateTime?    @map("warranty_ends_on") @db.Date
  purchaseDate        DateTime?    @map("purchase_date") @db.Date
  purchaseAmountCents Int?         @map("purchase_amount_cents")
  // Who wrote the facts: claude, you (the person) or none yet.
  extractionSource    String       @default("none") @map("extraction_source")
  uploadedAt          DateTime     @default(now()) @map("uploaded_at") @db.Timestamptz(3)
  updatedAt           DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  user              User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  insurancePolicies InsurancePolicy[]
  policyReading     PolicyReading?

  @@index([userId, uploadedAt])
  @@map("documents")
}

// One insurance policy on the person's profile (spec step 102): typed, read from a policy
// document, found from payments (step 99) or bound by Jane (step 105). Kinds, sources,
// statuses and the cover fields are in src/config/insurance.ts.
model InsurancePolicy {
  id                  String    @id @default(cuid())
  userId              String    @map("user_id")
  kind                String
  carrier             String
  // active, found (not confirmed yet), pending, cancelled or removed.
  status              String    @default("active")
  source              String
  premiumCents        Int?      @map("premium_cents")
  // monthly, quarterly, semiannual or yearly (PREMIUM_FREQUENCIES in src/config/documents.ts).
  premiumFrequency    String?   @map("premium_frequency")
  deductibleCents     Int?      @map("deductible_cents")
  // The cover limits by key (COVERAGE_FIELDS): cents, true/false, years or a percent.
  coverage            Json      @default("{}")
  // What's covered, in one line; checked by the guardrails before it's shown.
  covers              String?
  renewalDate         DateTime? @map("renewal_date") @db.Date
  // How long one term runs, in months (6 or 12).
  termMonths          Int       @default(12) @map("term_months")
  // The policy document it was read from, if any.
  documentId          String?   @unique @map("document_id")
  // The insurer's payments in the person's transactions (normalizeMerchant key), if known.
  merchantKey         String?   @map("merchant_key")
  // Spec step 198: shown (read-only) to the people in their household when on; and who else
  // the policy covers: [{ name, relation, driver, age }], besides the policy holder.
  sharedWithHousehold Boolean   @default(false) @map("shared_with_household")
  covered             Json      @default("[]")
  // Spec step 105, for a policy Jane bound: its number at the carrier, the day it starts,
  // the policy it replaces and the switch action.
  policyNumber        String?   @map("policy_number")
  startsOn            DateTime? @map("starts_on") @db.Date
  replacesPolicyId    String?   @map("replaces_policy_id")
  actionId            String?   @map("action_id")
  cancelledAt         DateTime? @map("cancelled_at") @db.Timestamptz(3)
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  user     User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  document Document?        @relation(fields: [documentId], references: [id], onDelete: SetNull)
  quotes   InsuranceQuote[]
  shops    InsuranceShop[]
  claims   InsuranceClaim[]

  @@index([userId, status])
  @@map("insurance_policies")
}

// A quote for one of the person's policies from the insurance partner (spec step 103),
// compared like for like. The newest request's quotes replace the last ones; a quote is
// only good until it expires.
model InsuranceQuote {
  id                 String   @id @default(cuid())
  userId             String   @map("user_id")
  policyId           String   @map("policy_id")
  // Which partner answered ("demo" for the stand-in) and its id for the quote.
  partner            String
  partnerQuoteId     String   @map("partner_quote_id")
  carrierId          String   @map("carrier_id")
  carrierName        String   @map("carrier_name")
  rating             String
  ratingScore        Int      @map("rating_score")
  claimsPhone        String   @map("claims_phone")
  claimsUrl          String   @map("claims_url")
  kind               String
  premiumCents       Int      @map("premium_cents")
  premiumFrequency   String   @map("premium_frequency")
  annualPremiumCents Int      @map("annual_premium_cents")
  termMonths         Int      @map("term_months")
  deductibleCents    Int?     @map("deductible_cents")
  coverage           Json     @default("{}")
  // Spec step 149: a health plan's name, and what it would cost in a year with the person's
  // usual care (premium plus expected out of pocket).
  plan               String?
  expectedCostCents  Int?     @map("expected_cost_cents")
  // Like for like with the policy: the same cover, or what's different.
  sameCover          Boolean  @map("same_cover")
  differences        String[] @default([])
  demo               Boolean
  expiresAt          DateTime @map("expires_at") @db.Timestamptz(3)
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user   User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  policy InsurancePolicy @relation(fields: [policyId], references: [id], onDelete: Cascade)

  @@index([userId, policyId])
  @@map("insurance_quotes")
}

// One reshop of a policy (spec step 104): Jane asked the partner for quotes by herself (45
// days before renewal, or after a price rise) or because the person asked, and either found
// a better policy for the same cover (open, waiting for a tap) or didn't (no_better).
model InsuranceShop {
  id                 String    @id @default(cuid())
  userId             String    @map("user_id")
  policyId           String    @map("policy_id")
  // Never two for the same reason: "renewal:<policy>:<date>", "price:<policy>:<cents>",
  // "asked:<policy>:<time>".
  key                String
  // renewal, price_up or asked.
  reason             String
  // What the policy cost a year when Jane shopped it.
  currentAnnualCents Int       @map("current_annual_cents")
  // open, no_better, accepted, declined or expired.
  status             String
  // Jane's pick and the runners-up, as quoted (the quotes table is replaced by the next
  // request, and the pick must stay what the person said yes to).
  pick               Json?
  runnersUp          Json      @default("[]") @map("runners_up")
  savingCents        Int?      @map("saving_cents")
  why                String[]  @default([])
  quoteCount         Int       @map("quote_count")
  demo               Boolean
  // When the pick's quote expires.
  expiresAt          DateTime? @map("expires_at") @db.Timestamptz(3)
  answeredAt         DateTime? @map("answered_at") @db.Timestamptz(3)
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user   User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  policy InsurancePolicy @relation(fields: [policyId], references: [id], onDelete: Cascade)

  @@unique([userId, key])
  @@index([userId, status])
  @@map("insurance_shops")
}

// A coverage checkup (spec step 106): Jane's recommendations on the person's cover (demo
// advice), each with its cost and the risk it changes, run once a year by itself, after a
// life event, or when asked.
model InsuranceCheckup {
  id              String    @id @default(cuid())
  userId          String    @map("user_id")
  // yearly, life_event or asked.
  reason          String
  // The life event that started it (life_events.id), if any.
  lifeEventId     String?   @map("life_event_id")
  // Recommendation[] (src/lib/insurance/checkup.ts), as shown.
  recommendations Json      @default("[]")
  // When the person said "Got it" in the chat or opened the page.
  seenAt          DateTime? @map("seen_at") @db.Timestamptz(3)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("insurance_checkups")
}

// A claim the person is making (spec step 107), with its steps (CLAIM_GUIDES in
// src/config/claims.ts) as they were when it started. A step is only ever marked done,
// never removed, so the tracker never loses one.
model InsuranceClaim {
  id            String    @id @default(cuid())
  userId        String    @map("user_id")
  policyId      String?   @map("policy_id")
  // The kind of policy (POLICY_KINDS) and what happened (the guide's event key).
  kind          String
  event         String
  happenedOn    DateTime  @map("happened_on") @db.Date
  // open or closed.
  status        String    @default("open")
  // [{ key, label, dueOn: YYYY-MM-DD, doneAt: ISO time or null }].
  steps         Json      @default("[]")
  carrier       String?
  // The insurer's claims line and page, from the partner's catalog when known.
  claimsPhone   String?   @map("claims_phone")
  claimsUrl     String?   @map("claims_url")
  claimNumber   String?   @map("claim_number")
  // Spec step 155: a small claim filed by Jane through the insurance partner, after the
  // person reviewed it: what they claim and why, and the carrier's status as it moves.
  amountCents   Int?      @map("amount_cents")
  description   String?
  // draft (written, waiting for the person's review) or filed.
  filing        String?
  filedAt       DateTime? @map("filed_at") @db.Timestamptz(3)
  // received, reviewing, approved, paid or denied.
  carrierStatus String?   @map("carrier_status")
  payoutCents   Int?      @map("payout_cents")
  closedAt      DateTime? @map("closed_at") @db.Timestamptz(3)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  policy         InsurancePolicy? @relation(fields: [policyId], references: [id], onDelete: SetNull)
  // Spec step 270: the disaster loss kept with this claim.
  disasterLosses DisasterLoss[]

  @@index([userId, status])
  @@map("insurance_claims")
}

// A loss from a declared disaster, kept with its insurance claim (spec step 270): what the
// repairs cost, what insurance paid back, and the part that is deductible, for one disaster and
// one claim. The key ("<relief id>:<claim id or none>") is unique per person, so the same loss
// is never recorded, or counted, twice.
model DisasterLoss {
  id              String   @id @default(cuid())
  userId          String   @map("user_id")
  key             String
  reliefId        String   @map("relief_id")
  claimId         String?  @map("claim_id")
  taxYear         Int      @map("tax_year")
  lossCents       Int      @map("loss_cents")
  reimbursedCents Int      @map("reimbursed_cents")
  deductibleCents Int      @map("deductible_cents")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user  User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  claim InsuranceClaim? @relation(fields: [claimId], references: [id], onDelete: SetNull)

  @@unique([userId, key])
  @@map("disaster_losses")
}

// A benefit through work (spec step 150), found from a pay-stub deduction (or answered in
// the guided flow). It only counts once the person confirms it; a confirmed insurance
// benefit becomes a policy on the profile (policyId).
model EmployerBenefit {
  id           String   @id @default(cuid())
  userId       String   @map("user_id")
  employer     String
  // health, dental, vision, life, disability, hsa or fsa (src/config/benefits.ts).
  kind         String
  // The deduction's label on the pay stub, or what the guided flow asked.
  label        String
  // What comes out of each paycheck (0 when the employer pays for it).
  perPayCents  Int      @map("per_pay_cents")
  // weekly, biweekly, semimonthly or monthly.
  payFrequency String   @map("pay_frequency")
  // Pay stub or guided answer: what the cover is worth (life: a multiple of pay).
  details      Json     @default("{}")
  // found, confirmed or declined.
  status       String   @default("found")
  // Where it came from: paystub or asked.
  source       String
  policyId     String?  @map("policy_id")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, employer, kind, label])
  @@index([userId, status])
  @@map("employer_benefits")
}

// A policy document read for the person to confirm (spec step 151): the fields Jane read
// from it (or prefilled from payments without a key), each with where it came from.
// Nothing becomes a policy until they tap Confirm.
model PolicyReading {
  id         String    @id @default(cuid())
  userId     String    @map("user_id")
  documentId String    @unique @map("document_id")
  // The policy on file it updates (a renewal notice), or null for a new one.
  policyId   String?   @map("policy_id")
  // The policy form's fields, as text (PolicyInput in src/lib/insurance/policies.ts).
  fields     Json
  // Field name to where it came from: document, you, payments or policy.
  sources    Json      @default("{}")
  // Field name to what the rules said about it (left blank, or worth a look).
  notes      Json      @default("{}")
  // waiting, confirmed or dismissed.
  status     String    @default("waiting")
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  answeredAt DateTime? @map("answered_at") @db.Timestamptz(3)

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@map("policy_readings")
}

// Life insurance, sized and applied for (spec step 153). Demo advice only. The amount and
// term with the method behind them, the term quotes, the health answers, and the
// carrier's decision. Nothing is applied for, and nothing bought, without the person's tap.
model LifeApplication {
  id          String    @id @default(cuid())
  userId      String    @map("user_id")
  // sized, asking, offered, referred, bought or dismissed.
  status      String    @default("sized")
  amountCents Int       @map("amount_cents")
  termYears   Int       @map("term_years")
  // The method, line by line (src/lib/insurance/life-need.ts), and why the term.
  method      Json
  termWhy     String    @map("term_why")
  // The partner's term quotes, cheapest first.
  quotes      Json      @default("[]")
  // The quote applied for, and the health answers so far.
  quoteId     String?   @map("quote_id")
  answers     Json      @default("{}")
  // The carrier's decision: an offer at a rate class, or a referral for its own review.
  decision    Json?
  policyId    String?   @map("policy_id")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  submittedAt DateTime? @map("submitted_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@map("life_applications")
}

// Cover changes after a life event (spec step 154): a car bought, a move, a new baby, a
// marriage or a new job, and the changes Jane prepares for it (add the car, move the
// renters policy, add a dependant, review life cover), asked about once.
model CoverChange {
  id              String    @id @default(cuid())
  userId          String    @map("user_id")
  // car_bought, moving, new_baby, married or new_job.
  event           String
  // What the event is: a life event, an owned car, a car loan, or "told:<date>".
  eventKey        String    @map("event_key")
  // address, add_vehicle, add_spouse, add_dependant, review_life, review_benefits or get_auto.
  change          String
  policyId        String?   @map("policy_id")
  // What the change needs, like the car's name.
  detail          Json      @default("{}")
  // prepared, done or dismissed.
  status          String    @default("prepared")
  // The price after the change, and the carrier's confirmation, through the partner.
  newPremiumCents Int?      @map("new_premium_cents")
  confirmation    String?
  // Who made it: the person's tap, or Jane on her own (address only, at "handle everything").
  doneBy          String?   @map("done_by")
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  doneAt          DateTime? @map("done_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, event, eventKey, change, policyId])
  @@index([userId, status])
  @@map("cover_changes")
}

// Renewal negotiation (spec step 155): before a renewal with a price rise, Jane asks the
// carrier for a better rate through the insurance partner (step 54's call flow), with the
// reshop running alongside. Within the person's autopilot limits, or on their tap.
model RenewalNegotiation {
  id                   String    @id @default(cuid())
  userId               String    @map("user_id")
  policyId             String    @map("policy_id")
  // Stops the same rise being negotiated twice.
  key                  String
  currentAnnualCents   Int       @map("current_annual_cents")
  renewalAnnualCents   Int       @map("renewal_annual_cents")
  // The best like-for-like quote from the reshop, used as leverage.
  competingAnnualCents Int?      @map("competing_annual_cents")
  // asked, lowered, kept or declined.
  status               String    @default("asked")
  resultAnnualCents    Int?      @map("result_annual_cents")
  // What was said, line by line, and anything the carrier offered that changes the cover
  // (never accepted on the call).
  transcript           Json      @default("[]")
  offer                String?
  // Who started the call: the person's tap, or Jane within their autopilot limits.
  calledBy             String?   @map("called_by")
  createdAt            DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  calledAt             DateTime? @map("called_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, key])
  @@index([userId, status])
  @@map("renewal_negotiations")
}

// A cheaper way to pay for the same cover (spec step 196): pay in full, autopay, paperless,
// bundling, a safe-driver program, or a higher deductible. Found by rules from the policy
// and the person's cash, applied through the insurance partner on their tap.
model InsuranceSaving {
  id                 String    @id @default(cuid())
  userId             String    @map("user_id")
  policyId           String    @map("policy_id")
  // pay_in_full, autopay, paperless, bundle, telematics or higher_deductible.
  kind               String
  // offered, applied or dismissed. Applied and dismissed ones are not offered again.
  status             String    @default("offered")
  yearlySavingCents  Int       @map("yearly_saving_cents")
  currentYearlyCents Int       @map("current_yearly_cents")
  newYearlyCents     Int       @map("new_yearly_cents")
  // What changes, in the rules' own fields (the new deductible, the other policy bundled...).
  detail             Json      @default("{}")
  confirmation       String?
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  answeredAt         DateTime? @map("answered_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, policyId, kind])
  @@index([userId, status])
  @@map("insurance_savings")
}

// A risk Jane saw in how the person lives (spec step 197): rideshare or delivery income, a
// home business, a new dog, an expensive ring or camera, a boat, renting the home out. One
// question per kind, asked once: yes opens a gap (or adds the pet), a no is remembered.
model InsuranceRisk {
  id          String    @id @default(cuid())
  userId      String    @map("user_id")
  // rideshare, home_business, new_dog, valuable, boat or rental_out (RISK_KINDS).
  kind        String
  // asked, yes or no.
  status      String    @default("asked")
  // What was seen: the merchant, the amount and the day.
  merchant    String
  amountCents Int       @map("amount_cents")
  seenOn      DateTime  @map("seen_on") @db.Date
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  answeredAt  DateTime? @map("answered_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, kind])
  @@index([userId, status])
  @@map("insurance_risks")
}

// The household facts that matter for cover (spec step 102), as the person typed them.
// Null means not said: housing and cars are then read from the accounts.
model InsuranceProfile {
  userId        String   @id @map("user_id")
  // own, rent or other.
  housing       String?
  vehicles      Int?
  dependants    Int?
  pets          Int?
  // Gaps the person said they don't need (GAP_KEYS), never brought up again.
  dismissedGaps String[] @default([]) @map("dismissed_gaps")
  // Spec step 198: the people in the household besides the person: [{ name, relation, driver,
  // age }], so cover can be matched to each of them.
  people        Json     @default("[]")
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("insurance_profiles")
}

// What kind of hand-entered deadline it is (spec step 71).
enum DeadlineKind {
  fsa
  card_benefit
  warranty
  other

  @@map("deadline_kind")
}

// Deadlines the person typed in themselves (spec step 71): an FSA deadline, a card benefit
// to use ("my $200 travel credit by Dec 31"), a warranty, anything else. Shown on
// /deadlines with the ones Jane works out from transactions, and reminded about.
model Deadline {
  id        String       @id @default(cuid())
  userId    String       @map("user_id")
  title     String
  dueOn     DateTime     @map("due_on") @db.Date
  kind      DeadlineKind @default(other)
  note      String?
  doneAt    DateTime?    @map("done_at") @db.Timestamptz(3)
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, dueOn])
  @@map("deadlines")
}

// A life-event checklist (spec step 72): moving, a new job or a new baby. The items live in
// src/config/life-events.ts; this row keeps which ones the person has ticked.
model LifeEvent {
  id           String    @id @default(cuid())
  userId       String    @map("user_id")
  // moving, new_job or new_baby (LIFE_EVENT_KINDS).
  kind         String
  startedOn    DateTime  @map("started_on") @db.Date
  // Keys of the items ticked so far.
  checkedItems String[]  @default([]) @map("checked_items")
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  completedAt  DateTime? @map("completed_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("life_events")
}

// Jane's chat (spec step 81): every message Jane posts, and later (step 84) what the person
// types and Jane's answer. Posted by Jane's brain (spec step 82, src/lib/jane-agent).
model JaneMessage {
  id           String    @id @default(cuid())
  userId       String    @map("user_id")
  // brief, decision, done, heads_up, reply (Jane's answer) or user (what the person typed).
  kind         String
  // Fixed wording from a template, never Claude's text unless it passed the guardrails.
  body         String
  // What it's about: { findingId, actionId, decisionId, alertId, ... }.
  refs         Json      @default("{}")
  // The buttons: [{ id, label, kind: "primary" | "secondary" | "link", href? }]. Each id is
  // one of the button actions in src/lib/jane-agent/actions.
  actions      Json      @default("[]")
  // open, answered or dismissed.
  status       String    @default("open")
  // The button's label the person tapped.
  answeredWith String?   @map("answered_with")
  answeredAt   DateTime? @map("answered_at") @db.Timestamptz(3)
  // The same suggestion is never posted twice (finding:<id>, brief:<date>, ...).
  dedupeKey    String    @map("dedupe_key")
  // Higher is more important; the brain posts the most important first.
  priority     Int       @default(0)
  readAt       DateTime? @map("read_at") @db.Timestamptz(3)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  // When it went out as a notification (spec step 85), so it never goes twice, and how:
  // push, email, both, or skipped (it had gone out already as an alert).
  notifiedAt   DateTime? @map("notified_at") @db.Timestamptz(3)
  notifiedVia  String?   @map("notified_via")
  // "Not now" (spec step 83): hidden from the chat until then, when Jane may bring it up again.
  snoozedUntil DateTime? @map("snoozed_until") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, dedupeKey])
  @@index([userId, createdAt])
  @@map("jane_messages")
}

// Spec step 91: what Jane remembers about the person, saved only after their own tap. kind
// "never": a suggestion they said not to make again (key: what it was about); "fact":
// something they told her in the chat ("payday is the 15th", "I need my car"). The brain,
// the chat and every sector read them (src/lib/jane-agent/preferences.ts); Settings lists
// them, each deletable. In Download my data, deleted with the account.
model JanePreference {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  kind      String
  key       String
  // What the fact says, for the code that reads it ({ days: [15] }, { target: "car" }).
  value     Json     @default("{}")
  // How Settings and the chat say it: "Payday is the 15th".
  label     String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, kind, key])
  @@map("jane_preferences")
}

// One-tap answers from Jane's emails (spec step 85): one per button on one message. The
// link opens a confirm page with one button, so mail scanners can't answer anything. Only
// the SHA-256 of the token is kept; it works once, until expiresAt, for that person's own
// message and that button, through the same checks as the chat.
model ChatReplyLink {
  id        String    @id @default(cuid())
  userId    String    @map("user_id")
  messageId String    @map("message_id")
  actionId  String    @map("action_id")
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([messageId])
  @@map("chat_reply_links")
}

// The tax profile (spec step 118): what Jane needs to know for the person's taxes. Every
// value here is the person's own answer (picked, typed or a yes to what Jane found);
// `answered` lists which fields they've answered, so nothing is assumed silently.
model TaxProfile {
  id                    String    @id @default(cuid())
  userId                String    @unique @map("user_id")
  // single, married_joint, married_separate or head_of_household (src/config/tax.ts).
  filingStatus          String?   @map("filing_status")
  childrenUnder17       Int?      @map("children_under_17")
  otherDependants       Int?      @map("other_dependants")
  // Two-letter US state they file in.
  state                 String?
  // Kinds of income (src/config/tax.ts INCOME_KINDS).
  incomeKinds           String[]  @default([]) @map("income_kinds")
  // incomeKinds, filingStatus, dependants, state: the fields the person has answered.
  answered              String[]  @default([])
  // Spec step 120: from the person's latest pay stub, year to date, when there's no payroll
  // connection: as of that date, gross pay, federal and state tax withheld, pre-tax
  // retirement (401(k)) and other pre-tax deductions (health, HSA, FSA).
  payAsOf               DateTime? @map("pay_as_of") @db.Date
  payGrossYtdCents      Int?      @map("pay_gross_ytd_cents")
  payFederalYtdCents    Int?      @map("pay_federal_ytd_cents")
  payStateYtdCents      Int?      @map("pay_state_ytd_cents")
  payRetirementYtdCents Int?      @map("pay_retirement_ytd_cents")
  payPretaxYtdCents     Int?      @map("pay_pretax_ytd_cents")
  // Spec step 121: a W-4 change the person said they sent (step "4b" deductions, a yearly
  // amount, or "4c" extra withholding per paycheck), from when, for which tax year; and the
  // year they said they'd rather keep their refund, so Jane doesn't ask again that year.
  w4Step                String?   @map("w4_step")
  w4AmountCents         Int?      @map("w4_amount_cents")
  w4ChangedOn           DateTime? @map("w4_changed_on") @db.Date
  w4Year                Int?      @map("w4_year")
  keepRefundYear        Int?      @map("keep_refund_year")
  // Spec step 122: ways to pay less the person said no to, as "<year>:<key>".
  savingsDismissed      String[]  @default([]) @map("savings_dismissed")
  // Spec step 123: the self-employed helpers. Home office square feet (simplified method),
  // business miles driven so far in businessMilesYear, and estimated tax payments the person
  // made from accounts Jane can't see: [{ date, cents, to: "federal" | "state" }].
  homeOfficeSqFt        Int?      @map("home_office_sq_ft")
  businessMiles         Int?      @map("business_miles")
  businessMilesYear     Int?      @map("business_miles_year")
  taxPayments           Json      @default("[]") @map("tax_payments")
  // Spec step 125: refunds (transaction ids) whose plan the person set up, or said no to.
  refundsHandled        String[]  @default([]) @map("refunds_handled")
  // Spec step 165: moves in residencyYear ([{ date, from, to }]), the employer's state for
  // someone working remotely for an employer in another state, the city or county income
  // tax they live under (a LOCAL_TAXES key, or "none"), and the year the person told Jane
  // where they lived (so she stops asking that year).
  moves                 Json      @default("[]")
  workState             String?   @map("work_state")
  locality              String?
  residencyYear         Int?      @map("residency_year")
  // Spec step 166: the day Jane last asked the document partner for forms.
  documentsCheckedOn    DateTime? @map("documents_checked_on") @db.Date
  // Spec step 167: tax plan moves ("<year>:<key>") put on the deadlines, or said no to,
  // as "<year>:<key>:added" or "<year>:<key>:no".
  planHandled           String[]  @default([]) @map("plan_handled")
  // Spec step 168: gifts (transaction ids) the person has the charity's receipt for; the
  // year they said no to the giving options; and the donor-advised fund they opened with
  // the stand-in (no money moves through Jane).
  givingReceipts        String[]  @default([]) @map("giving_receipts")
  givingDismissedYear   Int?      @map("giving_dismissed_year")
  donorFundPartner      String?   @map("donor_fund_partner")
  donorFundName         String?   @map("donor_fund_name")
  donorFundOpenedAt     DateTime? @map("donor_fund_opened_at") @db.Timestamptz(3)
  // Spec step 169: family details for the family tax choices: each child
  // ([{ ageAtYearEnd, hasSsn, monthsLivedWithYou }]), a spouse's wages for the year, whether
  // the person pays over half the cost of their home, and a student's years of college
  // before this one and whether at least half-time.
  familyChildren        Json      @default("[]") @map("family_children")
  spouseWagesCents      Int?      @map("spouse_wages_cents")
  paysOverHalfHome      Boolean?  @map("pays_over_half_home")
  studentYearsBefore    Int?      @map("student_years_before")
  studentHalfTime       Boolean?  @map("student_half_time")
  // Spec step 170: points paid on the mortgage in pointsYear (on a purchase, or a refinance
  // spread over pointsLoanYears), and the home sale: when bought and for how much, when sold,
  // for how much, the selling costs, and the days lived in it in the 5 years before.
  pointsCents           Int?      @map("points_cents")
  pointsYear            Int?      @map("points_year")
  pointsPurchase        Boolean?  @map("points_purchase")
  pointsLoanYears       Int?      @map("points_loan_years")
  homeBoughtOn          DateTime? @map("home_bought_on") @db.Date
  homePriceCents        Int?      @map("home_price_cents")
  homeSoldOn            DateTime? @map("home_sold_on") @db.Date
  homeSaleCents         Int?      @map("home_sale_cents")
  homeSaleCostsCents    Int?      @map("home_sale_costs_cents")
  homeDaysLivedIn       Int?      @map("home_days_lived_in")
  // Spec step 171: tax years whose "records can go" reminder is on the deadlines.
  retentionReminded     String[]  @default([]) @map("retention_reminded")
  // Spec step 173: the rental property (price and when it was ready to rent), and whether
  // the side income is a "business" or a "hobby" (null: not said).
  rentalPriceCents      Int?      @map("rental_price_cents")
  rentalPlacedOn        DateTime? @map("rental_placed_on") @db.Date
  sideIncomeKind        String?   @map("side_income_kind")
  // Spec step 218: the tax year the person says they have an IP PIN for, and the year Jane
  // put the January reminder on their deadlines.
  ipPinHaveYear         Int?      @map("ip_pin_have_year")
  ipPinRemindedYear     Int?      @map("ip_pin_reminded_year")
  // Spec step 220: the year the person plans to retire (empty: Jane assumes one), and the
  // multi-year moves (keys like "roth:2027") already put on their deadlines.
  retireYear            Int?      @map("retire_year")
  multiYearHandled      String[]  @default([]) @map("multi_year_handled")
  // Spec step 221: what the person told Jane about their home and themselves, for the
  // assessment check and the exemptions (the county's own figures win over a guess).
  homeMarketCents       Int?      @map("home_market_cents")
  homeAssessedCents     Int?      @map("home_assessed_cents")
  homeAssessedYear      Int?      @map("home_assessed_year")
  homeNoticeOn          DateTime? @map("home_notice_on") @db.Date
  ownerAge              Int?      @map("owner_age")
  ownerVeteran          Boolean?  @map("owner_veteran")
  ownerDisabled         Boolean?  @map("owner_disabled")
  exemptionsClaimed     String[]  @default([]) @map("exemptions_claimed")
  // Spec step 270: the disaster postponements (relief ids) already applied to their deadlines.
  disasterApplied       String[]  @default([]) @map("disaster_applied")
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("tax_profiles")
}

// Tax tags the person chose (spec step 119): on one transaction, or on every transaction
// from one merchant. Jane's own tags come from the spending category (src/config/tax.ts
// TAX_TAGS) and aren't stored; these override them. tag is a TAX_TAGS key or "none" (not
// for taxes). Tags never change the transaction or its category.
model TaxTag {
  id            String   @id @default(cuid())
  userId        String   @map("user_id")
  transactionId String?  @map("transaction_id")
  // normalizeMerchant's key (src/data-sources/merchant.ts).
  merchantKey   String?  @map("merchant_key")
  tag           String
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  transaction Transaction? @relation(fields: [transactionId], references: [id], onDelete: Cascade)

  @@unique([userId, transactionId])
  @@unique([userId, merchantKey])
  @@index([userId])
  @@map("tax_tags")
}

// Tax forms the person said have arrived (spec step 119), for a tax year: one row per form
// Jane expected (src/planning/tax-documents.ts key), so she stops asking about it.
// Spec step 166: a tax form Jane collected from a document partner (the demo stand-in for
// now), for an expected form (TaxForm keys). Its boxes in cents; checked against the
// accounts each time it's shown, never stored as matching. decision: "right" (the person
// said a flagged form is right, so it's used) or "ask" (they'll ask the payer).
model TaxDocument {
  id        String    @id @default(cuid())
  userId    String    @map("user_id")
  year      Int
  key       String
  formKey   String    @map("form_key")
  payer     String
  partner   String
  boxes     Json
  fetchedAt DateTime  @map("fetched_at") @db.Timestamptz(3)
  decision  String?
  decidedAt DateTime? @map("decided_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, year, key])
  @@map("tax_documents")
}

model TaxForm {
  id         String   @id @default(cuid())
  userId     String   @map("user_id")
  year       Int
  key        String
  receivedAt DateTime @map("received_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, year, key])
  @@map("tax_forms")
}

// Spec step 128: a fund, share or cash position, as Plaid Investments (or the demo bank)
// describes it. Plaid's securities are shared across its customers; here each person has
// their own copy, so every row is theirs. Prices are per share, in cents.
model Security {
  id               String    @id @default(cuid())
  userId           String    @map("user_id")
  plaidSecurityId  String    @map("plaid_security_id")
  name             String
  ticker           String?
  // Plaid's type: cash, cryptocurrency, derivative, equity, etf, fixed income, loan,
  // mutual fund or other; subtype e.g. "common stock" or "mutual fund".
  type             String?
  subtype          String?
  isCashEquivalent Boolean   @default(false) @map("is_cash_equivalent")
  closePriceCents  Int?      @map("close_price_cents")
  closePriceAsOf   DateTime? @map("close_price_as_of") @db.Date
  sector           String?
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  user                   User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  holdings               Holding[]
  investmentTransactions InvestmentTransaction[]

  @@unique([userId, plaidSecurityId])
  @@index([userId])
  @@map("securities")
}

// Spec step 128: how much of one security an account holds, replaced on every sync.
// valueCents is what the institution says it's worth; costBasisCents what was paid for
// the whole position, when the institution says.
model Holding {
  id             String    @id @default(cuid())
  userId         String    @map("user_id")
  accountId      String    @map("account_id")
  securityId     String    @map("security_id")
  // Shares or units; fractional shares are common.
  quantity       Float
  priceCents     Int       @map("price_cents")
  priceAsOf      DateTime? @map("price_as_of") @db.Date
  valueCents     Int       @map("value_cents")
  costBasisCents Int?      @map("cost_basis_cents")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  account  Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  security Security @relation(fields: [securityId], references: [id], onDelete: Cascade)

  @@unique([accountId, securityId])
  @@index([userId])
  @@map("holdings")
}

// Spec step 128: buys, sells, dividends, contributions and fees in an investment account,
// from Plaid Investments (or the demo bank). Plaid's sign: positive amounts are cash out
// of the account (a buy, a fee), negative are cash in (a sale, a dividend, a contribution).
model InvestmentTransaction {
  id                           String   @id @default(cuid())
  userId                       String   @map("user_id")
  accountId                    String   @map("account_id")
  securityId                   String?  @map("security_id")
  plaidInvestmentTransactionId String   @unique @map("plaid_investment_transaction_id")
  date                         DateTime @db.Date
  name                         String
  quantity                     Float
  amountCents                  Int      @map("amount_cents")
  priceCents                   Int      @map("price_cents")
  feesCents                    Int?     @map("fees_cents")
  // Plaid's type (buy, sell, cancel, cash, fee, transfer) and subtype (e.g. dividend,
  // contribution, management fee).
  type                         String
  subtype                      String
  createdAt                    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                    DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  account  Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  security Security? @relation(fields: [securityId], references: [id], onDelete: SetNull)

  @@index([userId, date])
  @@index([accountId])
  @@map("investment_transactions")
}

// Spec step 129: what the person's investments are for, from four questions (in the chat or
// on /investments/profile). Kept as answered, one at a time; nothing uses it until all four
// are in (answeredAt). Changed any time. The values are keys in src/config/investing.ts.
model InvestorProfile {
  id           String    @id @default(cuid())
  userId       String    @unique @map("user_id")
  // Age when answered, with the day, so it can be aged.
  age          Int?
  ageOn        DateTime? @map("age_on") @db.Date
  horizon      String?
  dropReaction String?   @map("drop_reaction")
  goals        String[]  @default([])
  // When the last of the four was answered; null while any is missing.
  answeredAt   DateTime? @map("answered_at") @db.Timestamptz(3)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("investor_profiles")
}

// "That's expected" on a change Jane noticed (spec step 97): a bill that moved, a new
// subscription, a paycheck, a category's pace or a new fee. Keyed by the change's own key
// (src/insights/changes.ts), so that change is never brought up again.
model ChangeAck {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  key       String
  kind      String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, key])
  @@map("change_acks")
}

// The person's answer when Jane asked about a life event she spotted (spec step 100): yes
// (she ran the checklist), not_me (never asked about that kind again) or never (no
// life-event questions at all; kind is "all").
model LifeEventAnswer {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  kind      String
  answer    String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, kind])
  @@map("life_event_answers")
}

// A month's budget tune-up (spec step 101): the budgets Jane would change and to what.
// proposed (waiting on a tap), accepted (Accept all), auto (applied by autopilot), kept
// (Keep) or undone (Undo after autopilot). One per person per month.
model BudgetTuneUp {
  id        String    @id @default(cuid())
  userId    String    @map("user_id")
  // YYYY-MM.
  month     String
  // [{ category, fromCents, toCents }].
  changes   Json
  status    String    @default("proposed")
  decidedAt DateTime? @map("decided_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, month])
  @@map("budget_tune_ups")
}

// A transfer to savings Jane counted toward a goal tracked by hand (spec step 101), or the
// person said not to: counted (by their tap), auto (by autopilot) or skipped. Each transfer
// is counted once.
model GoalTransfer {
  id            String   @id @default(cuid())
  userId        String   @map("user_id")
  transactionId String   @map("transaction_id")
  goalId        String?  @map("goal_id")
  amountCents   Int      @map("amount_cents")
  status        String
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, transactionId])
  @@map("goal_transfers")
}

// Spec step 87: one run of Jane's answer checks (src/lib/jane-agent/checks): the team's
// own measurement of the chat over a demo-bank person, not anyone's data. Each question's
// grade and reasons are in results, so runs can be compared.
model AnswerCheckRun {
  id            String   @id @default(cuid())
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  // "rules_only" without an Anthropic key, "full" with one.
  mode          String
  // Jane's chat prompt version (src/lib/jane-agent/claude.ts) at the time.
  promptVersion String   @map("prompt_version")
  // 0–100 over the graded questions; null when none were graded.
  score         Int?
  graded        Int
  skipped       Int
  costCents     Int      @map("cost_cents")
  stoppedAtCap  Boolean  @map("stopped_at_cap")
  // Median time to Jane's first words, in milliseconds.
  firstWordsMs  Int?     @map("first_words_ms")
  results       Json

  @@index([createdAt])
  @@map("answer_check_runs")
}

// A shared "What Jane saved me" total (spec step 139): the confirmed total when it was
// shared, behind an unguessable link. Only the token's SHA-256 is kept. Nothing else about
// the person is on the shared page; revoking takes it down.
model SavedShare {
  id         String    @id @default(cuid())
  userId     String    @map("user_id")
  tokenHash  String    @unique @map("token_hash")
  totalCents Int       @map("total_cents")
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("saved_shares")
}

// Spec step 133: an order sent to the brokerage partner, with its confirmation. Until a
// real brokerage is connected the partner is a simulation (partner "simulated"): orders
// are filled at the latest price on paper, no real money moves, and every screen says so.
// One batch is one tap ("Move to the recommended mix").
model BrokerageOrder {
  id           String    @id @default(cuid())
  userId       String    @map("user_id")
  accountId    String    @map("account_id")
  batchId      String    @map("batch_id")
  // Why: rebalance (step 133) or auto_invest (step 134).
  reason       String
  partner      String
  ticker       String
  securityName String    @map("security_name")
  // buy or sell, by dollar amount.
  side         String
  amountCents  Int       @map("amount_cents")
  quantity     Float
  priceCents   Int       @map("price_cents")
  // filled or rejected, as the partner confirmed.
  status       String
  // The partner's own confirmation number.
  confirmation String?
  placedAt     DateTime  @map("placed_at") @db.Timestamptz(3)
  filledAt     DateTime? @map("filled_at") @db.Timestamptz(3)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([userId, placedAt])
  @@index([accountId])
  @@map("brokerage_orders")
}

// One autopilot, every sector (spec step 141): what the person set for one sector, over
// the defaults for their step 57 level (src/config/autopilot-sectors.ts).
model AutopilotSector {
  id              String   @id @default(cuid())
  userId          String   @map("user_id")
  // bills, insurance, debt, taxes, investing or goals (SECTORS).
  sector          String
  // ask, safe or all (SECTOR_LEVELS).
  level           String
  actionCapCents  Int      @map("action_cap_cents")
  monthlyCapCents Int      @map("monthly_cap_cents")
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, sector])
  @@map("autopilot_sectors")
}

// Something a sector did by itself (spec step 141), and the money it moved or committed,
// so the monthly caps hold. Written through src/lib/sector-autopilot.ts recordAct.
model AutopilotAct {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  sector    String
  cents     Int
  what      String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, sector, createdAt])
  @@map("autopilot_acts")
}

// A tax return filed through the filing partner (spec step 126), one per tax year. Jane
// hands over what she has (package: the profile, income, tags and forms, never account
// numbers or tokens); the partner prepares it; the person reviews it and signs; only then is
// it submitted. status: ready_for_review, submitted, accepted or rejected.
// Spec step 172: a prior-year return read from an uploaded document, for the person to
// confirm (like a policy read, step 151). fields/sources/notes are keyed by
// PRIOR_RETURN_FIELDS; nothing in it is used until status is "confirmed".
model PriorReturn {
  id          String    @id @default(cuid())
  userId      String    @map("user_id")
  documentId  String    @unique @map("document_id")
  fields      Json
  sources     Json
  notes       Json
  status      String    @default("waiting")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  confirmedAt DateTime? @map("confirmed_at") @db.Timestamptz(3)

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("prior_returns")
}

// Spec step 272: a draft return (before filing) read from an uploaded document, for the person
// to confirm, and what Jane's check of it found: [{ key, kind, title, line, draftCents,
// knownCents, effect, dollarsCents, why }]. Jane never files it.
model DraftReturn {
  id          String    @id @default(cuid())
  userId      String    @map("user_id")
  documentId  String    @unique @map("document_id")
  fields      Json
  sources     Json
  notes       Json
  status      String    @default("waiting")
  findings    Json      @default("[]")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  confirmedAt DateTime? @map("confirmed_at") @db.Timestamptz(3)

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("draft_returns")
}

// Spec step 172: an amended return (1040-X) prepared through the filing stand-in for what a
// prior-year review found. Never submitted without the person's review and signature.
model TaxAmendment {
  id              String    @id @default(cuid())
  userId          String    @map("user_id")
  year            Int
  partner         String
  partnerReturnId String    @map("partner_return_id")
  status          String
  // What changes: [{ key, title, savesCents }].
  changes         Json
  refundCents     Int       @map("refund_cents")
  signerName      String?   @map("signer_name")
  signedAt        DateTime? @map("signed_at") @db.Timestamptz(3)
  submittedAt     DateTime? @map("submitted_at") @db.Timestamptz(3)
  acceptedAt      DateTime? @map("accepted_at") @db.Timestamptz(3)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, year])
  @@map("tax_amendments")
}

// Spec step 217: a letter from the IRS or the state, read from an uploaded copy for the
// person to confirm (like a prior return, step 172). response is what they chose (agree,
// pay or dispute) with its draft; handledBy says who sends it: "team" (queued for Jane's
// team) or "you". Nothing is paid or sent without the person's tap.
model TaxNotice {
  id         String    @id @default(cuid())
  userId     String    @map("user_id")
  documentId String    @unique @map("document_id")
  fields     Json
  sources    Json
  notes      Json
  status     String    @default("waiting")
  response   String?
  draft      String?
  handledBy  String?   @map("handled_by")
  handledAt  DateTime? @map("handled_at") @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("tax_notices")
}

// Spec step 218: a sign of tax identity theft and the steps taken, in order. steps maps a
// step key (src/config/tax-identity.ts) to the day it was done. source: told (the person),
// rejected (their e-file) or notice (a letter they uploaded).
model TaxIdentityCase {
  id        String    @id @default(cuid())
  userId    String    @map("user_id")
  sign      String
  source    String
  openedOn  DateTime  @map("opened_on") @db.Date
  steps     Json      @default("{}")
  closedAt  DateTime? @map("closed_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("tax_identity_cases")
}

// Spec step 219: an equity pay event the person told Jane about, for taxes: RSUs vested,
// ESPP shares bought (and maybe sold) or ISOs exercised. Prices are per share in cents.
// kind: rsu, espp or iso (src/config/equity-tax.ts).
model EquityEvent {
  id                 String    @id @default(cuid())
  userId             String    @map("user_id")
  kind               String
  company            String
  shares             Float
  occurredOn         DateTime  @map("occurred_on") @db.Date
  grantedOn          DateTime? @map("granted_on") @db.Date
  priceCents         Int       @default(0) @map("price_cents")
  fmvCents           Int       @map("fmv_cents")
  withheldCents      Int?      @map("withheld_cents")
  soldOn             DateTime? @map("sold_on") @db.Date
  soldPriceCents     Int?      @map("sold_price_cents")
  grantDiscountCents Int?      @map("grant_discount_cents")
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("equity_events")
}

// Spec step 220: a bonus, a sale or a retirement withdrawal the person plans, so Jane can
// find the best year for it.
model TaxPlanEvent {
  id          String   @id @default(cuid())
  userId      String   @map("user_id")
  kind        String
  year        Int
  amountCents Int      @map("amount_cents")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("tax_plan_events")
}

// Spec step 221: a drafted property tax appeal. Filed by the team or the person, on their
// tap; Jane files nothing herself.
model PropertyAppeal {
  id            String    @id @default(cuid())
  userId        String    @map("user_id")
  year          Int
  assessedCents Int       @map("assessed_cents")
  marketCents   Int       @map("market_cents")
  savingCents   Int       @map("saving_cents")
  board         String
  comps         Json
  draft         String
  // "drafted", then "team" or "self" once the person says who files it, or "dropped".
  status        String    @default("drafted")
  handledAt     DateTime? @map("handled_at") @db.Timestamptz(3)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, year])
  @@map("property_appeals")
}

// Spec step 222: a read-only link for the person's accountant. Only the hash of the token is
// stored; the link expires and can be revoked, and every view is in the audit log.
model AccountantLink {
  id           String    @id @default(cuid())
  userId       String    @map("user_id")
  tokenHash    String    @unique @map("token_hash")
  // What the person calls this accountant ("Dana at Hill & Co").
  label        String
  expiresAt    DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt    DateTime? @map("revoked_at") @db.Timestamptz(3)
  viewCount    Int       @default(0) @map("view_count")
  lastViewedAt DateTime? @map("last_viewed_at") @db.Timestamptz(3)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user  User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  notes AccountantNote[]

  @@index([userId])
  @@map("accountant_links")
}

// An answer (or a note) from the accountant, which comes back into Jane.
model AccountantNote {
  id           String    @id @default(cuid())
  userId       String    @map("user_id")
  linkId       String    @map("link_id")
  // Which of Jane's questions this answers, or null for a note of their own.
  questionKey  String?   @map("question_key")
  questionText String?   @map("question_text")
  fromName     String    @map("from_name")
  body         String
  // Set when the person has seen it.
  seenAt       DateTime? @map("seen_at") @db.Timestamptz(3)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  link AccountantLink @relation(fields: [linkId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([linkId])
  @@map("accountant_notes")
}

// Spec step 223: an estimated tax payment made through the payment stand-in (src/lib/tax-
// payments), by Jane within the caps or on the person's tap. Nothing leaves any account.
model TaxPayment {
  id           String   @id @default(cuid())
  userId       String   @map("user_id")
  year         Int
  // The estimated-tax due date it pays.
  dueOn        DateTime @map("due_on") @db.Date
  cents        Int
  partner      String
  confirmation String
  // "autopilot" (within the caps) or "tap" (the person said pay it).
  via          String
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, dueOn])
  @@map("tax_payments")
}

model TaxReturn {
  id              String    @id @default(cuid())
  userId          String    @map("user_id")
  year            Int
  // Which partner: "demo" is the stand-in (src/lib/filing/demo.ts).
  partner         String
  partnerReturnId String    @map("partner_return_id")
  status          String
  package         Json
  // What the partner worked out: { federalRefundCents, stateRefundCents }.
  preview         Json
  signerName      String?   @map("signer_name")
  signedAt        DateTime? @map("signed_at") @db.Timestamptz(3)
  submittedAt     DateTime? @map("submitted_at") @db.Timestamptz(3)
  acceptedAt      DateTime? @map("accepted_at") @db.Timestamptz(3)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, year])
  @@map("tax_returns")
}

// Spec step 134: investing automatically every payday, set up once with a tap. "fixed"
// invests amountCents each payday; "leftover" invests part of what's safe to spend above
// the floor (src/config/auto-invest.ts). Paused by the person, or by Jane for a payday when
// safe to spend is low.
model AutoInvestPlan {
  id           String    @id @default(cuid())
  userId       String    @unique @map("user_id")
  mode         String
  amountCents  Int?      @map("amount_cents")
  // The investment account it goes into.
  accountId    String    @map("account_id")
  // active or paused (by the person).
  status       String    @default("active")
  // The last paycheck it ran for, so each one runs once.
  lastPaydayOn DateTime? @map("last_payday_on") @db.Date
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("auto_invest_plans")
}

// Spec step 134: every payday's outcome, invested or paused, so every contribution is
// visible.
model AutoInvestRun {
  id          String   @id @default(cuid())
  userId      String   @map("user_id")
  paydayOn    DateTime @map("payday_on") @db.Date
  // invested or paused.
  status      String
  amountCents Int      @default(0) @map("amount_cents")
  // Safe to spend when it ran.
  safeCents   Int?     @map("safe_cents")
  // The orders' batch (src/lib/brokerage/partner.ts), when invested.
  batchId     String?  @map("batch_id")
  reason      String?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, paydayOn])
  @@index([userId, createdAt])
  @@map("auto_invest_runs")
}

// Spec step 158: saving for a child's college. The child's age when the person said it (so
// it can be aged), the kind of college, the 529 plan Jane compared best, and the savings
// goal it set up, which step 157's buckets and automatic investing then fund.
model CollegePlan {
  id          String   @id @default(cuid())
  userId      String   @map("user_id")
  childName   String   @map("child_name")
  childAge    Int      @map("child_age")
  ageOn       DateTime @map("age_on") @db.Date
  // public or private (src/config/college.ts).
  collegeType String   @map("college_type")
  planKey     String?  @map("plan_key")
  goalId      String?  @map("goal_id")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("college_plans")
}

// Spec step 159: the HSA receipts vault. A medical charge Jane found in the person's
// transactions, kept so it can be paid back from the HSA tax-free later (there's no
// deadline while the HSA was open when the cost happened). Each links to its transaction.
model HsaReceipt {
  id            String    @id @default(cuid())
  userId        String    @map("user_id")
  transactionId String    @unique @map("transaction_id")
  amountCents   Int       @map("amount_cents")
  date          DateTime  @db.Date
  merchant      String
  // saved, or reimbursed once the person took the money back out.
  status        String    @default("saved")
  reimbursedAt  DateTime? @map("reimbursed_at") @db.Timestamptz(3)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  transaction Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)

  @@index([userId, date])
  @@map("hsa_receipts")
}

// Spec step 160: stock from work: RSUs still to vest, an ESPP, options. From the person's
// own answers (a guided form) or the demo stock plan. Shares already vested and held show
// up as holdings; this is what's still coming.
model EquityGrant {
  id             String    @id @default(cuid())
  userId         String    @map("user_id")
  company        String
  ticker         String?
  // rsu, espp or options (src/config/company-stock.ts).
  kind           String
  unvestedShares Float     @map("unvested_shares")
  sharesPerVest  Float?    @map("shares_per_vest")
  everyMonths    Int?      @map("every_months")
  nextVestOn     DateTime? @map("next_vest_on") @db.Date
  // Options: the price to buy each share; ESPP: the discount on the price.
  strikeCents    Int?      @map("strike_cents")
  esppDiscount   Float?    @map("espp_discount")
  // you (the form) or demo (the demo stock plan).
  source         String    @default("you")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("equity_grants")
}

// Spec step 161: crypto, read-only. An exchange account or a public wallet address, read
// through a crypto source (a stand-in until a crypto data partner is connected). Jane never
// holds keys and never trades: there is no order path for crypto. The last year's trading
// fees and amounts, for the fee flag.
model CryptoConnection {
  id           String    @id @default(cuid())
  userId       String    @map("user_id")
  // exchange or wallet (src/config/crypto.ts).
  kind         String
  name         String
  // The source behind it: demo (the stand-in) until a partner is connected.
  partner      String
  // A wallet's public address (never a key).
  address      String?
  lastSyncedAt DateTime? @map("last_synced_at") @db.Timestamptz(3)
  feesCents    Int       @default(0) @map("fees_cents")
  tradedCents  Int       @default(0) @map("traded_cents")
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user     User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  holdings CryptoHolding[]

  @@index([userId])
  @@map("crypto_connections")
}

// One asset in one connection, as the source last reported it, with when.
model CryptoHolding {
  id             String   @id @default(cuid())
  userId         String   @map("user_id")
  connectionId   String   @map("connection_id")
  asset          String
  name           String
  quantity       Float
  priceCents     Int      @map("price_cents")
  valueCents     Int      @map("value_cents")
  costBasisCents Int?     @map("cost_basis_cents")
  asOf           DateTime @map("as_of") @db.Timestamptz(3)

  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  connection CryptoConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@unique([connectionId, asset])
  @@index([userId])
  @@map("crypto_holdings")
}

// One person's nightly controller run (spec step 142): when it ran and, for each sector's
// step in order, whether it ran, what it did and how much changed. One per person per day.
model ControllerRun {
  id         String    @id @default(cuid())
  userId     String    @map("user_id")
  // The UTC day it ran for, YYYY-MM-DD.
  day        String
  startedAt  DateTime  @map("started_at") @db.Timestamptz(3)
  finishedAt DateTime? @map("finished_at") @db.Timestamptz(3)
  // [{ step, status: "ok" | "failed" | "skipped", did, changed, ms }].
  steps      Json      @default("[]")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, day])
  @@map("controller_runs")
}

// A transfer or payment through the money-movement partner (spec steps 144–145): the
// stand-in until a licensed partner is connected, which moves nothing real. Undoable while
// pending, until runOn.
model MoneyTransfer {
  id            String    @id @default(cuid())
  userId        String    @map("user_id")
  fromAccountId String    @map("from_account_id")
  // The person's own account it goes to; null for a payment to someone else (a bill).
  toAccountId   String?   @map("to_account_id")
  toName        String    @map("to_name")
  amountCents   Int       @map("amount_cents")
  // goal, debt or bill; the sector whose autopilot caps it counts against.
  purpose       String
  sector        String
  goalId        String?   @map("goal_id")
  // pending, completed, cancelled or failed.
  status        String    @default("pending")
  runOn         DateTime  @map("run_on") @db.Date
  partner       String
  partnerRef    String?   @map("partner_ref")
  // autopilot or person.
  by            String
  // What it came from: "paycheck:<transaction id>", "bill:<key>".
  planKey       String?   @map("plan_key")
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  completedAt   DateTime? @map("completed_at") @db.Timestamptz(3)
  cancelledAt   DateTime? @map("cancelled_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@map("money_transfers")
}

// A paycheck's plan (spec step 144): where each part of it goes, worked out once when the
// paycheck lands. proposed (waiting on a tap), moved, auto (autopilot moved all of it),
// partial (autopilot moved some, the rest waits) or skipped.
model PaycheckPlan {
  id            String   @id @default(cuid())
  userId        String   @map("user_id")
  // "paycheck:<transaction id>".
  key           String
  paycheckCents Int      @map("paycheck_cents")
  paidOn        DateTime @map("paid_on") @db.Date
  // [{ purpose, sector, label, goalId?, toAccountId, toName, cents, status }].
  moves         Json
  // Spec step 206: where every dollar of the paycheck went (WentTo).
  summary       Json?
  status        String   @default("proposed")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, key])
  @@map("paycheck_plans")
}

// Money health score (spec step 146): the person's score for a month, kept up to date while
// the month runs, so a later month can say how it changed. parts as computed then.
model HealthScore {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  // YYYY-MM.
  month     String
  score     Int
  band      String
  // [{ part, label, points, max, why, next }].
  parts     Json
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, month])
  @@map("health_scores")
}

// The monthly money report (spec step 148): a month's figures as made in the first days of
// the next, kept so the chat, the email and the page say the same. figures is a
// MonthlyReport (src/planning/monthly-report.ts).
model MonthlyReport {
  id        String    @id @default(cuid())
  userId    String    @map("user_id")
  // YYYY-MM: the month reported on.
  month     String
  figures   Json
  emailedAt DateTime? @map("emailed_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, month])
  @@map("monthly_reports")
}

// A what-if plan the person adopted (spec step 203): the scenario, its assumptions and the
// changes Jane proposed, which show up among the next best things until they're done.
model WhatIfPlan {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  scenario  String
  params    Json
  // [{ key, title, detail }].
  changes   Json
  // adopted, then done or dropped.
  status    String   @default("adopted")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@map("what_if_plans")
}

// The lean plan after a paycheck didn't come (spec step 204): asked once per late paycheck,
// then active until pay resumes. While active, automatic transfers from paychecks pause.
model LeanPlan {
  id        String    @id @default(cuid())
  userId    String    @map("user_id")
  // The late-paycheck change it answers: "late:<employer>:<due date>".
  changeKey String    @map("change_key")
  employer  String
  // YYYY-MM-DD: the day the paycheck was due.
  dueOn     String    @map("due_on")
  // proposed, active, declined or ended.
  status    String    @default("proposed")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  startedAt DateTime? @map("started_at") @db.Timestamptz(3)
  endedAt   DateTime? @map("ended_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, changeKey])
  @@map("lean_plans")
}

// The year's money plan (spec step 205): twelve months of targets, kept so a month that has
// passed never changes. months is a YearMonth[] (src/planning/year-plan.ts).
model YearPlan {
  id         String   @id @default(cuid())
  userId     String   @map("user_id")
  // YYYY-MM: the first month of the twelve.
  startMonth String   @map("start_month")
  months     Json
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, startMonth])
  @@map("year_plans")
}

// "This was me" / "not me" on an unusual-activity alert (spec step 208). "me" teaches the
// merchant: later charges up to twice the amount stay quiet. "not me" opens a dispute card.
model UnusualAnswer {
  id          String   @id @default(cuid())
  userId      String   @map("user_id")
  alertId     String   @map("alert_id")
  merchantKey String   @map("merchant_key")
  rule        String
  // me or not_me.
  answer      String
  amountCents Int      @map("amount_cents")
  // The dispute card's finding, for "not me".
  findingId   String?  @map("finding_id")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, alertId])
  @@index([userId, merchantKey])
  @@map("unusual_answers")
}

// Spec step 210: a change to the person's retirement contribution at work, sent to the
// payroll partner (a stand-in until one is connected) or the team. It only records the
// request; the person's pay changes when their employer does it.
model PayrollChange {
  id          String   @id @default(cuid())
  userId      String   @map("user_id")
  // Where the request went: "stand-in" until a payroll partner is connected.
  partner     String
  partnerRef  String   @map("partner_ref")
  fromRate    Float    @map("from_rate")
  toRate      Float    @map("to_rate")
  // requested, then confirmed once the stand-in sees the next paycheck.
  status      String   @default("requested")
  effectiveOn DateTime @map("effective_on") @db.Date
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("payroll_changes")
}

// Spec step 211: a retirement plan at a past employer. One row per employer, asked about
// once. Found plans are read-only until the person rolls one over (a direct rollover, never
// a check to them); the steps are tracked in `steps`.
model OldPlan {
  id              String    @id @default(cuid())
  userId          String    @map("user_id")
  employer        String
  // payroll (history), you (added by the person) or demo (the stand-in history).
  source          String
  // asked, no_plan, found, not_found, rolling, rolled or skipped.
  status          String    @default("asked")
  planName        String?   @map("plan_name")
  balanceCents    Int?      @map("balance_cents")
  expenseRatioBps Int?      @map("expense_ratio_bps")
  // The plan's records came from this partner (the stand-in locator is "demo").
  locator         String?
  destinationId   String?   @map("destination_id")
  // [{ key, label, doneOn: YYYY-MM-DD | null }].
  steps           Json      @default("[]")
  rollingSince    DateTime? @map("rolling_since") @db.Timestamptz(3)
  rolledAt        DateTime? @map("rolled_at") @db.Timestamptz(3)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, employer])
  @@map("old_plans")
}

// Spec step 212: what the person has told Jane for the retirement paycheck: their Social
// Security statement's monthly benefit at full retirement age, when they plan to retire,
// when to start Social Security, and what they expect to spend a month. All optional;
// Jane estimates what's missing and says so.
model RetirementIncome {
  id                String   @id @default(cuid())
  userId            String   @unique @map("user_id")
  ssMonthlyCents    Int?     @map("ss_monthly_cents")
  retireAge         Int?     @map("retire_age")
  ssStartAge        Int?     @map("ss_start_age")
  spendMonthlyCents Int?     @map("spend_monthly_cents")
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("retirement_incomes")
}

// Spec step 213: a child in the family's investing: their earned income (for a Roth IRA
// they can fund) and the demo accounts Jane opened for them. The child's college fund is
// the college plan (step 158) with the same name.
model FamilyChild {
  id          String   @id @default(cuid())
  userId      String   @map("user_id")
  name        String
  age         Int
  earnedCents Int      @default(0) @map("earned_cents")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, name])
  @@map("family_children")
}

// A link that lets relatives give to a child's college fund. The token is the permission;
// the public page shows only the goal and how far along it is, never the parents' money.
model GiftLink {
  id            String    @id @default(cuid())
  userId        String    @map("user_id")
  collegePlanId String    @map("college_plan_id")
  token         String    @unique
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  revokedAt     DateTime? @map("revoked_at") @db.Timestamptz(3)

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  gifts Gift[]

  @@index([userId])
  @@map("gift_links")
}

// One gift through a link: a stand-in (no real money moves) until a payments partner is
// connected. It counts toward the goal's progress.
model Gift {
  id          String   @id @default(cuid())
  giftLinkId  String   @map("gift_link_id")
  giverName   String   @map("giver_name")
  amountCents Int      @map("amount_cents")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  link GiftLink @relation(fields: [giftLinkId], references: [id], onDelete: Cascade)

  @@index([giftLinkId])
  @@map("gifts")
}

// Spec step 214: a rental property, with the text its transactions are matched on (rent
// in, the mortgage payment, property tax and other costs). Figures come from the person's
// own transactions in the last 12 months; the loan's balance and rate are what they told
// Jane (or the demo's) because a rental loan is often at a lender the bank link doesn't see.
model RentalProperty {
  id                   String   @id @default(cuid())
  userId               String   @map("user_id")
  name                 String
  purchaseCents        Int      @map("purchase_cents")
  landShare            Float    @map("land_share")
  placedInServiceYear  Int      @map("placed_in_service_year")
  placedInServiceMonth Int      @map("placed_in_service_month")
  cashInvestedCents    Int      @map("cash_invested_cents")
  loanBalanceCents     Int      @default(0) @map("loan_balance_cents")
  loanRateBps          Int      @default(0) @map("loan_rate_bps")
  monthlyPaymentCents  Int      @default(0) @map("monthly_payment_cents")
  // Comma-separated text found in a transaction's description.
  rentMatch            String   @map("rent_match")
  mortgageMatch        String   @default("") @map("mortgage_match")
  taxMatch             String   @default("") @map("tax_match")
  expenseMatch         String   @default("") @map("expense_match")
  // you (the form) or demo (the demo rental).
  source               String   @default("you")
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("rental_properties")
}

// Spec step 215: a variable annuity, a whole life policy or an advisory account found from
// the person's payments or statements (or entered by them), with what it costs and its
// surrender schedule. status: asked (a premium that may be whole life, to confirm), active
// or dismissed. Advisory accounts aren't stored: they are read from fee transactions.
model CostlyProduct {
  id                 String   @id @default(cuid())
  userId             String   @map("user_id")
  // annuity or whole_life (src/config/costly-products.ts).
  kind               String
  name               String
  provider           String
  status             String   @default("active")
  // An annuity's value, or a policy's cash value.
  valueCents         Int      @default(0) @map("value_cents")
  // An annuity's total yearly cost in basis points (insurance charge, administration, funds, riders).
  feeBps             Int      @default(0) @map("fee_bps")
  // Whole life: the premium a year.
  premiumYearlyCents Int      @default(0) @map("premium_yearly_cents")
  purchasedOn        DateTime @map("purchased_on") @db.Date
  // The share charged for leaving in contract year 1, 2, ... (percent), e.g. [7, 6, 5].
  surrenderSchedule  Json     @default("[]") @map("surrender_schedule")
  // you, payments (found) or demo.
  source             String
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("costly_products")
}

// Something in the person's data that doesn't add up (spec step 238): a balance off from its
// transactions, transactions that stopped, a stale or broken bank link, the same account
// linked twice, a transfer with no other side. Open until it clears.
model BooksIssue {
  id        String    @id @default(cuid())
  userId    String    @map("user_id")
  // off, gap, stale, broken, duplicate or transfer.
  kind      String
  // Stable per problem: "balance:<account>", "stale:<item>", "dup:<account>"...
  key       String
  accountId String?   @map("account_id")
  itemId    String?   @map("item_id")
  detail    Json
  // open or fixed.
  status    String    @default("open")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  fixedAt   DateTime? @map("fixed_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, key])
  @@index([userId, status])
  @@map("books_issues")
}

// What Jane suggests to a person (spec step 255), one row per detector (src/detectors) that
// fires for them. The nightly scan refreshes it, ranks the open ones by dollars x confidence x
// urgency and selects the top few for today; the chat offers those. status: waiting (fired,
// not selected), selected (offered today), yes, no (never offered again) or gone (stopped
// firing). Kept for the reach scoreboard (step 258).
model Suggestion {
  id                String    @id @default(cuid())
  userId            String    @map("user_id")
  // "<capability>:<topic>", the detector's id.
  key               String
  capability        String
  topic             String
  title             String
  // The short forms (docs/detectors.md): a headline and one "why you" line. Empty on rows
  // scanned before they existed, which fall back to the title and why.
  headline          String    @default("")
  short             String    @default("")
  worthCents        Int       @map("worth_cents")
  worthKind         String    @map("worth_kind")
  confidencePercent Int       @map("confidence_percent")
  confidenceReason  String    @map("confidence_reason")
  urgency           String
  why               String
  actionLabel       String    @map("action_label")
  actionHref        String    @map("action_href")
  // The ranking score at the last scan.
  score             Int       @default(0)
  status            String    @default("waiting")
  // The day it was last selected for the chat.
  selectedOn        DateTime? @map("selected_on") @db.Date
  answeredAt        DateTime? @map("answered_at") @db.Timestamptz(3)
  firstSeenAt       DateTime  @default(now()) @map("first_seen_at") @db.Timestamptz(3)
  lastSeenAt        DateTime  @default(now()) @map("last_seen_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, key])
  @@index([userId, status])
  @@map("suggestions")
}

// Spec step 232: the funds a workplace plan offers, read from a fee disclosure or statement
// the person gave and confirmed. Nothing is suggested from a menu that hasn't been confirmed.
// status: proposed (read, to confirm) or confirmed.
model PlanMenu {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  planName  String   @map("plan_name")
  // [{ ticker, name, expenseBps, kind, mix }].
  funds     Json
  status    String   @default("proposed")
  // you (pasted), demo (the stand-in's sample disclosure).
  source    String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("plan_menus")
}

// Spec step 232: a change to how the person's plan balance and future contributions are
// invested, sent to the payroll partner (a stand-in until one is connected).
model PlanChange {
  id         String   @id @default(cuid())
  userId     String   @map("user_id")
  menuId     String   @map("menu_id")
  partner    String
  partnerRef String   @map("partner_ref")
  // [{ ticker, share }].
  allocation Json
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("plan_changes")
}

// Spec step 234: a ladder of Treasury bills for money needed by a date, bought through a
// stand-in (nothing real is bought). Every bill matures by endsOn; when one matures before
// then, the stand-in rolls it into the next, and each roll is recorded in events.
model BillLadder {
  id          String   @id @default(cuid())
  userId      String   @map("user_id")
  // goal (a savings goal) or emergency (the part above its floor).
  purpose     String
  goalId      String?  @map("goal_id")
  name        String
  amountCents Int      @map("amount_cents")
  startOn     DateTime @map("start_on") @db.Date
  endsOn      DateTime @map("ends_on") @db.Date
  // [{ amountCents, bills: [{ term, startMonth, endMonth, rateBps }] }].
  rungs       Json
  // [{ on, rung, term, amountCents }]: each roll the stand-in made.
  events      Json     @default("[]")
  status      String   @default("active")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("bill_ladders")
}

// Spec step 235: a large deposit that isn't pay, asked about once ("a bonus, an inheritance,
// a sale?") and then given a staged plan. status: asked, planned or dismissed. `done` holds the
// stage keys the person has tapped.
model SuddenMoney {
  id            String   @id @default(cuid())
  userId        String   @map("user_id")
  transactionId String   @unique @map("transaction_id")
  amountCents   Int      @map("amount_cents")
  depositedOn   DateTime @map("deposited_on") @db.Date
  kind          String?
  // A sale's cost basis, when the person has said it.
  basisCents    Int?     @map("basis_cents")
  status        String   @default("asked")
  done          Json     @default("[]")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  transaction Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sudden_moneys")
}

// Spec step 236: what the person leaves out of their funds and which theme they lean towards
// (keys from src/config/values.ts). One row a person.
model ValuesPreference {
  id        String   @id @default(cuid())
  userId    String   @unique @map("user_id")
  excludes  String[] @default([])
  themes    String[] @default([])
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("values_preferences")
}

// Spec step 237: who the person has named on an account that takes a beneficiary (or a
// transfer-on-death registration). tier is primary or contingent; confirmedOn is the day they
// last said the names are right, which life events are compared with.
model AccountBeneficiary {
  id           String   @id @default(cuid())
  userId       String   @map("user_id")
  accountId    String   @map("account_id")
  name         String
  relationship String
  sharePct     Int      @map("share_pct")
  tier         String   @default("primary")
  confirmedOn  DateTime @map("confirmed_on") @db.Date
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([accountId])
  @@map("account_beneficiaries")
}

// Spec step 237: the person's family file. events are life events they told Jane about
// (marriage, divorce, birth); picks are the sections they chose to share; contacts and
// documents are what they typed.
model FamilyFile {
  id        String   @id @default(cuid())
  userId    String   @unique @map("user_id")
  events    Json     @default("[]")
  picks     String[] @default([])
  contacts  Json     @default("[]")
  documents String   @default("")
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("family_files")
}

// Spec step 290 (Phase AW, Stage A): a practice portfolio on paper. Nothing here is a real
// account and none of it can reach the brokerage stand-in. cashCents and the positions are the
// ledger's running state; every change is a PracticeTrade row, so the state can always be
// rebuilt from the trades. level is the risk level 1-5 (Very low to Very high).
model PracticePortfolio {
  id                  String   @id @default(cuid())
  userId              String   @unique @map("user_id")
  level               Int
  startingCents       Int      @map("starting_cents")
  cashCents           Int      @map("cash_cents")
  // Monthly practice deposit and the day of the month it lands (0 = none).
  monthlyAddCents     Int      @default(0) @map("monthly_add_cents")
  addDay              Int      @default(1) @map("add_day")
  paused              Boolean  @default(false)
  // Opportunities (small capped positions, High and Very high only) paused on their own.
  opportunitiesPaused Boolean  @default(false) @map("opportunities_paused")
  startedAt           DateTime @map("started_at") @db.Timestamptz(3)
  updatedAt           DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  user          User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  positions     PracticePosition[]
  trades        PracticeTrade[]
  opportunities PracticeOpportunity[]

  @@map("practice_portfolios")
}

model PracticePosition {
  id             String @id @default(cuid())
  portfolioId    String @map("portfolio_id")
  userId         String @map("user_id")
  ticker         String
  quantity       Float
  costBasisCents Int    @map("cost_basis_cents")

  portfolio PracticePortfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)

  @@unique([portfolioId, ticker])
  @@index([userId])
  @@map("practice_positions")
}

// side: buy, sell or deposit. amountCents is what changed hands (a deposit has no ticker).
// reason is a sentence for the person; rule names the rule that allowed it (step 291 on).
model PracticeTrade {
  id          String    @id @default(cuid())
  portfolioId String    @map("portfolio_id")
  userId      String    @map("user_id")
  placedAt    DateTime  @map("placed_at") @db.Timestamptz(3)
  side        String
  ticker      String?
  quantity    Float?
  priceCents  Int?      @map("price_cents")
  amountCents Int       @map("amount_cents")
  // A sale's gain or loss against the cost of what was sold.
  gainCents   Int?      @map("gain_cents")
  reason      String
  rule        String
  undone      Boolean   @default(false)
  // Its card in the chat put away ("Got it", step 296).
  dismissedAt DateTime? @map("dismissed_at") @db.Timestamptz(3)

  portfolio PracticePortfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)

  @@index([portfolioId, placedAt])
  @@index([userId])
  @@map("practice_trades")
}

// What the person wants from the practice portfolio (Phase AW, Stage A): their level, how big a
// drop they can live with, a goal and its date, the monthly practice money, how many extra
// moves they want, what to avoid, whether to harvest losses, cash to keep and whether Jane acts
// or only suggests. One row per person, made on the first change; with none the defaults in
// src/config/practice-preferences.ts apply. Practice money only. Rules: src/planning/practice-preferences.ts.
model PracticePreferences {
  id              String    @id @default(cuid())
  userId          String    @unique @map("user_id")
  // 1 to 5 (RISK_LEVELS); null follows the questionnaire (step 288).
  riskLevel       Int?      @map("risk_level")
  // The largest drop they can live with, in whole percent; null for no limit beyond the level.
  maxDropPercent  Int?      @map("max_drop_percent")
  // A key of GOALS (src/config/investing.ts), and when the money is needed.
  goal            String?
  goalDate        DateTime? @map("goal_date") @db.Date
  monthlyAddCents Int       @map("monthly_add_cents")
  addDay          Int       @map("add_day")
  // off, cautious, normal or adventurous (APPETITES).
  appetite        String
  // Exclusion keys (EXCLUSIONS) and tickers never to buy.
  avoid           String[]  @default([])
  harvestLosses   Boolean   @map("harvest_losses")
  cashBufferCents Int       @map("cash_buffer_cents")
  // suggest (no practice trades) or act (within the caps, practice ledger only).
  mode            String
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("practice_preferences")
}

// Spec step 289 (Phase AW): daily closes pulled once from the market data (Alpaca) for the model
// portfolios' ETFs, stored with their source so backtests can say "real history since <date>".
// Market data, not a person's: no user_id.
model MarketPrice {
  id         String   @id @default(cuid())
  ticker     String
  date       DateTime @db.Date
  closeCents Int      @map("close_cents")
  source     String

  @@unique([ticker, date])
  @@index([ticker, date])
  @@map("market_prices")
}

// What was loaded for a ticker, from where and for which dates.
model MarketHistoryLoad {
  id       String   @id @default(cuid())
  ticker   String
  source   String
  fromDate DateTime @map("from_date") @db.Date
  toDate   DateTime @map("to_date") @db.Date
  rows     Int
  loadedAt DateTime @map("loaded_at") @db.Timestamptz(3)

  @@unique([ticker, source])
  @@map("market_history_loads")
}

// Spec step 292 (Phase AW, Stage A): what the daily scan of a practice portfolio flagged, and
// what Jane did about it in the practice ledger. kind: drift_rebalance, dip_buy,
// tax_loss_harvest or news_idea. key stops one event being acted on twice. details holds the
// numbers, the caps and the confidence for the card (step 296). status: acted (placed in the
// practice ledger) or autopilot (the autopilot's rebalance does it).
model PracticeOpportunity {
  id          String    @id @default(cuid())
  portfolioId String    @map("portfolio_id")
  userId      String    @map("user_id")
  scannedAt   DateTime  @map("scanned_at") @db.Timestamptz(3)
  kind        String
  ticker      String
  key         String
  amountCents Int       @map("amount_cents")
  headline    String
  reason      String
  confidence  Int
  details     Json
  status      String
  tradeIds    String[]  @map("trade_ids")
  // Its card in the chat put away ("Got it", step 296).
  dismissedAt DateTime? @map("dismissed_at") @db.Timestamptz(3)

  portfolio PracticePortfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)

  @@unique([portfolioId, key])
  @@index([userId, scannedAt])
  @@map("practice_opportunities")
}

// Spec step 293 (Phase AW): the watchlist's headlines with their one-sentence summaries, and
// filings (8-K, 10-Q) as facts with a link, stored by the daily job so the chat and pages read
// them without calling anyone. Market data, not a person's: no user_id. `feed` is the market data
// it came from ("sample" or "alpaca"), so sample news is never shown as real.
model MarketNews {
  id        String   @id @default(cuid())
  // A hash of the feed, kind, date, ticker and title: the same item is stored once.
  key       String   @unique
  feed      String
  // "headline" or "filing".
  kind      String
  ticker    String?
  date      DateTime @db.Date
  title     String
  source    String
  url       String?
  // Filings only: 8-K, 10-Q.
  form      String?
  // Headlines only: one sentence, and who wrote it ("claude" or "rules").
  summary   String?
  summaryBy String?  @map("summary_by")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([feed, kind, date])
  @@map("market_news")
}

// One Claude call for news summaries (spec step 293): what it cost, so the job keeps to a few
// calls a day and the monthly cap. Written before the call with the most it could cost, then
// set to what it did cost.
model NewsSummaryCall {
  id             String   @id @default(cuid())
  calledAt       DateTime @map("called_at") @db.Timestamptz(3)
  model          String
  headlines      Int
  inputTokens    Int      @default(0) @map("input_tokens")
  outputTokens   Int      @default(0) @map("output_tokens")
  // Hundredths of a cent.
  costHundredths Int      @map("cost_hundredths")
  ok             Boolean  @default(false)

  @@index([calledAt])
  @@map("news_summary_calls")
}
