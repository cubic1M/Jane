generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Conventions: money is integer cents, timestamps are UTC (timestamptz), and every
// user-owned row has user_id and is deleted with its user. Query user-owned tables
// through src/lib/db-scoped.ts, never the raw client.

enum Role {
  user
  admin

  @@map("role")
}

enum FindingType {
  subscription_review
  duplicate_subscription
  price_increase
  bank_fees
  idle_cash
  insurance_reshop
  card_interest
  low_balance_risk
  duplicate_charge
  charge_after_cancel
  trial_conversion

  @@map("finding_type")
}

enum FindingStatus {
  new
  shown
  approved
  declined
  in_progress
  done
  failed

  @@map("finding_status")
}

enum Confidence {
  low
  medium
  high

  @@map("confidence")
}

enum DecisionChoice {
  yes
  no

  @@map("decision_choice")
}

enum ActionType {
  cancel_subscription
  fight_price_increase
  recover_bank_fees
  move_idle_cash
  insurance_reshop
  card_interest
  review_cash_flow
  request_refund

  @@map("action_type")
}

enum ActionStatus {
  queued
  in_progress
  waiting_on_user
  done
  failed

  @@map("action_status")
}

enum MembershipIntentKind {
  reserve
  paid

  @@map("membership_intent_kind")
}

// Things worth a person's attention, raised after each sync or import (src/alerts).
enum AlertType {
  new_subscription
  price_increase
  fee_charged
  large_charge
  duplicate_charge
  low_balance

  @@map("alert_type")
}

// Where an account or transaction came from. CSV is the founders' own exports;
// Plaid arrives in step 7 behind the same DataSource interface.
enum DataSourceKind {
  csv
  plaid

  @@map("data_source")
}

// Who set a transaction's category: our keyword rules, the LLM, or Plaid itself.
enum CategorySource {
  rule
  llm
  plaid

  @@map("category_source")
}

// Where a finding's explanation came from: Claude, or the fixed text for its type when
// Claude's answer failed the guardrails.
enum ExplanationSource {
  llm
  template

  @@map("explanation_source")
}

enum ActorType {
  user
  admin
  system

  @@map("actor_type")
}

model User {
  id                         String    @id @default(cuid())
  email                      String    @unique
  emailVerified              DateTime? @map("email_verified") @db.Timestamptz(3)
  name                       String?
  image                      String?
  role                       Role      @default(user)
  createdAt                  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                  DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt                  DateTime? @map("deleted_at") @db.Timestamptz(3)
  // Set when detection first finishes for this user, so /scanning knows it can move on.
  firstDetectionAt           DateTime? @map("first_detection_at") @db.Timestamptz(3)
  // Email preferences, changed on /settings or by the unsubscribe link.
  digestEnabled              Boolean   @default(true) @map("digest_enabled")
  // IANA name, e.g. America/New_York. Null means US Pacific.
  timezone                   String?
  // Membership offer: when it was last shown (counted once per snooze period) and when
  // the person last said "not now".
  membershipOfferShownAt     DateTime? @map("membership_offer_shown_at") @db.Timestamptz(3)
  membershipOfferDismissedAt DateTime? @map("membership_offer_dismissed_at") @db.Timestamptz(3)
  // When we last warned that linked banks will be disconnected for inactivity.
  plaidRemovalWarnedAt       DateTime? @map("plaid_removal_warned_at") @db.Timestamptz(3)
  // Per alert type: "email", "app" or "off". Missing types use the defaults in
  // src/config/alerts.ts.
  alertPrefs                 Json      @default("{}") @map("alert_prefs")
  // Admin two-factor (TOTP). The secret is AES-256-GCM encrypted like Plaid tokens;
  // mfaEnabledAt is set once the first code checks out.
  mfaSecretEncrypted         String?   @map("mfa_secret_encrypted")
  mfaEnabledAt               DateTime? @map("mfa_enabled_at") @db.Timestamptz(3)
  // The Terms and Privacy Policy version the person last accepted (src/config/legal.ts).
  termsVersion               String?   @map("terms_version")
  termsAcceptedAt            DateTime? @map("terms_accepted_at") @db.Timestamptz(3)

  authAccounts       AuthAccount[]
  sessions           Session[]
  plaidItems         PlaidItem[]
  accounts           Account[]
  transactions       Transaction[]
  recurringStreams   RecurringStream[]
  findings           Finding[]
  decisions          Decision[]
  actions            Action[]
  digests            Digest[]
  membershipIntents  MembershipIntent[]
  analyticsEvents    AnalyticsEvent[]
  merchantCategories MerchantCategory[]
  subscriptionChecks SubscriptionCheck[]
  alerts             Alert[]

  @@map("users")
}

// Auth.js tables. "accounts" is taken by bank accounts, so sign-in providers live in
// auth_accounts. OAuth tokens are not stored: we only use Google to sign in.
model AuthAccount {
  id                String   @id @default(cuid())
  userId            String   @map("user_id")
  type              String
  provider          String
  providerAccountId String   @map("provider_account_id")
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("auth_accounts")
}

model Session {
  id            String    @id @default(cuid())
  sessionToken  String    @unique @map("session_token")
  userId        String    @map("user_id")
  expires       DateTime  @db.Timestamptz(3)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  // Set when an admin enters a valid two-factor code in this session.
  mfaVerifiedAt DateTime? @map("mfa_verified_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

// Magic-link tokens. Auth.js stores a hash, never the token from the email.
model VerificationToken {
  identifier String
  token      String
  expires    DateTime @db.Timestamptz(3)

  @@id([identifier, token])
  @@map("verification_tokens")
}

model PlaidItem {
  id                   String    @id @default(cuid())
  userId               String    @map("user_id")
  plaidItemId          String    @unique @map("plaid_item_id")
  // AES-256-GCM via src/lib/crypto.ts. Never log or return it.
  accessTokenEncrypted String    @map("access_token_encrypted")
  institutionName      String?   @map("institution_name")
  status               String    @default("active")
  transactionsCursor   String?   @map("transactions_cursor")
  lastSyncedAt         DateTime? @map("last_synced_at") @db.Timestamptz(3)
  createdAt            DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accounts Account[]

  @@index([userId])
  @@map("plaid_items")
}

model Account {
  id                    String         @id @default(cuid())
  userId                String         @map("user_id")
  source                DataSourceKind
  // Plaid-only; null for CSV accounts.
  itemId                String?        @map("item_id")
  plaidAccountId        String?        @unique @map("plaid_account_id")
  name                  String
  mask                  String?
  // Plaid's account type and subtype, e.g. depository/checking or credit/credit card.
  type                  String
  subtype               String?
  // Entered by hand for CSV accounts, which usually lack balances.
  currentBalanceCents   Int?           @map("current_balance_cents")
  availableBalanceCents Int?           @map("available_balance_cents")
  createdAt             DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  item             PlaidItem?        @relation(fields: [itemId], references: [id], onDelete: Cascade)
  transactions     Transaction[]
  recurringStreams RecurringStream[]

  @@index([userId])
  @@index([itemId])
  @@map("accounts")
}

model Transaction {
  id                 String          @id @default(cuid())
  userId             String          @map("user_id")
  accountId          String          @map("account_id")
  source             DataSourceKind
  // Plaid-only; null for CSV transactions.
  plaidTransactionId String?         @unique @map("plaid_transaction_id")
  // CSV-only: identifies a row across overlapping uploads (see src/data-sources/dedupe.ts).
  dedupeKey          String?         @map("dedupe_key")
  date               DateTime        @db.Date
  // Plaid's sign convention: positive is money out of the account.
  amountCents        Int             @map("amount_cents")
  description        String
  merchantName       String?         @map("merchant_name")
  // Plaid personal finance category, primary and detailed.
  pfcPrimary         String?         @map("pfc_primary")
  pfcDetailed        String?         @map("pfc_detailed")
  categorySource     CategorySource? @map("category_source")
  pending            Boolean         @default(false)
  createdAt          DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([accountId, dedupeKey])
  @@index([userId])
  @@index([accountId])
  @@index([userId, date])
  @@map("transactions")
}

model RecurringStream {
  id                 String    @id @default(cuid())
  userId             String    @map("user_id")
  accountId          String    @map("account_id")
  plaidStreamId      String    @unique @map("plaid_stream_id")
  merchantName       String?   @map("merchant_name")
  // Plaid's values as given, e.g. MONTHLY; status e.g. MATURE.
  frequency          String
  lastAmountCents    Int       @map("last_amount_cents")
  averageAmountCents Int       @map("average_amount_cents")
  lastDate           DateTime? @map("last_date") @db.Date
  // Plaid's guess at the next charge, when it has one.
  predictedNextDate  DateTime? @map("predicted_next_date") @db.Date
  status             String
  isActive           Boolean   @default(true) @map("is_active")
  pfcPrimary         String?   @map("pfc_primary")
  pfcDetailed        String?   @map("pfc_detailed")
  // Plaid transaction ids in the stream, sorted by posted date.
  transactionIds     String[]  @default([]) @map("transaction_ids")
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([accountId])
  @@map("recurring_streams")
}

model Finding {
  id                 String             @id @default(cuid())
  userId             String             @map("user_id")
  type               FindingType
  // Identifies the same opportunity across scans (e.g. "merchant:netflix", "account:<id>"),
  // so a rescan updates the finding instead of adding another.
  key                String
  title              String
  // The card text: { title, explanation, giveUp, alternatives }. Null until generated;
  // the page shows template text meanwhile (src/lib/explanations.ts).
  explanation        Json?
  explanationSource  ExplanationSource? @map("explanation_source")
  // Audit trail: which model and prompt wrote it (both null for template text).
  explanationModel   String?            @map("explanation_model")
  explanationPrompt  String?            @map("explanation_prompt_version")
  // Hash of exactly what was sent. A different hash means the evidence changed and the
  // explanation is regenerated.
  explanationHash    String?            @map("explanation_input_hash")
  // Null when there is no dollar estimate (e.g. insurance reshop).
  annualSavingsCents Int?               @map("annual_savings_cents")
  // What the rule measured (annual cost, fees, excess cash). A declined finding only comes
  // back when this moves by more than the configured share.
  amountCents        Int?               @map("amount_cents")
  confidence         Confidence
  evidence           Json               @default("{}")
  status             FindingStatus      @default(new)
  createdAt          DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  decisions Decision[]

  @@unique([userId, type, key])
  @@index([userId, status])
  @@map("findings")
}

// Append-only log of every yes or no, with the card exactly as the user saw it.
model Decision {
  id           String         @id @default(cuid())
  findingId    String         @map("finding_id")
  userId       String         @map("user_id")
  choice       DecisionChoice
  cardSnapshot Json           @map("card_snapshot")
  createdAt    DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  // Set when the person undid a "no" within the undo window. The row itself is kept.
  undoneAt     DateTime?      @map("undone_at") @db.Timestamptz(3)

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  finding Finding @relation(fields: [findingId], references: [id], onDelete: Cascade)
  action  Action?

  @@index([userId])
  @@index([findingId])
  @@map("decisions")
}

model Action {
  id            String       @id @default(cuid())
  decisionId    String       @unique @map("decision_id")
  userId        String       @map("user_id")
  type          ActionType
  status        ActionStatus @default(queued)
  assignee      String?
  notes         String?
  // For waiting_on_user: exactly what the person needs to do, shown on /actions.
  userTodo      String?      @map("user_todo")
  // Why a failed action failed, so card copy and rules can be fixed. Team-only.
  failureReason String?      @map("failure_reason")
  minutesSpent  Int?         @map("minutes_spent")
  startedAt     DateTime?    @map("started_at") @db.Timestamptz(3)
  completedAt   DateTime?    @map("completed_at") @db.Timestamptz(3)
  createdAt     DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  decision Decision @relation(fields: [decisionId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status, createdAt])
  @@map("actions")
}

model Digest {
  id        String    @id @default(cuid())
  userId    String    @map("user_id")
  weekStart DateTime  @map("week_start") @db.Date
  payload   Json
  sentAt    DateTime? @map("sent_at") @db.Timestamptz(3)
  openedAt  DateTime? @map("opened_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, weekStart])
  @@index([userId])
  @@map("digests")
}

model MembershipIntent {
  id              String               @id @default(cuid())
  userId          String               @map("user_id")
  kind            MembershipIntentKind
  stripeSessionId String?              @unique @map("stripe_session_id")
  amountCents     Int?                 @map("amount_cents")
  createdAt       DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("membership_intents")
}

// The LLM's category for a merchant, so each merchant is classified once per user.
model MerchantCategory {
  id          String         @id @default(cuid())
  userId      String         @map("user_id")
  merchantKey String         @map("merchant_key")
  pfcPrimary  String         @map("pfc_primary")
  pfcDetailed String         @map("pfc_detailed")
  source      CategorySource
  createdAt   DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, merchantKey])
  @@index([userId])
  @@map("merchant_categories")
}

// Claude's answer to "is this recurring merchant a subscription?", for merchants whose
// category doesn't settle it. Asked once per merchant; the detection rules still decide
// whether there is a finding.
model SubscriptionCheck {
  id             String   @id @default(cuid())
  userId         String   @map("user_id")
  merchantKey    String   @map("merchant_key")
  isSubscription Boolean  @map("is_subscription")
  model          String
  promptVersion  String   @map("prompt_version")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, merchantKey])
  @@map("subscription_checks")
}

model Alert {
  id        String    @id @default(cuid())
  userId    String    @map("user_id")
  type      AlertType
  // Identifies the event (e.g. a transaction id), so a rescan never raises it twice.
  key       String
  title     String
  body      String
  urgent    Boolean   @default(false)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  readAt    DateTime? @map("read_at") @db.Timestamptz(3)
  emailedAt DateTime? @map("emailed_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, type, key])
  @@index([userId, createdAt])
  @@map("alerts")
}

// Invite codes keep the beta closed: signing up needs a code with uses left.
model InviteCode {
  id        String    @id @default(cuid())
  code      String    @unique
  maxUses   Int       @map("max_uses")
  uses      Int       @default(0)
  // What the code is for, e.g. "Friends of Sam". Team-only.
  note      String?
  expiresAt DateTime? @map("expires_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  access BetaAccess[]

  @@map("invite_codes")
}

// Emails allowed to create an account, each from a redeemed invite code.
model BetaAccess {
  id           String   @id @default(cuid())
  email        String   @unique
  inviteCodeId String   @map("invite_code_id")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  inviteCode InviteCode @relation(fields: [inviteCodeId], references: [id], onDelete: Cascade)

  @@map("beta_access")
}

// Fixed-window request counters for rate limiting (src/lib/rate-limit.ts). Keys hold a
// route name plus a user id or a hashed IP, never raw personal data.
model RateLimit {
  key         String
  windowStart DateTime @map("window_start") @db.Timestamptz(3)
  count       Int      @default(0)

  @@id([key, windowStart])
  @@index([windowStart])
  @@map("rate_limits")
}

// Server errors, scrubbed of personal data and secrets before they're stored
// (src/lib/error-log.ts). No user id, so the log holds nothing personal.
model ErrorEvent {
  id        String   @id @default(cuid())
  message   String
  stack     String?
  // Path without the query string, e.g. /api/plaid/exchange.
  path      String?
  method    String?
  // Next.js context: "route", "render", "action" or "proxy".
  routeType String?  @map("route_type")
  digest    String?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([createdAt])
  @@map("error_events")
}

// Deliberately no foreign keys: the log must outlive the users and rows it describes,
// including the record of a user deleting their data.
model AuditLog {
  id         String    @id @default(cuid())
  // Null for system events.
  actorId    String?   @map("actor_id")
  actorType  ActorType @map("actor_type")
  event      String
  targetType String?   @map("target_type")
  targetId   String?   @map("target_id")
  metadata   Json      @default("{}")
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([actorId])
  @@index([targetType, targetId])
  @@index([event, createdAt])
  @@map("audit_log")
}

model AnalyticsEvent {
  id         String   @id @default(cuid())
  // Null for visitors who have not signed up; their anonymous_id is in properties.
  userId     String?  @map("user_id")
  name       String
  properties Json     @default("{}")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([name, createdAt])
  @@map("analytics_events")
}
