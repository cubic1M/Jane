generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Conventions: money is integer cents, timestamps are UTC (timestamptz), and every
// user-owned row has user_id and is deleted with its user. Query user-owned tables
// through src/lib/db-scoped.ts, never the raw client.

enum Role {
  user
  admin

  @@map("role")
}

enum FindingType {
  subscription_review
  duplicate_subscription
  price_increase
  bank_fees
  idle_cash
  insurance_reshop
  card_interest
  low_balance_risk
  duplicate_charge
  charge_after_cancel
  trial_conversion
  bill_negotiation

  @@map("finding_type")
}

enum FindingStatus {
  new
  shown
  approved
  declined
  in_progress
  done
  failed

  @@map("finding_status")
}

enum Confidence {
  low
  medium
  high

  @@map("confidence")
}

enum AgentState {
  // Writing or sending.
  working
  // Sent; waiting for the company's reply (or the next follow-up).
  waiting_reply
  // Cancelled (by the person, through the company's own page): waiting to see no
  // further charge before calling it done.
  confirming
  // Passed to the team, with a reason.
  handed_off
  // Done, by the agent.
  finished
  // Switching to the option the person picked (spec step 77): they sign up with the link;
  // Jane watches for the new charge (or the cheaper one, or the transfer).
  switching

  @@map("agent_state")
}

enum AgentDirection {
  outbound
  inbound
  // A step Jane took that isn't a message: a hand-off, a refund seen, a cancellation
  // confirmed. Shown on the timeline in plain words.
  note

  @@map("agent_direction")
}

enum AutopilotLevel {
  // Ask me first: no standing rules.
  ask
  // Handle the safe stuff: refunds, fee refunds, small price pushback, lower card rates.
  safe
  // Everything a rule is allowed to do, with higher limits.
  all
  // The person fine-tuned the rules by hand.
  custom

  @@map("autopilot_level")
}

enum ProposalStatus {
  open
  accepted
  dismissed

  @@map("proposal_status")
}

enum DecisionSource {
  card
  plan
  rule
  // A follow-up Jane starts on its own because of an earlier yes: a refund when a
  // company charges after a cancellation the person approved.
  auto
  // A one-tap link from the weekly email or a notification (spec step 60).
  link
  // A button on one of Jane's messages in the chat (spec step 81).
  chat

  @@map("decision_source")
}

enum DecisionChoice {
  yes
  no
  // "I'll do it myself": no concierge action; the person follows a kit and marks it done.
  diy

  @@map("decision_choice")
}

enum ActionType {
  cancel_subscription
  fight_price_increase
  recover_bank_fees
  move_idle_cash
  insurance_reshop
  card_interest
  review_cash_flow
  request_refund
  negotiate_bill

  @@map("action_type")
}

enum ActionStatus {
  queued
  in_progress
  waiting_on_user
  done
  failed

  @@map("action_status")
}

enum MembershipIntentKind {
  reserve
  paid

  @@map("membership_intent_kind")
}

// Things worth a person's attention, raised after each sync or import (src/alerts).
enum AlertType {
  new_subscription
  price_increase
  fee_charged
  large_charge
  duplicate_charge
  low_balance
  over_budget
  bill_due
  renews_soon
  deadline_soon
  // The IRS estimated-payment date is coming up, for people with contracting or gig
  // income (spec step 72).
  estimated_tax

  @@map("alert_type")
}

// Where an account or transaction came from. CSV is the founders' own exports;
// Plaid arrives in step 7 behind the same DataSource interface.
enum DataSourceKind {
  csv
  plaid

  @@map("data_source")
}

// Who set a transaction's category: our keyword rules, the LLM, or Plaid itself.
enum CategorySource {
  rule
  llm
  plaid
  // Set by the person: on one transaction, or as a rule for a merchant. Wins over the rest.
  user

  @@map("category_source")
}

// Where a finding's explanation came from: Claude, or the fixed text for its type when
// Claude's answer failed the guardrails.
enum ExplanationSource {
  llm
  template

  @@map("explanation_source")
}

enum ActorType {
  user
  admin
  system

  @@map("actor_type")
}

model User {
  id                         String          @id @default(cuid())
  email                      String          @unique
  emailVerified              DateTime?       @map("email_verified") @db.Timestamptz(3)
  name                       String?
  image                      String?
  role                       Role            @default(user)
  createdAt                  DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                  DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt                  DateTime?       @map("deleted_at") @db.Timestamptz(3)
  // Set when detection first finishes for this user, so /scanning knows it can move on.
  firstDetectionAt           DateTime?       @map("first_detection_at") @db.Timestamptz(3)
  // Email preferences, changed on /settings or by the unsubscribe link.
  digestEnabled              Boolean         @default(true) @map("digest_enabled")
  // IANA name, e.g. America/New_York. Null means US Pacific.
  timezone                   String?
  // Membership offer: when it was last shown (counted once per snooze period) and when
  // the person last said "not now".
  membershipOfferShownAt     DateTime?       @map("membership_offer_shown_at") @db.Timestamptz(3)
  membershipOfferDismissedAt DateTime?       @map("membership_offer_dismissed_at") @db.Timestamptz(3)
  // When we last warned that linked banks will be disconnected for inactivity.
  plaidRemovalWarnedAt       DateTime?       @map("plaid_removal_warned_at") @db.Timestamptz(3)
  // Per alert type: "email", "app" or "off". Missing types use the defaults in
  // src/config/alerts.ts.
  alertPrefs                 Json            @default("{}") @map("alert_prefs")
  // The private calendar feed (/api/calendar/<token>): SHA-256 of the link's secret, so a
  // database leak doesn't reveal working links. Null when the feed is off.
  calendarTokenHash          String?         @unique @map("calendar_token_hash")
  calendarCreatedAt          DateTime?       @map("calendar_created_at") @db.Timestamptz(3)
  // Two-letter US state, chosen on /settings. Referral partners are only offered where
  // they're allowed; with no state, none are.
  state                      String?
  // Admin two-factor (TOTP). The secret is AES-256-GCM encrypted like Plaid tokens;
  // mfaEnabledAt is set once the first code checks out.
  mfaSecretEncrypted         String?         @map("mfa_secret_encrypted")
  mfaEnabledAt               DateTime?       @map("mfa_enabled_at") @db.Timestamptz(3)
  // The Terms and Privacy Policy version the person last accepted (src/config/legal.ts).
  termsVersion               String?         @map("terms_version")
  termsAcceptedAt            DateTime?       @map("terms_accepted_at") @db.Timestamptz(3)
  // The first-weeks checklist on Home: when each item was first seen done (item key to
  // ISO time, so each funnel event fires once) and when the person hid it for good.
  checklistProgress          Json            @default("{}") @map("checklist_progress")
  checklistDismissedAt       DateTime?       @map("checklist_dismissed_at") @db.Timestamptz(3)
  // How much Jane does on its own (spec step 57). Null until the person picks.
  autopilot                  AutopilotLevel?
  // On bill calls, accept any lower price with no contract and no fee, even on a different
  // plan of the same service (spec step 62). Off: every offer comes to the person.
  acceptSimpleOffers         Boolean         @default(false) @map("accept_simple_offers")
  // Jane's chat messages as notifications (spec step 85): { channel, kinds }. Missing values
  // use the defaults in src/config/chat-notify.ts.
  chatNotifyPrefs            Json            @default("{}") @map("chat_notify_prefs")

  authAccounts           AuthAccount[]
  mfaBackupCodes         MfaBackupCode[]
  standingRules          StandingRule[]
  agentMessages          AgentMessage[]
  planProposals          PlanProposal[]
  planLinks              PlanLink[]
  janeMessages           JaneMessage[]
  chatReplyLinks         ChatReplyLink[]
  deadlines              Deadline[]
  sessions               Session[]
  plaidItems             PlaidItem[]
  accounts               Account[]
  transactions           Transaction[]
  recurringStreams       RecurringStream[]
  liabilities            Liability[]
  ownedAssets            OwnedAsset[]
  findings               Finding[]
  decisions              Decision[]
  actions                Action[]
  digests                Digest[]
  membershipIntents      MembershipIntent[]
  analyticsEvents        AnalyticsEvent[]
  merchantCategories     MerchantCategory[]
  subscriptionChecks     SubscriptionCheck[]
  alerts                 Alert[]
  askConversations       AskConversation[]
  askMessages            AskMessage[]
  householdMember        HouseholdMember?
  householdInvites       HouseholdInvite[]
  pushSubscriptions      PushSubscription[]
  referralConversions    ReferralConversion[]
  budgets                Budget[]
  savingsGoals           SavingsGoal[]
  balanceSnapshots       BalanceSnapshot[]
  checkIns               CheckIn[]
  documents              Document[]
  lifeEvents             LifeEvent[]
  // What's in investment accounts (spec step 128).
  securities             Security[]
  holdings               Holding[]
  investmentTransactions InvestmentTransaction[]
  changeAcks             ChangeAck[]
  // Insurance (spec Phase X).
  insurancePolicies      InsurancePolicy[]
  insuranceProfile       InsuranceProfile?

  @@map("users")
}

// Auth.js tables. "accounts" is taken by bank accounts, so sign-in providers live in
// auth_accounts. OAuth tokens are not stored: we only use Google to sign in.
model AuthAccount {
  id                String   @id @default(cuid())
  userId            String   @map("user_id")
  type              String
  provider          String
  providerAccountId String   @map("provider_account_id")
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("auth_accounts")
}

model Session {
  id            String    @id @default(cuid())
  sessionToken  String    @unique @map("session_token")
  userId        String    @map("user_id")
  expires       DateTime  @db.Timestamptz(3)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  // Set when an admin enters a valid two-factor code in this session.
  mfaVerifiedAt DateTime? @map("mfa_verified_at") @db.Timestamptz(3)
  // Devices and sessions (spec step 73): the browser's user agent (trimmed, never an IP
  // address) and when this session was last used, updated at most every few minutes.
  userAgent     String?   @map("user_agent")
  lastSeenAt    DateTime? @map("last_seen_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

// Magic-link tokens. Auth.js stores a hash, never the token from the email.
model VerificationToken {
  identifier String
  token      String
  expires    DateTime @db.Timestamptz(3)

  @@id([identifier, token])
  @@map("verification_tokens")
}

model PlaidItem {
  id                   String    @id @default(cuid())
  userId               String    @map("user_id")
  plaidItemId          String    @unique @map("plaid_item_id")
  // AES-256-GCM via src/lib/crypto.ts. Never log or return it.
  accessTokenEncrypted String    @map("access_token_encrypted")
  institutionName      String?   @map("institution_name")
  status               String    @default("active")
  transactionsCursor   String?   @map("transactions_cursor")
  // Linked with Liabilities as an optional product (spec step 65): loans and card rates
  // are read on each sync. Items linked before that never are (it would start billing).
  liabilities          Boolean   @default(false)
  // Linked with Investments as an optional product (spec step 66): investment and
  // retirement balances, holdings and investment transactions (spec step 128) are read on
  // each sync.
  investments          Boolean   @default(false)
  lastSyncedAt         DateTime? @map("last_synced_at") @db.Timestamptz(3)
  createdAt            DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accounts Account[]

  @@index([userId])
  @@map("plaid_items")
}

model Account {
  id                    String         @id @default(cuid())
  userId                String         @map("user_id")
  source                DataSourceKind
  // Plaid-only; null for CSV accounts.
  itemId                String?        @map("item_id")
  plaidAccountId        String?        @unique @map("plaid_account_id")
  name                  String
  mask                  String?
  // Plaid's account type and subtype, e.g. depository/checking or credit/credit card.
  type                  String
  subtype               String?
  // Entered by hand for CSV accounts, which usually lack balances.
  currentBalanceCents   Int?           @map("current_balance_cents")
  availableBalanceCents Int?           @map("available_balance_cents")
  // Whether the person's household partner may see this account (read-only).
  sharedWithHousehold   Boolean        @default(false) @map("shared_with_household")
  createdAt             DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  user                   User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  item                   PlaidItem?              @relation(fields: [itemId], references: [id], onDelete: Cascade)
  transactions           Transaction[]
  recurringStreams       RecurringStream[]
  balanceSnapshots       BalanceSnapshot[]
  checkIns               CheckIn[]
  liability              Liability?
  ownedAssets            OwnedAsset[]
  // Spec step 128: what an investment account holds, and its buys, sells and contributions.
  holdings               Holding[]
  investmentTransactions InvestmentTransaction[]

  @@index([userId])
  @@index([itemId])
  @@map("accounts")
}

model Transaction {
  id                 String          @id @default(cuid())
  userId             String          @map("user_id")
  accountId          String          @map("account_id")
  source             DataSourceKind
  // Plaid-only; null for CSV transactions.
  plaidTransactionId String?         @unique @map("plaid_transaction_id")
  // CSV-only: identifies a row across overlapping uploads (see src/data-sources/dedupe.ts).
  dedupeKey          String?         @map("dedupe_key")
  date               DateTime        @db.Date
  // Plaid's sign convention: positive is money out of the account.
  amountCents        Int             @map("amount_cents")
  description        String
  merchantName       String?         @map("merchant_name")
  // Plaid personal finance category, primary and detailed.
  pfcPrimary         String?         @map("pfc_primary")
  pfcDetailed        String?         @map("pfc_detailed")
  categorySource     CategorySource? @map("category_source")
  pending            Boolean         @default(false)
  createdAt          DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([accountId, dedupeKey])
  @@index([userId])
  @@index([accountId])
  @@index([userId, date])
  @@map("transactions")
}

model RecurringStream {
  id                 String    @id @default(cuid())
  userId             String    @map("user_id")
  accountId          String    @map("account_id")
  plaidStreamId      String    @unique @map("plaid_stream_id")
  merchantName       String?   @map("merchant_name")
  // Plaid's values as given, e.g. MONTHLY; status e.g. MATURE.
  frequency          String
  lastAmountCents    Int       @map("last_amount_cents")
  averageAmountCents Int       @map("average_amount_cents")
  lastDate           DateTime? @map("last_date") @db.Date
  // Plaid's guess at the next charge, when it has one.
  predictedNextDate  DateTime? @map("predicted_next_date") @db.Date
  status             String
  isActive           Boolean   @default(true) @map("is_active")
  pfcPrimary         String?   @map("pfc_primary")
  pfcDetailed        String?   @map("pfc_detailed")
  // Plaid transaction ids in the stream, sorted by posted date.
  transactionIds     String[]  @default([]) @map("transaction_ids")
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([accountId])
  @@map("recurring_streams")
}

// What the bank reports about a card or loan through Plaid Liabilities (spec step 65):
// rate, payments and dates, one row per account. Read-only and refreshed on every sync.
// Account numbers, addresses and reference numbers are never stored.
model Liability {
  id                        String    @id @default(cuid())
  userId                    String    @map("user_id")
  accountId                 String    @unique @map("account_id")
  // credit, mortgage, student or loan (Plaid's list it came from).
  kind                      String
  // Yearly rate in basis points: 2499 is 24.99%. Cards: the purchase APR.
  aprBps                    Int?      @map("apr_bps")
  // fixed or variable, when the bank says.
  rateType                  String?   @map("rate_type")
  // What's due each month: a card's or student loan's minimum, a mortgage's or loan's
  // next payment.
  minimumPaymentCents       Int?      @map("minimum_payment_cents")
  nextPaymentDueDate        DateTime? @map("next_payment_due_date") @db.Date
  lastPaymentCents          Int?      @map("last_payment_cents")
  lastPaymentDate           DateTime? @map("last_payment_date") @db.Date
  originationPrincipalCents Int?      @map("origination_principal_cents")
  originationDate           DateTime? @map("origination_date") @db.Date
  // Mortgages and loans: the maturity date; student loans: the expected payoff date.
  payoffDate                DateTime? @map("payoff_date") @db.Date
  isOverdue                 Boolean?  @map("is_overdue")
  pastDueCents              Int?      @map("past_due_cents")
  ytdInterestPaidCents      Int?      @map("ytd_interest_paid_cents")
  // The bank's own description, e.g. "Conventional 30 year fixed".
  description               String?
  createdAt                 DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                 DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("liabilities")
}

// Things the person owns (spec step 67): a home, a car, anything else of value, at the
// value they give and the day they gave it. Counted in net worth; with the loan against it,
// shown as equity. Never estimated by Jane.
model OwnedAsset {
  id            String   @id @default(cuid())
  userId        String   @map("user_id")
  // home, vehicle or other.
  kind          String
  name          String
  valueCents    Int      @map("value_cents")
  valuedOn      DateTime @map("valued_on") @db.Date
  // The mortgage or car loan against it, when there is one.
  loanAccountId String?  @map("loan_account_id")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  loanAccount Account? @relation(fields: [loanAccountId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@map("owned_assets")
}

model Finding {
  id                 String             @id @default(cuid())
  userId             String             @map("user_id")
  type               FindingType
  // Identifies the same opportunity across scans (e.g. "merchant:netflix", "account:<id>"),
  // so a rescan updates the finding instead of adding another.
  key                String
  title              String
  // The card text: { title, explanation, giveUp, alternatives }. Null until generated;
  // the page shows template text meanwhile (src/lib/explanations.ts).
  explanation        Json?
  explanationSource  ExplanationSource? @map("explanation_source")
  // Audit trail: which model and prompt wrote it (both null for template text).
  explanationModel   String?            @map("explanation_model")
  explanationPrompt  String?            @map("explanation_prompt_version")
  // Hash of exactly what was sent. A different hash means the evidence changed and the
  // explanation is regenerated.
  explanationHash    String?            @map("explanation_input_hash")
  // Null when there is no dollar estimate (e.g. insurance reshop).
  annualSavingsCents Int?               @map("annual_savings_cents")
  // What the rule measured (annual cost, fees, excess cash). A declined finding only comes
  // back when this moves by more than the configured share.
  amountCents        Int?               @map("amount_cents")
  confidence         Confidence
  evidence           Json               @default("{}")
  status             FindingStatus      @default(new)
  createdAt          DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  decisions Decision[]

  @@unique([userId, type, key])
  @@index([userId, status])
  @@map("findings")
}

// Append-only log of every yes or no, with the card exactly as the user saw it.
model Decision {
  id           String         @id @default(cuid())
  findingId    String         @map("finding_id")
  userId       String         @map("user_id")
  choice       DecisionChoice
  cardSnapshot Json           @map("card_snapshot")
  createdAt    DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  // Set when the person undid a "no" within the undo window. The row itself is kept.
  undoneAt     DateTime?      @map("undone_at") @db.Timestamptz(3)
  // For a do-it-yourself decision: when the person said they'd done it.
  diyDoneAt    DateTime?      @map("diy_done_at") @db.Timestamptz(3)
  // Where the answer came from: the card itself, Jane's plan, or a standing rule.
  source       DecisionSource @default(card)
  // What the person changed before saying yes (src/config/plan.ts), e.g. downgrade
  // instead of cancel. Null means Jane's defaults.
  options      Json?
  // For an answer from a standing rule: which one (src/config/rules.ts).
  ruleKey      String?        @map("rule_key")

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  finding Finding @relation(fields: [findingId], references: [id], onDelete: Cascade)
  action  Action?

  @@index([userId])
  @@index([findingId])
  @@map("decisions")
}

model Action {
  id                   String       @id @default(cuid())
  decisionId           String       @unique @map("decision_id")
  userId               String       @map("user_id")
  type                 ActionType
  status               ActionStatus @default(queued)
  assignee             String?
  notes                String?
  // For waiting_on_user: exactly what the person needs to do, shown on /actions.
  userTodo             String?      @map("user_todo")
  // Why a failed action failed, so card copy and rules can be fixed. Team-only.
  failureReason        String?      @map("failure_reason")
  minutesSpent         Int?         @map("minutes_spent")
  // The action agent (spec step 51). Null for actions the team works by hand.
  agentState           AgentState?  @map("agent_state")
  // When the agent next looks at it (a follow-up if the company hasn't replied).
  agentNextAt          DateTime?    @map("agent_next_at") @db.Timestamptz(3)
  agentFollowUps       Int          @default(0) @map("agent_follow_ups")
  // Why the agent passed it to the team; shown on the queue.
  handoffReason        String?      @map("handoff_reason")
  // The random part of the reply-to address, so a company's reply finds its action.
  replyToken           String?      @unique @map("reply_token")
  // A refund seen coming back in the person's own transactions (spec step 52): the date
  // and how much. Counted as saved instead of the card's estimate.
  refundSeenAt         DateTime?    @map("refund_seen_at") @db.Date
  refundCents          Int?         @map("refund_cents")
  // For a cancellation the person did on the company's page: the day they did it, and
  // when a missed charge confirms it.
  cancelledOn          DateTime?    @map("cancelled_on") @db.Date
  confirmAfter         DateTime?    @map("confirm_after") @db.Date
  // The company's own cancel page, when only the account holder can cancel there.
  selfServiceUrl       String?      @map("self_service_url")
  // Yearly savings confirmed on a call (a lower monthly price, times twelve). Counted as
  // saved instead of the card's estimate.
  confirmedAnnualCents Int?         @map("confirmed_annual_cents")
  startedAt            DateTime?    @map("started_at") @db.Timestamptz(3)
  completedAt          DateTime?    @map("completed_at") @db.Timestamptz(3)
  createdAt            DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  decision      Decision       @relation(fields: [decisionId], references: [id], onDelete: Cascade)
  agentMessages AgentMessage[]

  @@index([userId])
  @@index([status, createdAt])
  @@index([agentState, agentNextAt])
  @@map("actions")
}

model Digest {
  id        String    @id @default(cuid())
  userId    String    @map("user_id")
  weekStart DateTime  @map("week_start") @db.Date
  payload   Json
  sentAt    DateTime? @map("sent_at") @db.Timestamptz(3)
  openedAt  DateTime? @map("opened_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, weekStart])
  @@index([userId])
  @@map("digests")
}

model MembershipIntent {
  id              String               @id @default(cuid())
  userId          String               @map("user_id")
  kind            MembershipIntentKind
  stripeSessionId String?              @unique @map("stripe_session_id")
  amountCents     Int?                 @map("amount_cents")
  createdAt       DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("membership_intents")
}

// The LLM's category for a merchant, so each merchant is classified once per user.
model MerchantCategory {
  id          String         @id @default(cuid())
  userId      String         @map("user_id")
  merchantKey String         @map("merchant_key")
  pfcPrimary  String         @map("pfc_primary")
  pfcDetailed String         @map("pfc_detailed")
  source      CategorySource
  createdAt   DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, merchantKey])
  @@index([userId])
  @@map("merchant_categories")
}

// Claude's answer to "is this recurring merchant a subscription?", for merchants whose
// category doesn't settle it. Asked once per merchant; the detection rules still decide
// whether there is a finding.
model SubscriptionCheck {
  id             String   @id @default(cuid())
  userId         String   @map("user_id")
  merchantKey    String   @map("merchant_key")
  isSubscription Boolean  @map("is_subscription")
  model          String
  promptVersion  String   @map("prompt_version")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, merchantKey])
  @@map("subscription_checks")
}

model Alert {
  id        String    @id @default(cuid())
  userId    String    @map("user_id")
  type      AlertType
  // Identifies the event (e.g. a transaction id), so a rescan never raises it twice.
  key       String
  title     String
  body      String
  urgent    Boolean   @default(false)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  readAt    DateTime? @map("read_at") @db.Timestamptz(3)
  emailedAt DateTime? @map("emailed_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, type, key])
  @@index([userId, createdAt])
  @@map("alerts")
}

// The merchant directory: shared knowledge about companies (names, aliases, cancel and
// support links, typical prices). Never personal data, so no user_id. Edited at
// /admin/merchants; seeded from src/config/merchant-seed.ts.
// Options Jane can compare a bill, a subscription or idle cash against (spec step 76): a
// cheaper tier of the same service, another provider's plan, or a savings account. Kept by
// the team on /admin/options with a source and the day it was checked. Not user data.
model SwitchOption {
  id                  String    @id @default(cuid())
  // plan (another provider), tier (a cheaper tier of the same service) or savings.
  kind                String
  // What it replaces: phone or internet_tv for plans (src/config/detection.ts
  // BILL_BENCHMARKS ids), savings for savings accounts.
  category            String?
  // For tiers: the merchant directory key of the service it's a tier of.
  merchantKey         String?   @map("merchant_key")
  provider            String
  name                String
  monthlyCents        Int?      @map("monthly_cents")
  // Savings: yearly rate in basis points.
  apyBps              Int?      @map("apy_bps")
  contractMonths      Int       @default(0) @map("contract_months")
  oneTimeFeeCents     Int       @default(0) @map("one_time_fee_cents")
  minimumBalanceCents Int       @default(0) @map("minimum_balance_cents")
  // One line each, in plain words: what's included and what's given up.
  includes            String?
  givesUp             String?   @map("gives_up")
  signUpUrl           String?   @map("sign_up_url")
  // Where the price comes from, and the day someone last checked it.
  sourceUrl           String    @map("source_url")
  checkedAt           DateTime  @map("checked_at") @db.Date
  // When the team confirmed it; production compares only reviewed options.
  reviewedAt          DateTime? @map("reviewed_at") @db.Timestamptz(3)
  // Example options for the demo bank, never shown in production.
  demo                Boolean   @default(false)
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([kind, category])
  @@index([merchantKey])
  @@map("switch_options")
}

model Merchant {
  id                     String    @id @default(cuid())
  // Normalized merchant key (src/data-sources/merchant.ts), lower case.
  key                    String    @unique
  name                   String
  aliases                String[]  @default([])
  // Plaid PFC detailed category, used when a transaction has none.
  category               String?
  cancelUrl              String?   @map("cancel_url")
  supportUrl             String?   @map("support_url")
  supportPhone           String?   @map("support_phone")
  // Where the action agent writes. Added by the team; never guessed.
  supportEmail           String?   @map("support_email")
  // A support address the agent found on the company's own site (spec step 64), with the
  // page it came from. The agent doesn't use it until the team confirms it.
  suggestedSupportEmail  String?   @map("suggested_support_email")
  suggestedSupportSource String?   @map("suggested_support_source")
  suggestedAt            DateTime? @map("suggested_at") @db.Timestamptz(3)
  typicalMonthlyCents    Int?      @map("typical_monthly_cents")
  // When someone on the team last checked the row; null until then.
  reviewedAt             DateTime? @map("reviewed_at") @db.Timestamptz(3)
  createdAt              DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt              DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("merchants")
}

// Ask Jane: a person's questions about their own money, and the answers they were shown.
// Deletable by the person, and removed with "Delete all my data".
model AskConversation {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  title     String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  user     User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages AskMessage[]

  @@index([userId, updatedAt])
  @@map("ask_conversations")
}

model AskMessage {
  id             String   @id @default(cuid())
  conversationId String   @map("conversation_id")
  userId         String   @map("user_id")
  // "user" or "assistant".
  role           String
  content        String
  // True when Claude's answer failed the guardrails and a fixed reply was shown instead.
  blocked        Boolean  @default(false)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user         User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversation AskConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@index([userId])
  @@map("ask_messages")
}

// Households: partners who share some accounts. Each person picks which of their own
// accounts to share; a partner can read those (and undecided findings on them), never
// change them, and never sees the other person's decisions.
model Household {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  members       HouseholdMember[]
  invites       HouseholdInvite[]
  sharedCharges SharedCharge[]
  settlements   Settlement[]

  @@map("households")
}

model HouseholdMember {
  id          String   @id @default(cuid())
  householdId String   @map("household_id")
  // One household per person.
  userId      String   @unique @map("user_id")
  joinedAt    DateTime @default(now()) @map("joined_at") @db.Timestamptz(3)

  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([householdId])
  @@map("household_members")
}

model HouseholdInvite {
  id          String    @id @default(cuid())
  householdId String    @map("household_id")
  // Who sent the invite.
  userId      String    @map("user_id")
  // Only someone signed in with this email can accept.
  email       String
  // SHA-256 of the link's token; the token itself is never stored.
  tokenHash   String    @unique @map("token_hash")
  expiresAt   DateTime  @map("expires_at") @db.Timestamptz(3)
  acceptedAt  DateTime? @map("accepted_at") @db.Timestamptz(3)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([householdId])
  @@index([userId])
  @@map("household_invites")
}

// A browser or phone that asked for notifications (Web Push). Only used when VAPID keys
// are set; urgent alerts then go here instead of email.
model PushSubscription {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  // The push service URL for this device. Works as a credential, so it's never exported.
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("push_subscriptions")
}

// Referral partners the concierge may send people to (an insurance marketplace, a savings
// account). Each covers one action type, in the states listed, and its disclosure is shown
// on the card word for word. Turning one off takes effect on the next page load.
model ReferralPartner {
  id                        String     @id @default(cuid())
  key                       String     @unique
  name                      String
  actionType                ActionType @map("action_type")
  disclosure                String
  referralUrl               String     @map("referral_url")
  // Two-letter state codes where the partner may be offered.
  allowedStates             String[]   @default([]) @map("allowed_states")
  active                    Boolean    @default(false)
  // What one conversion pays us, for revenue estimates; the real amount is recorded each time.
  revenuePerConversionCents Int?       @map("revenue_per_conversion_cents")
  createdAt                 DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                 DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  conversions ReferralConversion[]

  @@map("referral_partners")
}

// A referral that turned into revenue, entered by the team on the action page.
model ReferralConversion {
  id          String   @id @default(cuid())
  partnerId   String   @map("partner_id")
  userId      String   @map("user_id")
  actionId    String?  @map("action_id")
  amountCents Int      @map("amount_cents")
  source      String   @default("manual")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  partner ReferralPartner @relation(fields: [partnerId], references: [id], onDelete: Restrict)
  user    User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([partnerId, createdAt])
  @@index([userId])
  @@map("referral_conversions")
}

// A monthly spending limit the person set for one category (the plain category names
// insights uses, e.g. "Food and drink").
model Budget {
  id          String   @id @default(cuid())
  userId      String   @map("user_id")
  category    String
  amountCents Int      @map("amount_cents")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, category])
  @@map("budgets")
}

// A savings goal the person set. Progress comes from a linked account's balance, or an
// amount they update by hand.
model SavingsGoal {
  id               String   @id @default(cuid())
  userId           String   @map("user_id")
  name             String
  targetCents      Int      @map("target_cents")
  targetDate       DateTime @map("target_date") @db.Date
  // A savings account whose balance is the progress; null to track by hand.
  accountId        String?  @map("account_id")
  manualSavedCents Int?     @map("manual_saved_cents")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("savings_goals")
}

// One account's balance on one day, taken by the daily job, for net worth over time.
// Kept for SNAPSHOT_RETENTION_DAYS; removed with the account.
model BalanceSnapshot {
  id           String   @id @default(cuid())
  userId       String   @map("user_id")
  accountId    String   @map("account_id")
  date         DateTime @db.Date
  balanceCents Int      @map("balance_cents")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([accountId, date])
  @@index([userId, date])
  @@map("balance_snapshots")
}

// Slow work done outside the request (writing explanations), retried with backoff when it
// fails. Not user data: payloads hold ids only. See src/lib/jobs.ts and /admin/jobs.
model Job {
  id          String   @id @default(cuid())
  kind        String
  payload     Json     @default("{}")
  // queued, running, done or failed.
  status      String   @default("queued")
  attempts    Int      @default(0)
  maxAttempts Int      @default(5) @map("max_attempts")
  runAt       DateTime @default(now()) @map("run_at") @db.Timestamptz(3)
  // The last error, scrubbed of personal data.
  lastError   String?  @map("last_error")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([status, runAt])
  @@map("jobs")
}

// How actions at one merchant tend to go, aggregated from finished actions by the daily
// job (src/lib/merchant-outcomes.ts). Counts only: no user ids, no action ids.
model MerchantOutcome {
  id            String     @id @default(cuid())
  merchantKey   String     @map("merchant_key")
  actionType    ActionType @map("action_type")
  cases         Int
  succeeded     Int
  medianMinutes Int?       @map("median_minutes")
  updatedAt     DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([merchantKey, actionType])
  @@map("merchant_outcomes")
}

// Team-written replies for common updates to a person (what they need to do next).
// Team content, not user data.
model SavedReply {
  id        String   @id @default(cuid())
  title     String
  body      String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("saved_replies")
}

// Each run of a scheduled job, for /admin/health. No user data.
model CronRun {
  id         String    @id @default(cuid())
  name       String
  startedAt  DateTime  @default(now()) @map("started_at") @db.Timestamptz(3)
  finishedAt DateTime? @map("finished_at") @db.Timestamptz(3)
  ok         Boolean?
  // Counts the job returned, or the scrubbed error.
  summary    Json?
  error      String?

  @@index([name, startedAt])
  @@map("cron_runs")
}

// Problems already emailed to the team, so each outage is reported once. Removed when
// the job runs again.
model HealthNotice {
  key        String   @id
  reportedAt DateTime @default(now()) @map("reported_at") @db.Timestamptz(3)

  @@map("health_notices")
}

// The monthly check-in for one person and month: its summary (Claude's, or the
// template's), kept so it's written once, and when it was emailed.
model CheckIn {
  id        String    @id @default(cuid())
  userId    String    @map("user_id")
  // YYYY-MM.
  month     String
  summary   String
  // "llm" or "template".
  source    String
  emailedAt DateTime? @map("emailed_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  account   Account? @relation(fields: [accountId], references: [id])
  accountId String?

  @@unique([userId, month])
  @@map("check_ins")
}

// A charge on a shared account that two partners split. The payer is the account's owner;
// the other person owes partnerShareBps of the amount. Ends with the household.
model SharedCharge {
  id              String   @id @default(cuid())
  householdId     String   @map("household_id")
  transactionId   String   @unique @map("transaction_id")
  payerId         String   @map("payer_id")
  amountCents     Int      @map("amount_cents")
  // The other person's share, in basis points (5000 = half).
  partnerShareBps Int      @map("partner_share_bps")
  // Who marked it shared.
  userId          String   @map("user_id")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)

  @@index([householdId])
  @@map("shared_charges")
}

// "Settle up": one partner paid the other back.
model Settlement {
  id          String   @id @default(cuid())
  householdId String   @map("household_id")
  fromUserId  String   @map("from_user_id")
  toUserId    String   @map("to_user_id")
  amountCents Int      @map("amount_cents")
  // Who recorded it.
  userId      String   @map("user_id")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)

  @@index([householdId])
  @@map("settlements")
}

// Invite codes keep the beta closed: signing up needs a code with uses left.
model InviteCode {
  id        String    @id @default(cuid())
  code      String    @unique
  maxUses   Int       @map("max_uses")
  uses      Int       @default(0)
  // What the code is for, e.g. "Friends of Sam". Team-only.
  note      String?
  expiresAt DateTime? @map("expires_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  access BetaAccess[]

  @@map("invite_codes")
}

// Emails allowed to create an account, each from a redeemed invite code.
model BetaAccess {
  id           String   @id @default(cuid())
  email        String   @unique
  inviteCodeId String   @map("invite_code_id")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  inviteCode InviteCode @relation(fields: [inviteCodeId], references: [id], onDelete: Cascade)

  @@map("beta_access")
}

// Fixed-window request counters for rate limiting (src/lib/rate-limit.ts). Keys hold a
// route name plus a user id or a hashed IP, never raw personal data.
model RateLimit {
  key         String
  windowStart DateTime @map("window_start") @db.Timestamptz(3)
  count       Int      @default(0)

  @@id([key, windowStart])
  @@index([windowStart])
  @@map("rate_limits")
}

// Server errors, scrubbed of personal data and secrets before they're stored
// (src/lib/error-log.ts). No user id, so the log holds nothing personal.
model ErrorEvent {
  id        String   @id @default(cuid())
  message   String
  stack     String?
  // Path without the query string, e.g. /api/plaid/exchange.
  path      String?
  method    String?
  // Next.js context: "route", "render", "action" or "proxy".
  routeType String?  @map("route_type")
  digest    String?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([createdAt])
  @@map("error_events")
}

// Deliberately no foreign keys: the log must outlive the users and rows it describes,
// including the record of a user deleting their data.
model AuditLog {
  id         String    @id @default(cuid())
  // Null for system events.
  actorId    String?   @map("actor_id")
  actorType  ActorType @map("actor_type")
  event      String
  targetType String?   @map("target_type")
  targetId   String?   @map("target_id")
  metadata   Json      @default("{}")
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([actorId])
  @@index([targetType, targetId])
  @@index([event, createdAt])
  @@map("audit_log")
}

model AnalyticsEvent {
  id         String   @id @default(cuid())
  // Null for visitors who have not signed up; their anonymous_id is in properties.
  userId     String?  @map("user_id")
  name       String
  properties Json     @default("{}")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([name, createdAt])
  @@map("analytics_events")
}

// Two-factor backup codes: each works once, in place of an authenticator code. Only a
// SHA-256 hash is kept; the codes are shown once when made.
model MfaBackupCode {
  id        String    @id @default(cuid())
  userId    String    @map("user_id")
  codeHash  String    @map("code_hash")
  usedAt    DateTime? @map("used_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, codeHash])
  @@map("mfa_backup_codes")
}

// Standing rules (spec step 50): things the person pre-approved, so Jane's plan items that
// match are approved without asking. One row per rule the person has set.
model StandingRule {
  id             String   @id @default(cuid())
  userId         String   @map("user_id")
  // A key from src/config/rules.ts.
  key            String
  enabled        Boolean  @default(true)
  // Approvals this rule may make in a calendar month.
  monthlyLimit   Int      @map("monthly_limit")
  // For rules with an amount: only findings worth this much a year or less.
  maxAnnualCents Int?     @map("max_annual_cents")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, key])
  @@map("standing_rules")
}

// Every email the action agent sent or received for an action: its timeline. Owned by the
// person the action is for.
model AgentMessage {
  id          String         @id @default(cuid())
  actionId    String         @map("action_id")
  userId      String         @map("user_id")
  direction   AgentDirection
  toAddress   String         @map("to_address")
  fromAddress String         @map("from_address")
  subject     String
  body        String
  // For a reply: how the agent read it (src/lib/agent/read-reply.ts).
  outcome     String?
  summary     String?
  createdAt   DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)

  action Action @relation(fields: [actionId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([actionId, createdAt])
  @@index([userId])
  @@map("agent_messages")
}

// Set-up Jane proposes from the person's own numbers (spec step 55): a budget, an
// emergency-fund goal, a category for a merchant. Nothing is created until they say yes;
// a no is kept so the same proposal doesn't come back.
model PlanProposal {
  id         String         @id @default(cuid())
  userId     String         @map("user_id")
  // e.g. "budget:Food and drink", "goal:emergency_fund", "category:canva".
  key        String
  kind       String
  payload    Json
  status     ProposalStatus @default(open)
  createdAt  DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  answeredAt DateTime?      @map("answered_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, key])
  @@map("plan_proposals")
}

// One-tap approval links in the weekly email and notifications (spec step 60): "Go ahead
// with this week's plan" for no-risk items, without signing in. Only a hash of the token
// is kept; a link works once, for a week, for that person and those items.
model PlanLink {
  id          String    @id @default(cuid())
  userId      String    @map("user_id")
  tokenHash   String    @unique @map("token_hash")
  // The items as they were when the link was made: [{ findingId, cardHash, title }].
  items       Json
  // What the link approved, so "Take it back" can undo exactly that.
  decisionIds String[]  @default([]) @map("decision_ids")
  expiresAt   DateTime  @map("expires_at") @db.Timestamptz(3)
  usedAt      DateTime? @map("used_at") @db.Timestamptz(3)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("plan_links")
}

// Insurance policies, warranties and receipts the person uploaded (spec step 68). The file
// is AES-256-GCM encrypted (src/lib/crypto.ts); the key facts are read by Claude or typed
// by the person, and they can always correct them.
model Document {
  id                  String    @id @default(cuid())
  userId              String    @map("user_id")
  // insurance_policy, warranty, receipt or other (src/config/documents.ts).
  kind                String
  fileName            String    @map("file_name")
  // One of the allowed types, checked against the file's first bytes.
  contentType         String    @map("content_type")
  sizeBytes           Int       @map("size_bytes")
  // "v1" + iv + auth tag + ciphertext; never the plain file.
  encryptedBytes      Bytes     @map("encrypted_bytes")
  provider            String?
  // Policies only: auto, home, renters, life, health or other.
  policyType          String?   @map("policy_type")
  // One line, checked by the guardrails before it's shown.
  coverageSummary     String?   @map("coverage_summary")
  premiumCents        Int?      @map("premium_cents")
  // monthly, quarterly, every 6 months or yearly.
  premiumFrequency    String?   @map("premium_frequency")
  renewalDate         DateTime? @map("renewal_date") @db.Date
  warrantyEndsOn      DateTime? @map("warranty_ends_on") @db.Date
  purchaseDate        DateTime? @map("purchase_date") @db.Date
  purchaseAmountCents Int?      @map("purchase_amount_cents")
  // Who wrote the facts: claude, you (the person) or none yet.
  extractionSource    String    @default("none") @map("extraction_source")
  uploadedAt          DateTime  @default(now()) @map("uploaded_at") @db.Timestamptz(3)
  updatedAt           DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  user              User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  insurancePolicies InsurancePolicy[]

  @@index([userId, uploadedAt])
  @@map("documents")
}

// One insurance policy on the person's profile (spec step 102): typed, read from a policy
// document, found from payments (step 99) or bound by Jane (step 105). Kinds, sources,
// statuses and the cover fields are in src/config/insurance.ts.
model InsurancePolicy {
  id               String    @id @default(cuid())
  userId           String    @map("user_id")
  kind             String
  carrier          String
  // active, found (not confirmed yet), pending, cancelled or removed.
  status           String    @default("active")
  source           String
  premiumCents     Int?      @map("premium_cents")
  // monthly, quarterly, semiannual or yearly (PREMIUM_FREQUENCIES in src/config/documents.ts).
  premiumFrequency String?   @map("premium_frequency")
  deductibleCents  Int?      @map("deductible_cents")
  // The cover limits by key (COVERAGE_FIELDS): cents, true/false, years or a percent.
  coverage         Json      @default("{}")
  // What's covered, in one line; checked by the guardrails before it's shown.
  covers           String?
  renewalDate      DateTime? @map("renewal_date") @db.Date
  // How long one term runs, in months (6 or 12).
  termMonths       Int       @default(12) @map("term_months")
  // The policy document it was read from, if any.
  documentId       String?   @unique @map("document_id")
  // The insurer's payments in the person's transactions (normalizeMerchant key), if known.
  merchantKey      String?   @map("merchant_key")
  cancelledAt      DateTime? @map("cancelled_at") @db.Timestamptz(3)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  document Document? @relation(fields: [documentId], references: [id], onDelete: SetNull)

  @@index([userId, status])
  @@map("insurance_policies")
}

// The household facts that matter for cover (spec step 102), as the person typed them.
// Null means not said: housing and cars are then read from the accounts.
model InsuranceProfile {
  userId        String   @id @map("user_id")
  // own, rent or other.
  housing       String?
  vehicles      Int?
  dependants    Int?
  pets          Int?
  // Gaps the person said they don't need (GAP_KEYS), never brought up again.
  dismissedGaps String[] @default([]) @map("dismissed_gaps")
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("insurance_profiles")
}

// What kind of hand-entered deadline it is (spec step 71).
enum DeadlineKind {
  fsa
  card_benefit
  warranty
  other

  @@map("deadline_kind")
}

// Deadlines the person typed in themselves (spec step 71): an FSA deadline, a card benefit
// to use ("my $200 travel credit by Dec 31"), a warranty, anything else. Shown on
// /deadlines with the ones Jane works out from transactions, and reminded about.
model Deadline {
  id        String       @id @default(cuid())
  userId    String       @map("user_id")
  title     String
  dueOn     DateTime     @map("due_on") @db.Date
  kind      DeadlineKind @default(other)
  note      String?
  doneAt    DateTime?    @map("done_at") @db.Timestamptz(3)
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, dueOn])
  @@map("deadlines")
}

// A life-event checklist (spec step 72): moving, a new job or a new baby. The items live in
// src/config/life-events.ts; this row keeps which ones the person has ticked.
model LifeEvent {
  id           String    @id @default(cuid())
  userId       String    @map("user_id")
  // moving, new_job or new_baby (LIFE_EVENT_KINDS).
  kind         String
  startedOn    DateTime  @map("started_on") @db.Date
  // Keys of the items ticked so far.
  checkedItems String[]  @default([]) @map("checked_items")
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  completedAt  DateTime? @map("completed_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("life_events")
}

// Jane's chat (spec step 81): every message Jane posts, and later (step 84) what the person
// types and Jane's answer. Posted by Jane's brain (spec step 82, src/lib/jane-agent).
model JaneMessage {
  id           String    @id @default(cuid())
  userId       String    @map("user_id")
  // brief, decision, done, heads_up, reply (Jane's answer) or user (what the person typed).
  kind         String
  // Fixed wording from a template, never Claude's text unless it passed the guardrails.
  body         String
  // What it's about: { findingId, actionId, decisionId, alertId, ... }.
  refs         Json      @default("{}")
  // The buttons: [{ id, label, kind: "primary" | "secondary" | "link", href? }]. Each id is
  // one of the button actions in src/lib/jane-agent/actions.
  actions      Json      @default("[]")
  // open, answered or dismissed.
  status       String    @default("open")
  // The button's label the person tapped.
  answeredWith String?   @map("answered_with")
  answeredAt   DateTime? @map("answered_at") @db.Timestamptz(3)
  // The same suggestion is never posted twice (finding:<id>, brief:<date>, ...).
  dedupeKey    String    @map("dedupe_key")
  // Higher is more important; the brain posts the most important first.
  priority     Int       @default(0)
  readAt       DateTime? @map("read_at") @db.Timestamptz(3)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  // When it went out as a notification (spec step 85), so it never goes twice, and how:
  // push, email, both, or skipped (it had gone out already as an alert).
  notifiedAt   DateTime? @map("notified_at") @db.Timestamptz(3)
  notifiedVia  String?   @map("notified_via")
  // "Not now" (spec step 83): hidden from the chat until then, when Jane may bring it up again.
  snoozedUntil DateTime? @map("snoozed_until") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, dedupeKey])
  @@index([userId, createdAt])
  @@map("jane_messages")
}

// One-tap answers from Jane's emails (spec step 85): one per button on one message. The
// link opens a confirm page with one button, so mail scanners can't answer anything. Only
// the SHA-256 of the token is kept; it works once, until expiresAt, for that person's own
// message and that button, through the same checks as the chat.
model ChatReplyLink {
  id        String    @id @default(cuid())
  userId    String    @map("user_id")
  messageId String    @map("message_id")
  actionId  String    @map("action_id")
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([messageId])
  @@map("chat_reply_links")
}

// Spec step 128: a fund, share or cash position, as Plaid Investments (or the demo bank)
// describes it. Plaid's securities are shared across its customers; here each person has
// their own copy, so every row is theirs. Prices are per share, in cents.
model Security {
  id               String    @id @default(cuid())
  userId           String    @map("user_id")
  plaidSecurityId  String    @map("plaid_security_id")
  name             String
  ticker           String?
  // Plaid's type: cash, cryptocurrency, derivative, equity, etf, fixed income, loan,
  // mutual fund or other; subtype e.g. "common stock" or "mutual fund".
  type             String?
  subtype          String?
  isCashEquivalent Boolean   @default(false) @map("is_cash_equivalent")
  closePriceCents  Int?      @map("close_price_cents")
  closePriceAsOf   DateTime? @map("close_price_as_of") @db.Date
  sector           String?
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  user                   User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  holdings               Holding[]
  investmentTransactions InvestmentTransaction[]

  @@unique([userId, plaidSecurityId])
  @@index([userId])
  @@map("securities")
}

// Spec step 128: how much of one security an account holds, replaced on every sync.
// valueCents is what the institution says it's worth; costBasisCents what was paid for
// the whole position, when the institution says.
model Holding {
  id             String    @id @default(cuid())
  userId         String    @map("user_id")
  accountId      String    @map("account_id")
  securityId     String    @map("security_id")
  // Shares or units; fractional shares are common.
  quantity       Float
  priceCents     Int       @map("price_cents")
  priceAsOf      DateTime? @map("price_as_of") @db.Date
  valueCents     Int       @map("value_cents")
  costBasisCents Int?      @map("cost_basis_cents")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  account  Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  security Security @relation(fields: [securityId], references: [id], onDelete: Cascade)

  @@unique([accountId, securityId])
  @@index([userId])
  @@map("holdings")
}

// Spec step 128: buys, sells, dividends, contributions and fees in an investment account,
// from Plaid Investments (or the demo bank). Plaid's sign: positive amounts are cash out
// of the account (a buy, a fee), negative are cash in (a sale, a dividend, a contribution).
model InvestmentTransaction {
  id                           String   @id @default(cuid())
  userId                       String   @map("user_id")
  accountId                    String   @map("account_id")
  securityId                   String?  @map("security_id")
  plaidInvestmentTransactionId String   @unique @map("plaid_investment_transaction_id")
  date                         DateTime @db.Date
  name                         String
  quantity                     Float
  amountCents                  Int      @map("amount_cents")
  priceCents                   Int      @map("price_cents")
  feesCents                    Int?     @map("fees_cents")
  // Plaid's type (buy, sell, cancel, cash, fee, transfer) and subtype (e.g. dividend,
  // contribution, management fee).
  type                         String
  subtype                      String
  createdAt                    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                    DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  account  Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  security Security? @relation(fields: [securityId], references: [id], onDelete: SetNull)

  @@index([userId, date])
  @@index([accountId])
  @@map("investment_transactions")
}

// "That's expected" on a change Jane noticed (spec step 97): a bill that moved, a new
// subscription, a paycheck, a category's pace or a new fee. Keyed by the change's own key
// (src/insights/changes.ts), so that change is never brought up again.
model ChangeAck {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  key       String
  kind      String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, key])
  @@map("change_acks")
}
